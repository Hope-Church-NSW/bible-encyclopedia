{
  "name": "bible-encyclopedia",
  "version": "1.0.0",
  "private": true,
  "description": "Arabic, English, Spanish, and French offline Bible encyclopedia",
  "scripts": {
    "build:web": "node build-mobile-web.js",
    "translations:es": "node build-project-translations.js --lang=es",
    "translations:es:audit": "node build-project-translations.js --lang=es --audit",
    "translations:es:pages": "node build-page-translations.js --lang=es",
    "translations:fr": "node build-project-translations.js --lang=fr",
    "translations:fr:audit": "node build-project-translations.js --lang=fr --audit",
    "translations:fr:pages": "node build-page-translations.js --lang=fr",
    "translations:fr:pages:ready": "node build-page-translations.js --lang=fr --complete-pages-only",
    "bible:fr": "node build-french-bible.js",
    "encyclopedia:fr": "node build-english-encyclopedia.js --lang=fr",
    "commentary:fr": "node build-english-encyclopedia.js --lang=fr --commentary",
    "commentary:fr:validate": "node validate-french-commentary.js",
    "validate:fr": "node validate-french-bible.js",
    "encyclopedia:es": "node build-english-encyclopedia.js --lang=es",
    "commentary:es": "node build-english-encyclopedia.js --lang=es --commentary",
    "validate:es": "node validate-spanish-bible.js && node validate-english-encyclopedia.js --lang=es && node validate-spanish-localization.js",
    "android:sync": "npm run build:web && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:bundle": "node verify-release-signing.js && npm run android:sync && cd android && gradlew.bat bundleRelease",
    "android:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File build-android-release.ps1",
    "ios:sync": "npm run build:web && cap sync ios",
    "ios:open": "npm run ios:sync && cap open ios",
    "screenshots:app-store": "npm run build:web && node capture-app-store-screenshots.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "bing-translate-api": "^4.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "playwright": "^1.63.0"
  }
}
