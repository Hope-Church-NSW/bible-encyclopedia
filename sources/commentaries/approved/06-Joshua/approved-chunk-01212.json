      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أرسل يشوع اثنين من الرجال للتجسس سراً لمعاينة أريحا، وهي المدينة الأولى في خط الفتح المتوقع عند عبور الأردن.",
        "theological": "إرسال الجواسيس يُظهر أن الإيمان بوعد الله لا يُلغي بذل الوسائل المشروعة والحرص على التخطيط الحكيم.",
        "deep": "اختيار يشوع لاثنين فقط من الرجال يعكس حذره وحنكته العسكرية، بعكس بعثة موسى السابقة التي كانت أكثر اتساعاً.",
        "applied": "مثول يشوع يُعلّم أن القيادة الحكيمة تجمع بين الثقة بالله والاجتهاد في استطلاع الواقع قبل اتخاذ القرارات الكبرى."
      }
    },
