      "explanation_lines": {
        "academic": "أرسل ملك أريحا إلى راحاب يطلب منها إخراج الرجلين اللذين دخلا بيتها، لأنهما جاءا للتجسس على كل البلاد.",
        "theological": "سلطة الملك على السكان تظهر في قدرته على الطلب المباشر، لكن راحاب اختارت طاعة الله على طاعة ملكها.",
        "deep": "اعتراف ملك أريحا بأن الجواسيس يستطلعون البلاد كاملة يشير إلى خوفه من غزو شامل قريب الوقوع.",
        "applied": "أمر الملك يختبر إيمان راحاب وولاءها؛ فتختار حماية الغريب المحتاج على امتثال أوامر السلطة الظالمة."
      }
    },
