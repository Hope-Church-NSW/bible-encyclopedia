      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تصف الآية انتقال بني دان للقتال على لشم وأخذها وسكناها، ثم تسميتها دان نسبة إلى أبيهم.",
        "theological": "يميز الشرح بين ما وقع لدان بالقرعة وما حصلوا عليه بصناعتهم وبسالتهم في لشم.",
        "deep": "يتحرك السرد من ضيق تخم دان إلى فعل جماعي: صعود وقتال وامتلاك وسكن ثم تثبيت الاسم الجديد.",
        "applied": "حين يضيق المجال المتاح، لا يكفي وصف المشكلة؛ يبرز النص مبادرة جماعية تتبعها إقامة مستقرة."
      }
    },
    "19:48": {
      "reference": "06-Joshua 19:48",
      "text": "هذَا هُوَ نَصِيبُ سِبْطِ بَنِي دَانَ حَسَبَ عَشَائِرِهِمْ. هذِهِ الْمُدُنُ مَعَ ضِيَاعِهَا.",
      "summary": "",
