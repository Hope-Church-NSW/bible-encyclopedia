          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أقرّ الرجلان براحاب أنهما سيكونان بريئَين من اليمين الذي فرضته عليهما، مما يعني أن العهد الذي أبرمه معهما لا يلزمهما إذا خرقت هي التزامات الاتفاق.",
        "theological": "التزام الرجلين بالبراءة من اليمين يعكس حكمة في الحفاظ على التوازن بين الوعود والشروط، وهو أساس العهود الملزمة بشروط متبادلة.",
        "deep": "اشتراط براحاب بيمين من الرجلين، وردهما بالبراءة من هذا اليمين إن نقضت عهدها، يظهر التفاهم العميق بين الطرفين حول طبيعة الالتزام المشروط.",
        "applied": "عندما نعقد اتفاقات، يجب أن نفهم أن الالتزامات المتبادلة تتطلب أمانة من كلا الطرفين، وأن الحفاظ على الثقة هو شرط استمرار العهد."
      }
    },
    "2:18": {
      "reference": "06-Joshua 2:18",
      "text": "هُوَذَا نَحْنُ نَأْتِي إِلَى الأَرْضِ، فَارْبِطِي هذَا الْحَبْلَ مِنْ خُيُوطِ الْقِرْمِزِ فِي الْكَوَّةِ الَّتِي أَنْزَلْتِنَا مِنْهَا، وَاجْمَعِي إِلَيْكِ فِي الْبَيْتِ أَبَاكِ وَأُمَّكِ وَإِخْوَتَكِ وَسَائِرَ بَيْتِ أَبِيكِ.",
