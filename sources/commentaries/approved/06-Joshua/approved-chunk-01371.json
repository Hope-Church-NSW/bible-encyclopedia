      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعرض النص تفرع أسرة إسحاق إلى يعقوب وعيسو، مع امتلاك عيسو جبل سعير ونزول يعقوب وبنيه إلى مصر.",
        "theological": "يظهر الله موزعا للأماكن والمسارات: أعطى عيسو سعير، بينما أبقى كنعان محفوظة لنسل يعقوب كما يوضح سياق الخطاب.",
        "deep": "لا يسير الأخوان في طريق جغرافي واحد؛ فالامتلاك الفوري لعيسو يقابله نزول يعقوب إلى مصر ضمن سرد تدبير الله للأسرة.",
        "applied": "يعلّم اختلاف مساري يعقوب وعيسو ألا نقيس تدبير الله بتشابه الطرق، بل نقبل الموضع والمسار اللذين يعينهما."
      }
