      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجمع موسى وهارون الجماعة أمام الصخرة، ثم يخاطبهم موسى بوصفهم متمرّدين ويسأل: هل نُخرج لكم ماء من هذه الصخرة؟",
        "theological": "صيغة «نُخرج لكم» لا تمنح الرب المجد الذي يليق به في المعجزة، كما أن نبرة الكلام العلنية لم تُظهر الثقة المطلوبة أمام الشعب.",
        "deep": "تكشف الآية كيف قد يحوّل ضغط التذمر خادمًا مرهقًا من إعلان وعد الله إلى كلام غاضب يضعف رجاء السامعين.",
        "applied": "حين نقود أو نخدم تحت الاستفزاز، ينبغي أن نضبط اللسان وألا ننسب لأنفسنا ما لا يتم إلا بعون الله وقدرته."
      }
    },
