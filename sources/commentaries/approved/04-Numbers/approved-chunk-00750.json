      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستعيد موسى إعلان الرب عن طول أناته وكثرة إحسانه وغفرانه، مع إبقاء العبارة التي تؤكد أنه لا يترك الذنب بلا حساب.",
        "theological": "تجمع الآية بين الرحمة والعدل: الرب مستعد للغفران، لكنه لا يجعل التمرد أمرا خفيفا ولا يمحو آثار الذنب كأنها لم تكن.",
        "deep": "في وصف الرب يظهر اتساع رحمته دون إلغاء قداسته؛ فالعفو لا يعني انعدام التأديب، بل منع الفناء الكامل مع بقاء المساءلة.",
        "applied": "تدعونا الآية إلى رجاء متزن: نقترب إلى الرب بسبب إحسانه، ونكف عن التهاون لأن الذنب يترك أثرا يتطلب توبة وخضوعا."
      }
    },
