      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يلخص موسى طلب الشفاعة في الصفح عن ذنب الشعب، مستندا إلى عظمة نعمة الرب وإلى غفرانه المتكرر لهم منذ مصر إلى هذه اللحظة.",
        "theological": "حجة موسى لا تقوم على تحسن الشعب، بل على ثبات رحمة الرب؛ فالماضي المملوء بالعفو يصير أساسا لطلب صفح حاضر.",
        "deep": "الطلب يكشف أن الذاكرة الروحية للرحمة ليست ذريعة للتمرد، بل سند للرجاء حين يبدو تكرار الفشل سببا لإغلاق باب الصفح.",
        "applied": "عند مواجهة خطأ جماعي، تعلّمنا الآية أن نصلي بصدق من أجل الصفح، مستحضرين نعمة الله السابقة دون إنكار جسامة الذنب."
      }
    },
