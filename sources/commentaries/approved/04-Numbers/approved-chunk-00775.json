      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينهض موسى ويتجه إلى داثان وأبيرام بعد رفضهما المجيء إليه، ويتبعه شيوخ إسرائيل إلى موضعهما.",
        "theological": "تُظهر المبادرة أن موسى لا يعتزل المتمرّدين فورًا، بل يذهب إليهم في محاولة أخيرة لإقناعهم والرجوع بهم.",
        "deep": "مرافقة الشيوخ تمنح هذا التوجّه طابعًا علنيًا؛ فهي تسند براءة موسى المجروحة وتواجه تحدّي المتمرّدين بحضورٍ مشهود.",
        "applied": "عند اشتداد النزاع، لا يكفي الانسحاب البعيد؛ فقد يتطلب طلب الإصلاح التوجّه المتواضع إلى الرافضين مع حفظ الحق والشهود."
      }
    },
