      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد العدد أن نارًا خرجت من عند الرب وأكلت الرجال المئتين والخمسين الذين كانوا يقدمون البخور.",
        "theological": "يربط المصدر النار بادعاء هؤلاء خدمة لم تُعيّن لهم، فيبرز جدية المحافظة على ما رتبه الله للعبادة.",
        "deep": "يقابل هذا القضاء مصير داثان وأبيرام، فيبين أن الحكم شمل وجهي التمرد: المخالفة في المحلة والتعدي عند خيمة الاجتماع.",
        "applied": "ينبه العدد إلى قبول حدود المسؤولية المعطاة، وعدم تحويل الرغبة في المكانة إلى اقتحام عمل ليس للإنسان."
      }
