      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُفهم في التفسير النصي أن العذاب يطال المتمردين من الذين حُسبوا في العدد من عشرين سنة فصاعداً، لأنهم تذمروا على الرب، فتسقط جثثهم في البرية.",
        "theological": "يظهر النص أن التذمر لم يكن مجرد شكوى عابرة بل خروجاً عن طاعة الله، فتكون النتيجة خيبة الجيل الذي رأى الآيات لكنه رفض الإيمان بوعده.",
        "deep": "هنا يبرز التوازن بين عظمة وعد الله وصرامة حكمه: التجاوز عن صوت الرب يفضي إلى فقدان أرض الوعد، وتعويد القلب على الاعتراض يقطع الطريق إلى الدخول.",
        "applied": "يدعو هذا المقطع إلى التمييز بين الندم الحقيقي وامتناع التذمر، لأن الرؤية والآيات لا تغني عن الخضوع للرب في زمن الضيق والانتظار."
      }
    },
