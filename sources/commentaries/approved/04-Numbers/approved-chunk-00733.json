      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تحدثت مريم وهارون ضد موسى بسبب امرأته الكوشية، فبرز في هذا الموقف التذمر داخل الأسرة في وقت كان الوحي قد رفع مقام موسى.",
        "theological": "في هذا النص لا تُحاكم شخصية موسى فقط، بل تُسأل السلطة التي اختارها الرب في خدمة إسرائيل، فتظهر نية التمرد في صورة سؤال.",
        "deep": "عندما يشتد الخلاف بين الأقرباء، يتسع الباب للغضب، فيتحول النقد الخفي إلى إهانة تُشعل نيران الحسد والتشكيك.",
        "applied": "يُحذّر هذا المقطع من أن الكلام ضد الخادم الذي اختاره الرب في البيت قد يفسد العلاقات ويغذي التذمر قبل أن يهدأ."
      }
    },
