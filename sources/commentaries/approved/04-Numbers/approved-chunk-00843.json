      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع النص بداية الانحراف في شطيم، حيث نشأت علاقات مع بنات موآب قادت الشعب إلى الزنى.",
        "theological": "يكشف الحدث أن الشعب الذي حُفظ من اللعنة صار معرّضا للخطر حين ابتعد بنفسه عن عهد إلهه.",
        "deep": "لا يظهر السقوط هنا كفعل منعزل؛ فالاقتراب والعلاقات الودّية مهّدا لقبول دعوة أفسدت الولاء.",
        "applied": "ينبّه النص إلى فحص العلاقات والدعوات الجذابة، إذ قد تقود خطوات تبدو اجتماعية إلى تنازل أعمق."
      }
    },
