      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تسجل الآية تتابعا واضحا: دعوة إلى ذبائح الآلهة، ثم أكل الشعب، ثم سجودهم لتلك الآلهة.",
        "theological": "يربط المشهد بين المشاركة في الوليمة الوثنية وفعل السجود، فيصير الطعام جزءا من الانضمام إلى العبادة.",
        "deep": "الاستجابة للدعوة لم تقف عند الحضور؛ بل انتقلت من المشاركة الخارجية إلى فعل عبادة يناقض أمانة إسرائيل.",
        "applied": "تدعو الآية إلى التمييز في المشاركات التي تبدو بريئة، لأن بعض الممارسات تحمل معها ولاءات لا ينبغي قبولها."
      }
    },
