      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "عند اجتماع الجماعة على موسى وهارون، غطّت السحابة خيمة الاجتماع على نحو أوضح من وجودها المعتاد، وظهر مجد الرب ظهورًا عجيبًا.",
        "theological": "ظهور المجد عند الخيمة يبيّن أن الرب حاضر في مواجهة التمرد، ويحمي خادميه ويكشف خطأ الذين اجتمعوا لاتهامهما.",
        "deep": "اتجاه الأنظار إلى الخيمة وسط الخصومة يضع النزاع البشري أمام حضور الرب، حيث لا تبقى التهمة أو القوة الجماعية هي الكلمة الأخيرة.",
        "applied": "عندما تتصاعد الاتهامات، لا تجعل ردك انفعالًا مماثلًا؛ توجّه أولًا إلى الرب واطلب أن يظهر الحق ويحفظك من الانتقام."
      }
    },
