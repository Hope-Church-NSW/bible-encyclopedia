      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستخدم داثان وأبيرام وصف «أرض تفيض لبنًا وعسلًا» عن مصر على سبيل السخرية المريرة من وعد كنعان.",
        "theological": "يقلب التمرد نعمة الخروج إلى تهمة، ويجعل خدمة موسى المعينة من الله ادعاءً للتسلط.",
        "deep": "اتهموا موسى بأنه يقودهم إلى الموت ويطلب السيادة الدائمة، مع أن عجزهم عن دخول الأرض نتج من رفضهم.",
        "applied": "ينبغي فحص الشكوى حين تعيد تفسير الإحسان إساءةً وتلقي مسؤولية نتائج العصيان على غير أصحابها."
      }
    },
