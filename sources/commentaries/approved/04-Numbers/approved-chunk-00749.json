      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوسّع العدد دائرة السامعين إلى سكان الأرض، ويعدّد دلائل حضور الرب المرئي وقيادته للشعب.",
        "theological": "حضور الرب في وسط شعبه، والسحاب فوقهم، والقيادة نهارًا وليلاً، هي أساس حجة موسى.",
        "deep": "لا يعرض موسى أخبارًا عابرة، بل شهادة متراكمة جعلت الأمم تعرف أن الرب قريب من شعبه.",
        "applied": "تدعونا الآية إلى تذكّر علامات عناية الرب السابقة حين نصلّي وسط نتائج الفشل والخوف."
      }
    },
