      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يكمل العدد تعداد مدن بني جاد: عطروت شوفان ويعزير ويجبهاة، ضمن سجل أعمالهم العمرانية في الأرض الممنوحة.",
        "theological": "يبقي السجل التركيز على تنفيذ بني جاد لما استقر لهم، إذ تتجسد حيازتهم للأرض في مدن محددة لا في وعد مجرد.",
        "deep": "يضيف المصدر أن يعزير كانت قرب نبع مشهور، فتظهر القائمة ارتباط المواضع المبنية بمعالم الأرض ومواردها القريبة.",
        "applied": "تعلّمنا الآية أن تدبير الموارد يبدأ بمعرفة الأماكن المعهودة وخصائصها، ثم العمل المنظم فيها بما يخدم استقرار الجماعة."
      }
    },
