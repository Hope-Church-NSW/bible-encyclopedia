      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل النص منح موسى لبني جاد وبني رأوبين ونصف سبط منسى أرض مملكتي سيحون وعوج، شاملاً المدن وتخومها المحيطة.",
        "theological": "يظهر العطاء بوصفه تثبيتاً لامتلاك الأرض المطلوبة بعد التزام القبائل بالعبور المسلح مع إخوتهم قبل الرب.",
        "deep": "إدخال نصف سبط منسى في القسمة يلفت إلى أن توزيع الأرض اتسع عن الطلب الأول، مع ارتباطه بأمن المنطقة الحدودية.",
        "applied": "يذكّر ترتيب الميراث هنا بأن نيل المنفعة الخاصة لا يعفي الجماعة من الوفاء بالتزاماتها المشتركة تجاه الإخوة."
      }
    },
