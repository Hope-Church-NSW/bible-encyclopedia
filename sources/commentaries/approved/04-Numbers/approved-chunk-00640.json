      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن جاميسون وفوست وبراون أنّ هذا الكلام يفتتح تفصيل تكريس سبط لاوي بديلاً عن الأبكار في خدمة الرب.",
        "theological": "يوضح كايل ودليتش أنّ الرب اختار اللاويين لهذه الخدمة لأنه قرر أن يتخذهم لنفسه عوضاً عن جميع أبكار مصر الذين ضربهم يوم الخروج.",
        "deep": "يرى كايل ودليتش أنّ اللاويين أثبتوا جدارتهم لهذا الاختيار بدفاعهم الأمين عن كرامة الرب عند عبادة العجل الذهبي، وليس بمجرد انتساب موسى وهارون إلى سبطهم.",
        "applied": "يعلّمنا هذا الكلام الموجّه إلى موسى أنّ تكليف الرب لخدامه يصدر بأمره المباشر، فلا يقوم عمل مقدس إلا بدعوة صريحة منه."
      }
    },
