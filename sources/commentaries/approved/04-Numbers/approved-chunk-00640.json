      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير جاميسون وفوست وبراون إلى أنّ عبارة تقديم سبط لاوي المرتبطة بهذا السياق تحمل معنى التقريب الرسمي أمام هارون في خدمة المسكن.",
        "theological": "يذكّر متى هنري بأنّ تثبيت هارون وبنيه في الكهنوت هنا تكرار لما سبق، وأنّ الرسول استعمل هذا التعبير بقوله فلنواظب على خدمتنا مؤكداً وجوب المواظبة على العمل المقدس.",
        "deep": "يوضح متى هنري أنّ منع الغريب من الاقتراب يجعل الكهنة كحرّاس أبواب بيت الرب، عليهم أن يمنعوا كل من لا يحق له الدنو من الأمور المقدسة لئلا يدنّسوها.",
        "applied": "يحذّرنا متى هنري بأنّ الاقتراب من خدمة الرب دون دعوة منه خطر عظيم، فمن تجاوز الحدود المرسومة يتعرض لدينونة كما جرى لعزّا بحسب المثال الذي ساقه."
      }
    },
