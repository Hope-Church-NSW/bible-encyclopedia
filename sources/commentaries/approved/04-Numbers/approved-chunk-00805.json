      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أعلن الله موسى وهارون على جبل هور قرار الموت لا في محكمة علنية بل في مكان معين يشهده الشعب.",
        "theological": "اختيار جبل هور على حدود أدوم كمكان إعلان الموت يرمز لانتهاء مرحلة من القيادة قبل دخول الأرض الموعودة.",
        "deep": "الحديث المباشر من الله لموسى وهارون معاً يعكس خطورة ما حدث في ماء مريبة وتأثيره على القيادتين معاً.",
        "applied": "يعلّم أن التحذيرات الإلهية قد تصل إلى أشخاص معينين في لحظات حاسمة من حياتهم الروحية."
      }
    },
