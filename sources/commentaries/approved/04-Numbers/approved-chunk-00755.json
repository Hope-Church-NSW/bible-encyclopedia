      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستثني النص يشوع بن نون وكالب بن يفنة من رجال التجسس، ويقرر أنهما عاشا بينما مات أصحاب التقرير الرديء.",
        "theological": "حياة يشوع وكالب وسط موت العشرة تؤكد تمييز الرب بين الشاهدين اللذين ثبتت شهادتهما وبين من أضلوا الجماعة.",
        "deep": "المشهد يضع الناجين قرب الهالكين، فيبرز أن الموت لا يقع سهوًا؛ فالحياة هنا توافق قصد الرب للشاهدين الأمينين.",
        "applied": "عند ضغط الجماعة، لا يجعل اتفاق الأكثرية الشهادة الخاطئة حقًا؛ فليثبت المرء في القول الصادق وإن خالف المحيطين به."
      }
    },
