      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأتي الأمر لموسى وهرون بالافتراز عقب اجتماع الجماعة مع المتمرّدين عند خيمة الاجتماع.",
        "theological": "يُظهر التهديد بالفناء في لحظة مدى استفزاز التمرّد وواقعية غضب الله على الجماعة المشتركة فيه.",
        "deep": "لا يقتصر الخطر على محرّك العصيان؛ فمشاركة الجماعة في التجمّع جعلتها موضع إنذار بالدينونة العاجلة.",
        "applied": "ينبّه النص إلى أن اتّباع الجمع أو الوقوف متفرّجًا مع الشر قد يجعل الإنسان شريكًا في عواقبه."
      }
    },
