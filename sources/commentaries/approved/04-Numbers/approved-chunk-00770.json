      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "موسى يأمر قورح وكل جماعته بأخذ المجامر (المباخر) استعدادا لاختبار الرب يوم الغد.",
        "theological": "تقديم البخور كان أقدس عمل كهنوتي يقرب الإنسان من حضرة الله، فاختاره موسى وسيلة للفصل العادل.",
        "deep": "الأمر بأخذ المجامر لم يكن تهكما بل دعوة حقيقية للاختبار، تعطي قورح فرصة شرعية يثبت فيها دعواه.",
        "applied": "الله يعطي الفرصة للتحقق من الدعاوى بطرق واضحة وعلنية، لا في الظلام ولا بسرية بل بشهادة الجماعة."
      }
    },
