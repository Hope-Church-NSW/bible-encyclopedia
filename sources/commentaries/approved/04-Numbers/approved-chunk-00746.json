      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل متى هنري أن الجماعة اتهمت الرب بأنه أتى بهم إلى هذه الأرض ليسقطوا بالسيف وتصير نساؤهم وأطفالهم غنيمة، وهو افتراء صريح على مقاصده.",
        "theological": "يعتبر متى هنري هذا القول تجديفًا شنيعًا ينسب إلى محبة الله الخالصة أسوأ الخبث، وإلى حقه الأزلي أبشع الرياء، وكأن وعوده كانت خديعة مبيتة لإهلاكهم.",
        "deep": "يشير كايل ودليتش إلى أن سؤالهم عن سبب إتيان الرب بهم ليسقطوا بالسيف وتصير نساؤهم وأطفالهم غنيمة يعكس قنوطًا لا أساس له، مبنيًا على تقرير الجواسيس لا على وعد الرب.",
        "applied": "يعلّق متى هنري بأن سؤالهم عن الرجوع إلى مصر بدل التقدم كان يجب أن يُستبدل بسؤال أفضل، وهو هل ليس خيرًا أن يقنع الإنسان بما هو فيه ويحسن حاله الروحي بدل التذمر."
      }
    },
