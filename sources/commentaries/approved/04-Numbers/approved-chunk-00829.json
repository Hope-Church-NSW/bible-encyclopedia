      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح بلعام قوله بذكر أن بالاق، ملك موآب، استدعاه من أرام ومن جبال المشرق ليطلب لعن يعقوب وشتم إسرائيل.",
        "theological": "يكشف القول صراحة مقصد بالاق: تحويل كلام بلعام إلى أداة عداء ضد إسرائيل، قبل أن يعلن العدد التالي عجز هذا المقصد.",
        "deep": "صيغة القول الموجزة والمصوّرة تعرض الطلب كما هو؛ فذكر المنشأ والرحلة يبرز المسافة التي قطعها بلعام من أجل مهمة اللعن.",
        "applied": "يفيدنا العدد في تسمية الدوافع بصدق؛ فالتعبير الواضح عن طلب مؤذٍ هو بداية إدراك أن الغاية لا تصير صالحة لمجرد تنظيمها بعناية."
      }
    },
