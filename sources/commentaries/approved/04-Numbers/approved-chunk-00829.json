      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل النص أن الرب وضع كلامًا محددًا في فم بلعام وأمره أن يعود إلى بالاق لينطق به كما أُعطي له.",
        "theological": "تظهر الآية أن مضمون القول ليس خاضعًا لرغبة بلعام أو لطلب بالاق، بل إن الرب يوجّه الرسالة التي يجب إعلانها.",
        "deep": "الذي قصد اللعن صار حاملًا لكلمة لا يملك صياغتها؛ فالمشهد يبيّن أن المقاصد البشرية لا تعطل تدبير الله.",
        "applied": "تدعو الآية إلى الحذر من استعمال الكلام الديني لخدمة المصلحة، وإلى قبول أن كلمة الله قد تخالف ما يرغب فيه السامع."
      }
    },
