        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تؤكّد الآية أن الكينيين لا ينجون طويلاً إذا ما طال مرادهم، لأن الفناء يأتي حين يُستعبدون ويُحملون إلى الأسر تحت حكم آشور.",
        "theological": "هنا يظهر أن الله يضع موعد السقوط، فلا يظلّ الظنّ بالأمن مستبراً إذا كان الإنسان يرفض الخضوع لأمر الله ويطلب الاستقلال.",
        "deep": "كلّ أمنٍ بشريٍّ يظلّ هشّاً إذا غابت الطاعة، لأن الثبات الذي لا ينهض من الله لا يلبث أن يفضح ضعفه في زمانه.",
        "applied": "حين تظنّ أن استقرارك ممكناً، تذكر أن القلوب تحتاج إلى التواضع والاعتماد على الله، لا إلى التمسك بالوضع المريح وحده."
      }
    },
