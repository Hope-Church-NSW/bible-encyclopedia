      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص رجلا إسرائيليا يدخل بمديانية أمام موسى والجماعة، بينما الشعب يبكي عند باب خيمة الاجتماع.",
        "theological": "وقاحة الفعل تضاد توبة الجماعة؛ فالخطية هنا لا تختبئ بل تتحدى حضور العبادة وطلب رفع الغضب.",
        "deep": "اجتماع البكاء مع إعلان المعصية يكشف عمق الفساد: فبعض القلوب لا تلين حتى أمام الوبأ والنوح العام.",
        "applied": "حين يحزن المجتمع على الشر، يزيد أثر من يفاخر به علنا؛ فلا تجعل الجرأة على الخطأ تطفئ روح التوبة."
      }
    },
