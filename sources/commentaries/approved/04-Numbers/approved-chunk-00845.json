      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح كايل ودليتش أن عبارة غيرتي في الأصل تعني غيرة الرب نفسه لا غيرة من أجله، أي أن فينحاس امتلأ بغيرة يهوه ذاتها فاندفع بها ليمنع فناء بني إسرائيل في وقت الغضب.",
        "theological": "يرى متى هنري أن رد الغضب عن الشعب هو أعظم خدمة يمكن تقديمها له، وأن الرب يسر بمن يكون أداة لصرف سخطه لأن رحمته تسبق دينونته حتى في لحظة الجزاء العادل.",
        "deep": "يشدد جيمسون وفوست وبراون على أن هذا التأكيد الإلهي كان ضروريا ليثبت أمام الجماعة أن فعل فينحاس لم يكن عملا فرديا متهورا بل تنفيذا لغيرة الرب نفسه في وسطهم.",
        "applied": "يدعو متى هنري إلى أن يسهم كل مؤمن في رد غضب الله عن شعبه، ولو لم يكن بمثل فعل فينحاس، من خلال الصلاة والسعي الجاد لوضع حد لانتشار الشر في محيطه."
      }
    },
