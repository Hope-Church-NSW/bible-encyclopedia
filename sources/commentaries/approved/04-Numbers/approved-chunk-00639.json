      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد النص حقّ اللاويين في حفظ شعائر هارون وشعائر كل الجماعة أمام خيمة الاجتماع، أي في رعاية ما يخص مسكن الرب.",
        "theological": "تتجلّى هنا مسؤولية الخدمة تجاه الرب والجماعة معاً: لا يقتصر الواجب على الطقوس بل يشمل حفظ الترتيب الذي يحفظ قداسة التجمع.",
        "deep": "العبادة لا تُفهم كأداء منفرد بل كحراسة للهيكل الروحي، حيث تُحفظ حدود الخدمة وتُصان المواقف من الفوضى.",
        "applied": "يُحذَّر من التهاون في مهام خدمة الآخرين، لأن حفظ ما يخص الله يقتضي يقظة واهتماماً مستمراً."
      }
    },
