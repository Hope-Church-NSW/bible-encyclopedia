      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُظهر النص أن الرب يثبت الواجب الكهنوتي بعد تحذير من الإقدام على الخدمة، فيُسند المهمة إلى هارون وأسرته.",
        "theological": "يُبرز هذا الموضع أن خدمة الرب تُمارَس في ترتيب يضعه الله نفسه، لا بحسب إقدام الإنسان أو ترفيهه عن القُدس.",
        "deep": "يتجلى في هذا الموضع أن الإحكام لا يكتمل بالاختيار وحده بل بالتحذير من التعدّي على ما يخص الرب.",
        "applied": "يستفاد أن الخدمة الدينية تُؤخذ بجدّية، وأن الالتزام يقتضي طاعة واضحة تجاه ما حدده الله في مكانه."
      }
    },
