      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أقرّ بوعز بشهرة راعوث الطيبة في المدينة، وأكّد التزامه بتنفيذ كل ما تطلبه باعتباره وليّاً.",
        "theological": "السمعة الفاضلة والفضيلة المثبتة أساس للثقة والعهد الزوجي الذي لا يتعلق بالمكاسب المادية.",
        "deep": "إقرار الجماعة بفضل امرأة فقيرة يعكس أن الفضيلة الحقيقية لا تُخفيها الفقرة أو الغربة.",
        "applied": "السيرة الطيبة والعمل الصالح في الجماعة يفتح أبواب الفرص والتحالفات الموثوقة."
      }
    },
