      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "طاعة راعوث الكاملة للمشورة والاستمرار في الجني حتى نهاية الحصادين توفر لها قوتاً وفيراً.",
        "theological": "الاستقامة في الالتزام بشخص واحد والبقاء في البيت الواحد يجني بركة إلهية وتقديراً اجتماعياً.",
        "deep": "التفاني في العمل الشريف طوال حصاد الشعير والحنطة يثمر برّاً عملياً نحو الأم وحناناً إنسانياً.",
        "applied": "من يثابر على العمل النبيل ولا ينحرف عن السبيل الآمن ولا يهمل أهله يستحق الكرامة والتقدير."
      }
