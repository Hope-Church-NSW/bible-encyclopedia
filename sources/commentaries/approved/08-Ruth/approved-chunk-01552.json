      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تعليمات بوعز لراعوث بالالتصاق بفتيانه طوال فترة الحصاد توفر لها الحماية المستمرة والمؤونة المستقرة.",
        "theological": "وجود وعد من رب صالح يجنب الغريبة الفقيرة الضياع والخطر في السعي نحو مصادر غير معروفة.",
        "deep": "الكلمة الموثوقة تحمل في طياتها أماناً وكفالة مستدامة للعاملة الجادة التي تحافظ على التزامها.",
        "applied": "من يجد كفيلاً وديعاً وعادلاً فعليه أن يلزم جانبه ثابتاً وأن يثق في نية إحسانه دون قلق."
      }
    },
