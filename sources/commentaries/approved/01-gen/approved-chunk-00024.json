    "11:17": {
      "reference": "01-gen 11:17",
      "text": "وَعَاشَ عَابِرُ بَعْدَ مَا وَلَدَ فَالَجَ أَرْبَعَ مِئَةٍ وَثَلاَثِينَ سَنَةً، وَوَلَدَ بَنِينَ وَبَنَاتٍ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
