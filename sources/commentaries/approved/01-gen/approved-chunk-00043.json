      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "إبراهيم توسل إلى الله بالدعاء فاستجاب الله دعاءه وشفى أبيمالك وزوجته وإماءه فعادت إليهن القدرة على الإنجاب.",
        "theological": "أكرم الله إبراهيم النبي فجعل رفع البلاء عن أبيمالك وأهل بيته موقوفاً على دعاء إبراهيم لا على مجرد استرجاع سارة.",
        "deep": "رغم أن أبيمالك استرجع سارة وأصلح ظلمه إلا أن الحكم الإلهي لم يُرفع حتى دعا له إبراهيم الصديق بنفسه.",
        "applied": "دعاء الأتقياء والصالحين له قيمة عظيمة عند الله ولا يجب أن نستخف به فقد يكون سبب نجاتنا في الشدائد."
      }
    },
    "20:18": {
      "reference": "01-gen 20:18",
      "text": "لأَنَّ الرَّبَّ كَانَ قَدْ أَغْلَقَ كُلَّ رَحِمٍ لِبَيْتِ أَبِيمَالِكَ بِسَبَبِ سَارَةَ امْرَأَةِ إِبْرَاهِيمَ.",
