      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "رجوع المياه المتواصل خلال فترة ممتدة يظهر العناية الطبيعية تحت التوجيه الإلهي، وليس انعكاساً فورياً للفيضان.",
        "theological": "عمل الخلاص الإلهي يتبع نمط الخلق—كلاهما يسير تدريجياً لتجنب الاستسلام أو الافتراض المتسرع.",
        "deep": "انحسار المياه المستمر يعكس صبر الله في الاستعادة؛ الفترة الممتدة تقدس امتنان البقية وتعمّق إيمانهم.",
        "applied": "الراحة من البلاء غالباً ما تأتي تدريجياً؛ لا تيأس إذا لم يكن التغيير فورياً بل استمر في الثقة بتوقيت الله."
      }
    },
