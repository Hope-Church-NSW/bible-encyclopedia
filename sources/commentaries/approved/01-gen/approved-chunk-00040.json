      "explanation_lines": {
        "academic": "صعد لوط من صوغر وسكن في الجبل مع ابنتيه، لأنه خاف أن يسكن في المدينة، فسكنوا في مغارة.",
        "theological": "خوف لوط من صوغر يعكس فقدان الثقة في الملاذ الذي اختاره بنفسه، والالتجاء للجبل الذي عينه الله أولاً.",
        "deep": "الحياة في الكهف بالجبل بعد الرفاهية في سدوم تعكس عدل الله في تقليل من يختار الخطية على الطاعة.",
        "applied": "الملاذات التي نختارها نحن بدل اختيار الله تثبت عدم أمانها، والعودة إلى طريق الله تأتي بعد خيبات أمل."
      }
    },
