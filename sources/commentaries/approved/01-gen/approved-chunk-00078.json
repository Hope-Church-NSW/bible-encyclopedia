      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "إضافة معلومة أن يعقوب قريب ويأتي خلف الماشية، مما ينفي احتمالية الهروب أو الخوف من المواجهة المباشرة.",
        "theological": "الشجاعة الأدبية والاستعداد للقاء المخوف مع الثقة بأن الله معه، يظهر حقيقة الإيمان بالعمل.",
        "deep": "عدم إظهار الخوف في الرسالة يرفع من قيمة الاعتذار ويجعله أكثر حقيقية وصدقاً.",
        "applied": "عند الاعتذار، يجب عدم إظهار الضعف أو الخوف المفرط، بل التمتع بثقة معقولة في حسن النية."
      }
    },
