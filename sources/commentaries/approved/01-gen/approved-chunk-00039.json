      "explanation_lines": {
        "academic": "احتاط رجال سدوم بالبيت قبل أن ينام الملاكان، شاملاً الجميع من الشباب إلى الشيوخ وجميع أهل المدينة.",
        "theological": "الاجتماع الشامل لرجال سدوم يعكس انتشار الخطيئة الوبائي والإجماع على الشر، مما يملأ كيل المدينة بالذنب.",
        "deep": "عدم استثناء أي فئة عمرية من هذا التجمع يدل على تحول كامل للمجتمع نحو الرذيلة وغياب الصوت المعارض.",
        "applied": "عندما تسيطر الخطيئة على المؤسسات والقيادة والشعب معاً، لا يبقى سوى حماية الأقلية الصالحة والاستعداد للدينونة الإلهية."
      }
    },
