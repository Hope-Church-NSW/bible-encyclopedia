      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "الوعد بتكثير النسل كنجوم السماء والأرض وبركة الأمم في نسله يتضمن أبعاداً عددية وجغرافية وروحية.",
        "theological": "النسل المكثّر يرمز إلى امتداد البركة عبر الأجيال، والأمم المباركة في نسله تشير إلى نطاق العهد الأممي.",
        "deep": "الكثرة الظاهرة والبركة العالمية لا تأتي من قوة الإنسان بل من وعد الله؛ العدد والمدى يظهران قوة العهد الإلهي.",
        "applied": "ثقتنا في وعود الله يجب أن تتجاوز الإحصاء والقياس، فما يعده الله يتجاوز التوقع والعد."
      }
    },
