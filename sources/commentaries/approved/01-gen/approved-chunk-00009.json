      "explanation_lines": {
        "academic": "تجمع الآية بين رفض التقدمة ووصف الأثر النفسي الفوري: غضب شديد وسقوط الوجه؛ فتربط الحدث الخارجي بانكشاف الداخل مباشرة.",
        "theological": "رفض الله لا يُصوَّر اعتباطيًا، بل كحكم أخلاقي يختبر الإنسان؛ المشكلة تتفاقم حين يتحول التنبيه الإلهي إلى مرارة بدل توبة.",
        "deep": "انكسار الملامح هنا ليس تواضعًا بل امتعاضًا جريحًا؛ الألم من عدم القبول قد يدفع إلى مراجعة النفس أو إلى عداء للآخر.",
        "applied": "عند الفشل أو الرفض، قاوم رد الفعل الغاضب السريع؛ توقّف وفتّش السبب بصدق قبل أن تنقل غضبك إلى علاقة قريبة أو قرار مؤذٍ."
      }
    },
