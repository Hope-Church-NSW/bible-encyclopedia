        "academic": "سام ويافث أخذا رداءً ووضعاه على كتفيهما ومشيا للخلف ليستر عورة أبيهما دون أن يريا الفاحشة.",
        "theological": "الحشمة والاحترام للوالدين يجب أن تمنعنا من رؤية عوراتهم، بل نحمي كرامتهم بكل ما أوتينا من قوة.",
        "deep": "الطريقة التي ستر بها سام ويافث تعكس احترام عميق لا يسمح حتى برؤية الزلة، بل يغطيها بالعطف.",
        "applied": "علينا أن نتعلم أن نحتاط لحفظ كرامة والدينا وأساتذتنا، بل حتى الغرباء، بكل حساسية وحذر."
      }
    },
