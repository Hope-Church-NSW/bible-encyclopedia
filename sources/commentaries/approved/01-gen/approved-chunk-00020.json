      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أسماء أبناء نوح الثلاثة الذين خرجوا من الفلك هم سام وحام ويافث، وحام هو والد كنعان.",
        "theological": "من هؤلاء الثلاثة تنبثق البشرية جمعاء بعد الطوفان، مما يظهر قصد الله في استمرار النسل البشري عبر هذه الخطوط الثلاث.",
        "deep": "التركيز على نسب حام وكنعان يشير إلى أهمية هذا الفرع في السرد التاريخي لاحقاً، وخاصة في علاقته بالأرض الموعودة.",
        "applied": "يذكرنا بأن كل بني البشر يعودون إلى عائلة واحدة، مما يدعو إلى الوحدة والتعاطف بين الأسر البشرية المختلفة."
      }
    },
