      "explanation_lines": {
        "academic": "نوح بدأ عمله كفلاح وغرس كرماً، وهو عودة له إلى مهنته بعد انصرافه للسفينة والبناء.",
        "theological": "العمل اليدوي والاشتغال بالأرض ليسا أقل شأناً من المهام الروحية الكبرى، بل نوح لم يعتبر نفسه أعظم من هذا العمل.",
        "deep": "بعد النجاة العظيمة من الطوفان، عاد نوح للحياة العادية مباشرة، مما يدل على التطبيق العملي للإيمان في الحياة اليومية.",
        "applied": "علينا أن نقدس أعمالنا اليومية والعادية ونراها خدمة لله، غير متعطلين عن العمل الجاد بأي حال."
      }
    },
