        "academic": "إكمال آدم تسمية جميع الحيوانات وملاحظة غياب مساعد مماثل له من بين كل المخلوقات الظاهرة.",
        "theological": "تؤكد عدم كفاية عالم المخلوقات الأخرى لإرضاء احتياجات الإنسان الروحية والنفسية والعاطفية.",
        "deep": "كرامة الطبيعة الإنسانية تتجلى في أنها تفوق جميع المخلوقات الحيوانية، وليس هناك معادل لها سوى مخلوق مماثل.",
        "applied": "يجب أن ندرك أن الأشياء المادية والحيوانات لا يمكن أن تملأ فراغ القلب البشري الذي يحتاج إلى علاقات من نوعه."
      }
