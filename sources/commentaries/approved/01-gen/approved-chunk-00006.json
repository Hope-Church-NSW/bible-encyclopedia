      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تشكيل الله لكل حيوانات البرية وطيور السماء من الأرض وإحضارها لآدم لكي يرى ما يسميها.",
        "theological": "إظهار سلطان الإنسان على الخليقة وتسليمه أمانة التسمية كدليل على معرفته وقوته كمخلوق في صورة الله.",
        "deep": "فعل التسمية يعكس الحكمة والسلطة، وكل اسم يضعه آدم يثبت سيادته وتفوقه على الحيوانات من ناحية العقل والكلام.",
        "applied": "مسؤولية الإنسان تجاه الخليقة تبدأ من المعرفة والتسمية، وينبغي أن نستخدم عقولنا في فهم خليقة الله وإدارتها."
      }
    },
