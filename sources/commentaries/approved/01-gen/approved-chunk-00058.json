      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعقوب فرض على عيسو اليمين لتثبيت الصفقة والقضاء على أي احتمال للتراجع عن البيع.",
        "theological": "رغبة يعقوب في البكورية كانت مرتبطة بالامتيازات الروحية التي فقدها عيسو في الحقول.",
        "deep": "يكشف الحوار عن حكمة يعقوب في اختيار اللحظة المناسبة والتأكد من عدم استرجاع الصفقة لاحقاً.",
        "applied": "الحرص على توثيق الاتفاقيات المهمة بالشهود والأيمان يضمن عدم حدوث نزاعات لاحقة."
      }
    },
