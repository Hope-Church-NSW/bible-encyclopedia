      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "رؤية إخوة يوسف أن أباهم يحبه أكثر منهم يثير غيرتهم، فيكرهونه ولا يستطيعون كلامه بسلام.",
        "theological": "الكراهية والحقد ينشآن من الغيرة والشعور بعدم العدالة، وهذا يؤدي إلى صدور الأفعال الشريرة.",
        "deep": "من يحبه الله ويبارك حياته غالباً ما يواجه كراهية من هذا العالم، لأن الشر يكره النور والخير.",
        "applied": "على من يلتمس الصداقة والمسالمة أن يتوقع منهم الحقد والعداوة، فالفضيلة والمحبة الإلهية تثير أحقاد الأشرار."
      }
    },
