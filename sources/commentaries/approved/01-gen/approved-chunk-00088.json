            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسكن يعقوب في أرض غربة أبيه كنعان، ما يعكس وضع الغريب والمسافر في الأرض المعطاة.",
        "theological": "إقامة يعقوب تشير إلى أن البشر لن يكونوا في موطن حقيقي إلا في السماء، وهذه حياة النزول والغربة.",
        "deep": "السكن في أرض الغربة يعلم الروح عدم التعلق بالعالم الحاضر والترقب للمدينة التي أساسها وصانعها الله.",
        "applied": "على المؤمن أن لا يستقر قلبه في هذا العالم، بل يجعل رجاءه وتطلعاته نحو السماء والحياة الأبدية."
      }
    },
    "37:2": {
      "reference": "01-gen 37:2",
      "text": "هذِهِ مَوَالِيدُ يَعْقُوبَ: يُوسُفُ إِذْ كَانَ ابْنَ سَبْعَ عَشَرَةَ سَنَةً، كَانَ يَرْعَى مَعَ إِخْوَتِهِ الْغَنَمَ وَهُوَ غُلاَمٌ عِنْدَ بَنِي بِلْهَةَ وَبَنِي زِلْفَةَ امْرَأَتَيْ أَبِيهِ، وَأَتَى يُوسُفُ بِنَمِيمَتِهِمِ الرَّدِيئَةِ إِلَى أَبِيهِمْ.",
      "summary": "",
      "sources": [
