      "explanation_lines": {
        "academic": "ولادة شيث في السنة 130 من عمر آدم تأتي بعد قتل هابيل بفترة، مما يشير إلى استمرار النسل المقدس.",
        "theological": "تشابه شيث بآدم يعكس انتقال الطبيعة الإنسانية المشوبة بالخطية من الأب إلى الابن بعد السقوط.",
        "deep": "فقدان آدم لصورة الله الأصلية جعل من المستحيل عليه نقل هذه الصورة لذريته، بل نقل طبيعته الفاسدة.",
        "applied": "ميلادنا من آدم يعني وراثتنا للطبيعة الخاطئة، وهذا يفسر حاجتنا الضرورية إلى التجديد الروحي والفداء."
      }
    },
