      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤرَّخ نسب عيسو (أدوم) حوالي عام 1780 ق.م. والاسم الإضافي يحفظ ذكر بيعه للبكورية بطعام حمر اللون.",
        "theological": "الاسم أدوم يعكس الحكم الإلهي الدائم على من يترك وراثته المقدسة من أجل حاجة عابرة.",
        "deep": "السجل النسبي لعيسو يكشف كيف أن الاختيارات المخالفة للحكمة الإلهية تترك بصمات دائمة على الذرية والتاريخ.",
        "applied": "نتذكر أن قراراتنا الحالية ستُذكر وتؤثر على ميراثنا الروحي لأجيال قادمة."
      }
    },
