      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "البقرات الهزيلة تأكل البقرات السمينة ولا يظهر عليها أثر الأكل، وهذه صورة فريدة توضح كمية الندرة والجوع الشديد.",
        "theological": "الجوع يمحو أثار الوفرة تماما، مما يعلم عن طبيعة الأزمات: تستطيع أن تمحو كل ما قبلها من إنجازات وممتلكات.",
        "deep": "عدم ظهور أثر الطعام على البقرات الهزيلة يصور استيعاب الكارثة الكاملة لكل مظاهر الخصب السابقة.",
        "applied": "الأزمات الاقتصادية الحادة قد تستنزف كل الموارد المتراكمة إن لم نخطط بحكمة لمواجهتها."
      }
    },
