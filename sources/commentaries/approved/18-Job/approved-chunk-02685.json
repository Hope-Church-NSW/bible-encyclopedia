      "explanation_lines": {
        "academic": "يعرض العدد المطر والبرق والرعد أمثلة على ظواهر جرى لها قرار وطريق ضمن نظام الطبيعة.",
        "theological": "يربط التفسير تعيين مجرى الطبيعة بقصد إلهي سابق يشمل الأسباب والنتائج والاستخدامات الخاصة بها.",
        "deep": "وجود طريق للبرق وقرار للمطر يمنع تصور الكون كسلسلة مفاجآت؛ فالأحداث تجري ضمن ترتيب محدد.",
        "applied": "حين تدهشك القوى التي لا تتحكم بها، تذكّر أن اضطرابك لا يعني غياب النظام من بين يدي الله."
      }
    },
