            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستخدم الرسول نداءً حادًا ليكشف أن الغلاطيين انحرفوا عن طاعة الحق، مع أن رسالة المسيح المصلوب عُرضت أمامهم بوضوح.",
        "theological": "إظهار المسيح مصلوبًا يضع أمامهم أساس البشارة، ولذلك فإن الرجوع عن طريقها إلى طريق آخر ليس مجرد ضعف، بل رفض للحق المعلن.",
        "deep": "تكشف الآية أن المعرفة الواضحة لا تضمن الثبات؛ فالإنسان قد يرى الحق ماثلًا أمامه ثم يسمح للتضليل بأن يبدّل اتجاهه.",
        "applied": "افحص ما تؤمن به وتمارسه: لا يكفي أن يكون الحق معروفًا لديك، بل ينبغي أن تظل خاضعًا له وأمينًا له حين تظهر بدائل مضللة."
      }
    },
    "3:2": {
      "reference": "48-Galatians 3:2",
      "text": "أُرِيدُ أَنْ أَتَعَلَّمَ مِنْكُمْ هذَا فَقَطْ: أَبِأَعْمَالِ النَّامُوسِ أَخَذْتُمُ الرُّوحَ أَمْ بِخَبَرِ الإِيمَانِ؟",
