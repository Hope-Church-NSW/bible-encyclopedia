      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعلن النص أن المسيح افتدانا من لعنة الناموس بصيرورته لعنة لأجلنا، ويستشهد بالحكم المتعلق بالمعلّق على خشبة.",
        "theological": "الخلاص في العدد هو انتقال من لعنة الناموس، وقد تم عبر تحمّل المسيح الوصف المرتبط بالمعلّق على الخشبة لأجلنا.",
        "deep": "تظهر المفارقة أن الذي يحرر من اللعنة دخل إلى موضعها لأجل الآخرين؛ فالافتداء هنا ليس تجاهلاً للحكم بل تحملاً له.",
        "applied": "عندما تثقل عليك تبعات فشلك، تذكّر أن النص يوجّه النظر إلى افتداء المسيح من اللعنة، لا إلى محاولة تبرير النفس بالأعمال."
      }
    },
