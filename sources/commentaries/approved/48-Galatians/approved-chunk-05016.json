      "explanation_lines": {
        "academic": "يقابل بولس انتظار المؤمنين بالروح لرجاء البر بالإصرار على التبرير بأعمال الشريعة.",
        "theological": "رجاء البر هو السعادة الآتية، ويُنتظر بالإيمان ببر المسيح لا بما ينجزه الإنسان ليستحقها.",
        "deep": "الانتظار المسيحي ليس سلبية؛ إنه توجّه ثابت يصنعه الروح، ويربط الرجاء بالإيمان لا بالاستحقاق الذاتي.",
        "applied": "درّب قلبك على الصبر الواثق: صلِّ واطلب معونة الروح عندما يغريك القلق بأن تجعل الأداء أساس رجائك."
      }
