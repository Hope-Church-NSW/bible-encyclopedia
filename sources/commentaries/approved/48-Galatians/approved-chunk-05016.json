      "explanation_lines": {
        "academic": "يصف بولس نتيجة طلب التبرير بالشريعة بأربع عبارات مترابطة: الانفصال عن المسيح، والسقوط من النعمة.",
        "theological": "من يبني رجاءه على أعمال الشريعة يتخلى عمليًا عن طريق التبرير الذي أقامه الله، فلا ينتفع بالمسيح.",
        "deep": "النعمة لا تمتزج بأساس منافس للقبول؛ نقل الثقة إلى الأعمال يبدل موضع الرجاء نفسه.",
        "applied": "عندما تفشل، لا تعالج خوفك بمضاعفة محاولات إثبات الذات؛ ارجع إلى الثقة التي لا تقوم على استحقاقك."
      }
    },
