    "119:162": {
      "reference": "19-Psalms 119:162",
      "text": "أَبْتَهِجُ أَنَا بِكَلاَمِكَ كَمَنْ وَجَدَ غَنِيمَةً وَافِرَةً.",
      "summary": "",
