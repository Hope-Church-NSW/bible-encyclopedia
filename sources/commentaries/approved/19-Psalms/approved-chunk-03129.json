        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشبّه العدد هذا الخير بالدهن الطيب على الرأس، ثم يرسم نزوله على لحية هارون وطرف ثيابه.",
        "theological": "تقدّم صورة الدهن النازل خير الأخوّة كعطية طيبة تمتد من الرأس إلى أطراف الثياب.",
        "deep": "حركة النزول في الصورة تؤكد وفرة الدهن؛ فالخير الموصوف لا يبقى محصورًا في موضع واحد.",
        "applied": "يدعونا التشبيه إلى طلب خير مشترك يفيض أثره في الجماعة، لا إلى منفعة تقف عند فرد واحد."
      }
    },
    "133:3": {
      "reference": "19-Psalms 133:3",
      "text": "مِثْلُ نَدَى حَرْمُونَ النَّازِلِ عَلَى جَبَلِ صِهْيَوْنَ. لأَنَّهُ هُنَاكَ أَمَرَ الرَّبُّ بِالْبَرَكَةِ، حَيَاةٍ إِلَى الأَبَدِ.",
