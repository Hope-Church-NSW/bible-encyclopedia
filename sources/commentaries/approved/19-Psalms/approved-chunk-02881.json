      "explanation_lines": {
        "academic": "يقابل العدد بين الحق في الباطن والسريرة التي تُعرَّف فيها الحكمة، فيربط المعرفة المطلوبة بموضع خفي داخل الإنسان.",
        "theological": "يفيد النص أن الله يسر بالحق الباطني، وأن الحكمة التي يحتاجها المصلي تُعرَّف له في السريرة لا في المظهر وحده.",
        "deep": "يكشف العدد أن إصلاح السلوك لا ينفصل عن صدق الداخل؛ فالموضع المستور هو ميدان الحق والحكمة معًا.",
        "applied": "افحص دوافعك قبل أفعالك، واطلب حكمة تصحح سريرتك؛ درّب نفسك على الصدق حين لا يراك أحد، ليوافق الظاهر ما في الداخل."
      }
    },
