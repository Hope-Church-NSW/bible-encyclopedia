      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح داود المزمور بإعلان شخصي: الرب هو راعيه، ثم يربط هذه الرعاية بيقين عدم العوز.",
        "theological": "تصوّر الآية الرب راعياً يعتني بمن ينتمي إليه؛ فالرعاية الإلهية هي أساس الثقة بأن الحاجة لن تكون غالبة.",
        "deep": "لا يقوم الاطمئنان هنا على وفرة الظروف، بل على هوية الراعي؛ فعبارة «راعيَّ» تجعل العناية علاقة حاضرة وشخصية.",
        "applied": "عند الشعور بالنقص، تذكّر أن الآية تدعوك إلى النظر أولاً إلى الراعي لا إلى ما تفتقده، والثبات في الثقة بعنايته."
      }
    },
