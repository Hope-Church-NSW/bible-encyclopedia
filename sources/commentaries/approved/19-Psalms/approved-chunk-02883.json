      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينتقل النص من طلب النجاة إلى التماس أن يفتح الرب الشفتين، فتغدو الاستجابة اللفظية إخبارا بتسبيح الله.",
        "theological": "يصور الطلب أن التسبيح لا يصدر من وفرة الكلام وحدها، بل من عون إلهي يعيد للقلب اتساعه والثقة في الحضور أمام الله.",
        "deep": "كان الذنب قد أسكت الفم بالخجل والخوف؛ لذلك لا يطلب المصلي موضوعا جديدا للتسبيح، بل قلبا موترًا من جديد ليقدر أن يسبح.",
        "applied": "عندما يعوق الشعور بالذنب الصلاة أو التسبيح، يبدأ الطريق بطلب صريح أن يفتح الله الشفتين والقلب، لا بتصنع كلمات مطمئنة."
      }
    },
