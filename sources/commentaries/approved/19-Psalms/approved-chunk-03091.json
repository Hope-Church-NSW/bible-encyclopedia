      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "في هذا القول يعلن داود أن الرب محله وقيمته، ويعتمد على حفظ كلامه لا على ما يملكه من حظوظ.",
        "theological": "يظهر النص أن الله هو نصيب المؤمن، فحفظ الوحي يكون استجابة لربٍّ هو مصدر الرجاء والمرجع.",
        "deep": "تسكن النفس حين تُعطى الرب مكانة النصيب، فتتسع البهجة للعبودية الطوعية في حفظ كلامه.",
        "applied": "دعني أختار الرب نصيبا فاعمل بكتابته، لا كمن يطلب غنى أو راحة فوق ما يرضي خالقَه."
      }
    },
    "119:58": {
      "reference": "19-Psalms 119:58",
      "text": "تَرَضَّيْتُ وَجْهَكَ بِكُلِّ قَلْبِي. ارْحَمْنِي حَسَبَ قَوْلِكَ.",
