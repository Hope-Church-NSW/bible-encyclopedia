            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجمع العدد بين أمرٍ بالكفّ وأمرٍ بالمعرفة، ثم يكرر وعدًا بارتفاع الله بين الأمم وفي الأرض لتأكيد شمول مجده.",
        "theological": "يدعو الأمر أعداء الله إلى التوقف عن التهديد، ويدعو شعبه إلى السكون؛ فالرب وحده يحفظ كرامته ويتمم مقاصده.",
        "deep": "السكون هنا ليس استسلامًا لليأس، بل هدوء من يعرف أن علوّ الله ثابت حتى عندما يكون شعبه مضغوطًا أو متألمًا.",
        "applied": "أوقف الاضطراب الداخلي، واعرف أن الله هو الرب؛ اترك له حفظ اسمه وتدبير شأنه، ولا تقِس رضاه بنجاح اسمك أو مكانتك."
      }
    },
    "46:11": {
      "reference": "19-Psalms 46:11",
      "text": "رَبُّ الْجُنُودِ مَعَنَا. مَلْجَأُنَا إِلهُ يَعْقُوبَ. سِلاَهْ.",
      "summary": "",
      "sources": [
