            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح العدد بدعوة جماعية إلى النظر في أعمال الرب، ويركّز على خرابٍ أحدثه في الأرض بوصفه أثرًا منظورًا لعمله.",
        "theological": "يقدّم الخراب المذكور علامة على قضاء الله؛ فالدمار الذي أراده أعداء جماعته انقلب عليهم، وأظهر سلطان الرب في تدبيره.",
        "deep": "النظر في آثار الخراب ليس فضولًا تاريخيًا، بل وقوف أمام أفعال الله التي تكشف عظمته وتدعو القلب إلى الهيبة والثقة.",
        "applied": "تأمّل بجدية في أعمال الله الظاهرة، وتعلّم أن تقابل أحكامه بخشوع، وأن تثق به بدل الخوف من القوى التي تعارض جماعته."
      }
    },
    "46:9": {
      "reference": "19-Psalms 46:9",
      "text": "مُسَكِّنُ الْحُرُوبِ إِلَى أَقْصَى الأَرْضِ. يَكْسِرُ الْقَوْسَ وَيَقْطَعُ الرُّمْحَ. الْمَرْكَبَاتُ يُحْرِقُهَا بِالنَّارِ.",
