      "explanation_lines": {
        "academic": "يُعَلَّم النص أن الأشرار ليسوا كالمتدينين، بل كالعُصافة التي تذروها الريح في كل جهة.",
        "theological": "الاختلاف بين الطريقين ظاهر في الثبات: فحياة الشر خفيفة متقلبة، لا قاعدة لها ولا قيمة عند الله.",
        "deep": "العُصافة رمز للقلة والاضطراب، إذ لا يملك الشر حياة جوهرية بل ينجرف مع كل نزوة.",
        "applied": "يُحذَّر الإنسان من السكون في الخفة، فيحتاج إلى تمييز ثابت ليبقى بعيداً عن الاضطراب والضياع."
      }
    },
