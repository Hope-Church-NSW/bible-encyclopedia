      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُقارن الرجل المتدبر بالأغصان المتصلة بمجاري المياه، فثمره يأتي في وقته ولا يذبل ورقه.",
        "theological": "البركات هنا مرتبطة بالاستقرار في الناموس، فالحياة الروحية تنبت عملاً ناضجاً نتيجة قرب من مصدر الماء.",
        "deep": "الاستمرار وعدم الذبول يعني أن التعلق بالوحي يمدّ الإنسان بقوة تحمل وتوازن لا ينهار في أوقات الشدة.",
        "applied": "من يثبت في التعلّم اليومي يجد نضجاً في كلمته وعمله، ويصير قادراً على الإثمار حين تحين الفُرصة."
      }
    },
