      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد النص سرّ السعادة في مسرة الإنسان بناموس الرب، مع التأمل المستمر فيه نهاراً وليلاً.",
        "theological": "الفرح في الشريعة لا يقتصر على الطاعة الظاهرة بل على محبة ما يقدّمه الرب من تعليم وهدى.",
        "deep": "التأمل يثبت العلاقة بين القلب والناموس، فيصبح الفكر اليومي مجرى للتدبير والانضباط الروحي.",
        "applied": "يستفيد المرء من وقت الصباح والليل في قراءة الوحي وتدبره، لينمو قلبه في التمييز والطاعة."
      }
    },
    "1:3": {
      "reference": "19-Psalms 1:3",
      "text": "فَيَكُونُ كَشَجَرَةٍ مَغْرُوسَةٍ عِنْدَ مَجَارِي الْمِيَاهِ، الَّتِي تُعْطِي ثَمَرَهَا فِي أَوَانِهِ، وَوَرَقُهَا لاَ يَذْبُلُ. وَكُلُّ مَا يَصْنَعُهُ يَنْجَحُ.",
