      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينقل النص سبب التسبيح من موضعه إلى أعمال الله الجبارة وعظمة كيانه، فيجمع بين أفعاله ومجده.",
        "theological": "تستند حمد الله إلى قوته العاملة وعظمته الفائقة؛ فهو أعظم من أن تستوعب حمدنا أو تحيط به تعبيراتنا.",
        "deep": "لا يستطيع التسبيح أن يساوي عظمة الله، لكنه يطلب من العقل والقلب أن يبلغا أقصى ما يمكنهما من التقدير والتعبير.",
        "applied": "اذكر أعمال الله الجبارة بوعي، وارفع مستوى حمدك بدلاً من التقليل من عظمته، مع الاعتراف بأن كلماتك لا تفيه حقه."
      }
    },
