        "academic": "يوسع العدد مشهد التسبيح بذكر الدف والرقص وآلات الأوتار والمزمار، مظهراً تعدد طرائق التعبير.",
        "theological": "يدعو النص إلى بذل الجهد في خدمة الله، مع بقاء التسبيح الحقيقي مرتبطاً بعواطف التقوى الموجهة نحوه.",
        "deep": "يمكن أن تتنوع الأصوات والحركات والآلات، لكن انسجامها يظل مطلوباً حتى يعين بعضها بعضاً ولا يعوق التسبيح.",
        "applied": "قدّم لله حماساً وفرحاً منضبطين، ودع مشاركتك في العبادة تعكس محبة صادقة وتعاوناً يحفظ انسجام الجماعة."
      }
    },
