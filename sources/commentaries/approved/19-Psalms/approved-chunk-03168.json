      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح المزمور بدعوة متكررة إلى التسبيح، محدداً موضعه في القدس وفي الفلك الذي تظهر فيه قدرة الله ومجده.",
        "theological": "يستحق الله التسبيح لأن مجده يتجلى في قدسه، ولأن قدرته الظاهرة في الفلك تدعو الخليقة إلى تمجيده.",
        "deep": "يربط النص بين العبادة ومشاهدة مجد الله؛ فالتسبيح لا ينبع من الفراغ، بل من إدراك حضوره وقدرته.",
        "applied": "اجعل تسبيحك حاضراً حيث تعلن نعمة الله، وتأمل قدرته في الخليقة، ولا تدع برودة القلب تمنعك من هذه العبادة."
      }
    },
