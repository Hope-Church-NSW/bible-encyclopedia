      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يخاطب البيت بابِل بوصفه مُخرَّبة، ويعلن أن الجزاء المنتظر يطابق ما صنعته بالشعب.",
        "theological": "يربط التفسير فرح الجزاء بغيرة مقدسة لمجد الله وكرامة ملكوته، لا بروح انتقام شخصي.",
        "deep": "تظهر العبارة يقين سقوط المُخرِّبة: فالذين دمّروا غيرهم يُدمَّرون بدورهم وفق عدل الله.",
        "applied": "يدعو النص المتألم إلى ترك طلب الثأر للنفس والاتكال على عدل الله تجاه من يفرحون بالكارثة."
      }
    },
