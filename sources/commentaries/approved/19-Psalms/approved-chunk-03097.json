      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يؤكد العدد عدم الانحراف عن أحكام الله، ثم يفسر الثبات بأن الله نفسه هو الذي علّم المرنم.",
        "theological": "ثبات المرنم لا يقدمه إنجازا ذاتيا، بل استجابة لتعليم إلهي منحه فهما لقبول الأحكام والالتزام بها.",
        "deep": "التعليم الذي يأتي من الله لا يضيف معلومات فحسب؛ إنه يرسخ الاقتناع بأن الكلمة هي القاعدة التي لا تستبدل.",
        "applied": "اطلب فهما يجعلك ثابتا، لا معرفة عابرة؛ وعند ضغط التجربة تذكر أن الكلمة التي تعلمتها هي مرشدك العملي."
      }
    },
    "119:103": {
      "reference": "19-Psalms 119:103",
      "text": "مَا أَحْلَى قَوْلَكَ لِحَنَكِي! أَحْلَى مِنَ الْعَسَلِ لِفَمِي.",
      "summary": "",
