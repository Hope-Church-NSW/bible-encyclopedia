      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستبدل العدد وصف الفرار بصورة جسدية مكثفة: رعْدة ومخاض كالوالدة، ليصوّر خوفاً طاغياً لا مجرد قلق عابر.",
        "theological": "الخوف الذي أصابهم يُقدَّم بوصفه واقعاً لا يستطيعون دفعه؛ فتتحول جماعتهم القوية إلى جماعة تتألم وترتجف.",
        "deep": "تشبيه المخاض يجعل الرعدة أمراً شاملاً ومؤلماً، ويكشف أن الهيبة قد تبلغ الإنسان في أعماق إحساسه.",
        "applied": "عند اشتداد الخوف لا تنكر ثقله، لكن لا تمنحه سلطة تعريف الواقع كله؛ تذكر أن القوة الظاهرة قد ترتعد."
      }
    },
