    "48:1": {
      "reference": "19-Psalms 48:1",
      "text": "عَظِيمٌ هُوَ الرَّبُّ وَحَمِيدٌ جِدًّا فِي مَدِينَةِ إِلهِنَا، جَبَلِ قُدْسِهِ.",
