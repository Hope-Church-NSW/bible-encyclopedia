      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقر العبد بأن الرب بارٌّ، وأن أحكامه مستقيمة لا تحيد عن العدل.",
        "theological": "البرّ الإلهي هو أصل كل حكمه، فلا يتغير بتأثير الناس أو الأحوال.",
        "deep": "عند البلاء يطمئن القلب بأن الخالق يقيم العدل في حكمه وثباته.",
        "applied": "في الشك يثبت المؤمن أن الرب عادل، فيتسع له الصبر والطاعة."
      }
    },
