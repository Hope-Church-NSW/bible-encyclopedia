      "explanation_lines": {
        "academic": "الشهادات التي أمر بها الرب عادلة، وحقّها ثابت لا يخفف من صلابته الزمن.",
        "theological": "الحقّ في الوصية لا يَحْمِلُ ظلامًا، لأنه صادر عن عدل الله وصدقه.",
        "deep": "العبد يلتفت إلى أن الأمر الإلهي لا يفتعله الضغوط، بل يرتكز على الحق.",
        "applied": "يستقر الالتزام عندما يعرف الإنسان أن ما يطيع هو حقٌّ من الله لا قيدٌ عابر."
      }
    },
