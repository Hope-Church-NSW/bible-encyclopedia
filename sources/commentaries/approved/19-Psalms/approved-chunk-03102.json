      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "طلب العبد من الله أن يخلصه من ظلم الناس، حتى يتمكن من حفظ وصاياه في سلام.",
        "theological": "في هذا النص يظهر أن الطاعة لا تُؤخذ من قوة النفس وحدها، بل من حماية الرب.",
        "deep": "القلب يتألم عندما يضغط عليه ظلم البشر، فيرفع حاجته إلى الله ليستقر داخله.",
        "applied": "عند الاضطهاد أو التهديد، يطلب المؤمن عون الله أولاً ثم يواصل حفظ الوصية."
      }
    },
    "119:135": {
      "reference": "19-Psalms 119:135",
      "text": "أَضِئْ بِوَجْهِكَ عَلَى عَبْدِكَ، وَعَلِّمْنِي فَرَائِضَكَ.",
