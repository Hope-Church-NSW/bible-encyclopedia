        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "إعلان سيادة الله الأبدية على العالم، مع برهان تاريخي على قدرته بإزالة الأمم الوثنية.",
        "theological": "ملك الله الأبدي يضمن تحقيق العدالة الكاملة، لأن من يملك يملك أيضًا حق الحكم والقضاء.",
        "deep": "اختفاء الأمم من الأرض شهادة حية على أن قوة الله تحقق وعوده ضد أعدائه دون تأخير أبدي.",
        "applied": "يستطيع المؤمن أن ينام مطمئنًا مع ذكر ملك الله الأبدي، لأن العدالة مضمونة على مدى الزمن."
      }
    },
    "10:17": {
      "reference": "19-Psalms 10:17",
      "text": "تَأَوُّهَ الْوُدَعَاءِ قَدْ سَمِعْتَ يَا رَبُّ. تُثَبِّتُ قُلُوبَهُمْ. تُمِيلُ أُذُنَكَ",
