      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تأكيد على أن قضاء الله ينصب على حماية الفئات الأضعف من المجتمع، خاصة اليتامى والمُنسحقين.",
        "theological": "الإنسان الأرضي محدود القدرة والعمر، والله يرفع قيمة الضعيف بحمايته من رعب ذاك الإنسان.",
        "deep": "إزالة الخوف من قلب المظلوم أعظم من إزالة الظالم؛ فالحرية الحقة تبدأ بغياب الرعب الداخلي.",
        "applied": "ادعُ الله أن لا يسمح لأي إنسان بإرهابك أو السيطرة على روحك بالخوف، فأنت تحت حماية عادل."
      }
    }
