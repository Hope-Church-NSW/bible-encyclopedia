    "119:1": {
      "reference": "19-Psalms 119:1",
      "text": "طُوبَى لِلْكَامِلِينَ طَرِيقًا، السَّالِكِينَ فِي شَرِيعَةِ الرَّبِّ.",
      "summary": "",
