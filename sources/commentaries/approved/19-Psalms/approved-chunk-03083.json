        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تثبيت الطرق في حفظ الفرائض يعني الدعاء لله ليهيئ قلب الإنسان وإرادته للالتزام المستمر بأحكام الله وفرائضه.",
        "theological": "رغبة المؤمن في أن يوجه الله طرقه تعكس فهمه العميق بأنه لا يستطيع الاستقامة بقوته الذاتية بل يحتاج إلى معونة إلهية.",
        "deep": "الدعاء بتثبيت الطرق لا يعني الأحداث الخارجية فحسب بل الحاجة الأعمق إلى تحويل الله للقلب والروح ليسيرا على الصراط.",
        "applied": "المؤمن الحكيم يطلب من الله ليس تغيير ظروفه فقط بل تحويل إرادته وقلبه ليصبح طاعة الله رغبة ذاتية طبيعية."
      }
    },
