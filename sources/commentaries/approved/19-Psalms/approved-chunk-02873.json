      "explanation_lines": {
        "academic": "يدعو البيت جبل صهيون وبنات يهوذا إلى الفرح بسبب أحكام الله، أي أعمال عنايته في الواقع.",
        "theological": "أحكام الله هنا ليست سبب رهبة فقط، بل مصدر بهجة لأن حكمته تعمل لخير شعبه.",
        "deep": "يفتح الحمد لله باب الفرح بخلاصه؛ فاستجابة الجماعة تبدأ بإسناد المجد إليه ثم الابتهاج بعمله.",
        "applied": "حين ترى نجاة أو عونًا عامًا، شارك الآخرين فرحًا شاكرًا بدل أن تقصر الاهتمام على منفعتك الخاصة."
      }
    },
