  "verses": {
    "107:22": {
      "reference": "19-Psalms 107:22",
      "text": "وَلْيَذْبَحُوا لَهُ ذَبَائِحَ الْحَمْدِ، وَلْيَعُدُّوا أَعْمَالَهُ بِتَرَنُّمٍ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc3/OEBPS/mhc3.Ps.cviii.html#Bible_Ps.107.17-Ps.107.22"
          ],
          "ranges": [
            "19-Psalms 107:17-22"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يختم هذا المقطع عن الشفاء بالدعوة إلى تقديم ذبائح الشكر وإعلان أعمال الله بترنيم، فالشكر هنا استجابة علنية لنعمة الاسترداد.",
        "theological": "لا يقتصر الامتنان على شعور داخلي، بل يتحول إلى عبادة تعترف بأعمال الله وترد له ما يليق بخيره ورحمته.",
        "deep": "الإنسان الذي نال حياة جديدة مدعو إلى أن يجعل حياته شهادة فرحة؛ فذكر أعمال الله يشجع الآخرين على الثقة به.",
        "applied": "بعد النجاة أو الشفاء، عبّر عن شكرك بكلمات واضحة وترنيم صادق، واجعل اختبارك سبباً لتشجيع من يمرون بضيق."
      }
    },
    "107:23": {
      "reference": "19-Psalms 107:23",
      "text": "اَلنَّازِلُونَ إِلَى الْبَحْرِ فِي السُّفُنِ، الْعَامِلُونَ عَمَلاً فِي الْمِيَاهِ الْكَثِيرَةِ،",
      "summary": "",
      "sources": [
