      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد حركة السفن الصاعدة إلى السماء والهابطة إلى الأعماق، ثم يذكر ذوبان نفوس البحارة بسبب شدة الكرب.",
        "theological": "يكشف المشهد هشاشة الإنسان أمام العاصفة؛ فالخبرة البحرية لا تلغي الخوف عندما تتجاوز الأحداث قدرة التدبير البشري.",
        "deep": "التأرجح بين العلو والسقوط يهز شعور الإنسان بالأمان، فيظهر أن النفس قد تنكسر عندما لا تجد موطئاً ثابتاً وسط الخطر.",
        "applied": "إذا اضطربت حياتك بين صعود وهبوط، سمِّ خوفك بصدق ولا تتظاهر بالقوة؛ اعترف بكربك واطلب عون الله في لحظتك العصيبة."
      }
    },
