      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تسجل الآية انتقال النسب من إبراهيم إلى إسحاق ثم يعقوب، وتذكر يهوذا وإخوته، لا يهوذا وحده، ضمن سلسلة الآباء.",
        "theological": "ذكر إخوة يعقوب ينسجم مع كون أبناء يعقوب جميعًا داخلين في جماعة الآباء، وإن كان يهوذا هو المسار المذكور هنا في النسب.",
        "deep": "لا تختزل العائلة في الشخص الذي يواصل السلسلة وحده؛ فذكر الإخوة يوسّع الذاكرة ويمنح الجماعة مكانًا في القصة.",
        "applied": "احفظ قيمة من يقفون حولك، لا قيمة الدور البارز فقط؛ فالله يرى الجماعة والعلاقات، وليس الإنجاز الفردي وحده."
      }
    },
