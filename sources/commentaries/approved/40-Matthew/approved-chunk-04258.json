        {
          "id": "character:jesus:1",
          "relation": "character",
          "scope": "verse_or_passage",
          "title": "يسوع المسيح: النسب",
          "source_file": "study-biblical-characters.html",
          "references": [
            {
              "relation": "character",
              "text": "متى 1:1-17؛ لوقا 3:23-38؛ يوحنا 1:1-18"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يغيّر النص صياغة النسب عند يعقوب، فيذكر يوسف زوج مريم، ثم يقول إن يسوع وُلد منها، فيبرز خصوصية العبارة الأخيرة.",
        "theological": "يركّز العدد على يسوع بوصفه المسيح، ويضعه في مركز السلسلة كلها، بينما يذكر يوسف باعتباره زوج مريم لا والد يسوع في العبارة.",
        "deep": "انتقال السجل من لغة الولادة المتكررة إلى قولِه إن يسوع وُلد من مريم يلفت النظر إلى أن حضوره ليس مجرد حلقة بشرية عادية.",
        "applied": "اجعل اهتمامك مركزًا على يسوع نفسه، ولا تسمح للتفاصيل المحيطة به أن تحجب الشخص الذي يقدمه النص باعتباره المسيح."
      }
    },
    "1:17": {
      "reference": "40-Matthew 1:17",
      "text": "فَجَمِيعُ الأَجْيَالِ مِنْ إِبْراهِيمَ إِلَى دَاوُدَ أَرْبَعَةَ عَشَرَ جِيلاً، وَمِنْ دَاوُدَ إِلَى سَبْيِ بَابِلَ أَرْبَعَةَ عَشَرَ جِيلاً، وَمِنْ سَبْيِ بَابِلَ إِلَى الْمَسِيحِ أَرْبَعَةَ عَشَرَ جِيلاً.",
      "summary": "",
      "sources": [
        {
