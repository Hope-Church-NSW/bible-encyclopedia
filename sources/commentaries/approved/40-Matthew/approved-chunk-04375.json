      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُظهر هذا القول أن التمييز بين ما يُقدَّس وما يُقدَّس به ليس قاعدة فكرية بل نقداً لأسلوب التقديس الظاهري في الشريعة.",
        "theological": "فالمذبح لا يقدِّس ما يضعف الإخلاص، بل يثبت أن المكان المقدس لا يبرّر اضطراب القصد أو التزييف في العبادة.",
        "deep": "الخطأ هنا هو أن يقدَّم الشكل المقدس على المعنى الحقيقي، فتتبدل القيمة من الإيمان إلى التمويه الخارجي.",
        "applied": "يُؤذَن للناس أن يراجعوا ما يقدِّمونه كعبادة، فلا يكتفيوا بالمساحات الدينية إذا كان الداخل مشغولاً بالتزيف."
      }
    },
