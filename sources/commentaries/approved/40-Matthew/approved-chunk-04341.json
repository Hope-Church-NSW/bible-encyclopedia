      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبني يسوع صورة الكنيسة كبناء، ويعرض نفسه بصفته البنّاء، مع أساس صخري ثابت؛ كما يوجّه الوعد إلى بطرس بوصفه وكيلاً.",
        "theological": "الكنيسة هي كنيسة المسيح وهو الذي يبنيها، وقاعدتها صلبة، لذلك لا تستطيع قوى الجحيم أن تنتصر عليها أو تقوّضها.",
        "deep": "ثبات الكنيسة لا يقوم على تقلب الآراء أو قوة البشر، بل على أساس راسخ وعلى عمل المسيح البنّاء؛ وهذا يرفض اختزال الوعد في مجد شخصي.",
        "applied": "اثبت في الإيمان الراسخ، واطلب أن تكون جزءاً من بناء المسيح لا سبباً في تضييق أساس الكنيسة أو تحويل الخدمة إلى تسلط."
      }
    },
