      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينتقل السرد من ذهاب المرأتين إلى دخول بعض الحراس المدينة وإبلاغ رؤساء الكهنة بكل ما جرى.",
        "theological": "شهادة الحراس تأتي من جهة معارضة للخبر، ولذلك يبرز النص أن ما وصلهم لا يمكن تجاهله داخل القصة.",
        "deep": "المشهد يضع استجابتين للحدث نفسه جنباً إلى جنب: رسالة فرح للتلاميذ وتقرير محرج للخصوم.",
        "applied": "لا يكفي وصول الوقائع إلى الإنسان؛ فالاختبار الحقيقي يظهر في الطريقة التي يستجيب بها لما عرفه."
      }
    },
