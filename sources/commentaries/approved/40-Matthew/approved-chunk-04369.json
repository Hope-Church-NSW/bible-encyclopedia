            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تتوالى القصة في سبعة إخوة، فكل واحد تزوّج المرأة ثم مات بلا نسل، وتركها للأخ التالي حسب ما أمرت التوراة.",
        "theological": "هذا التتابع يقدّم صورةً من الفناء تُثبت أن الموت يمرّ على الأنساب، فلا يصح أن تُبنى فكرة القيامة على الروابط العائلية وحدها.",
        "deep": "الرواية تُظهر أن الأسرة لا تستقر في الموت، وأن المبالغة في تضخيم الترتيب العائلي لا تُغني عن رؤية ما لا ينتهي في الله.",
        "applied": "يكشف هذا أن الأمان في التاريخ العائلي ليس هو الأساس؛ فالإنسان يطمئن إلى وعد الله لا إلى استمرار العائلة في هذا العالم."
      }
    },
