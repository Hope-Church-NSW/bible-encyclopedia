      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:sad-sadducees",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "صدوقيون",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "متى 22:23-33؛ أعمال 23:6-10"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "جاء صدوقيون ينكرون القيامة، وسألوه عن امرأة كانت لها سبعة أزواج متتابعين، ليوهموا أن هذا التراكم يمنع وجود حياةٍ بعد الموت.",
        "theological": "يُظهر هذا السؤال أن منكر القيامة يحسب أن الحياة الآخرة ستتكرر على مثال هذا العالم، فيختلق شبهةً من الصور الأرضية.",
        "deep": "ما يضرّهم ليس مجرد سؤالٍ لفظي، بل تصورٌ أرضيّ يحسب أن الروحانية تُحاكم بمقاييس الزواج والنسل والزمان.",
        "applied": "يلزم المؤمن أن لا يحدّد آماله الأخروية بمقاييس الحياة الفانية، لأن الرب يفتح ما لا تطيق أذهان الأحياء أن تُحْدِدَها."
      }
    },
    "22:24": {
      "reference": "40-Matthew 22:24",
      "text": "قَائِلِينَ: «يَا مُعَلِّمُ، قَالَ مُوسَى: إِنْ مَاتَ أَحَدٌ وَلَيْسَ لَهُ أَوْلاَدٌ، يَتَزَوَّجْ أَخُوهُ بِامْرَأَتِهِ وَيُقِمْ نَسْلاً لأَخِيهِ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Matt.xxiii.html#Bible_Matt.22.23-Matt.22.33"
          ],
          "ranges": [
            "40-Matthew 22:23-33"
          ]
        }
