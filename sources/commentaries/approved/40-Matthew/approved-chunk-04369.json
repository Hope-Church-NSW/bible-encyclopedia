      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:sad-sadducees",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "صدوقيون",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "متى 22:23-33؛ أعمال 23:6-10"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "استندوا إلى قانون موسى الذي يأمر الأخ بأن يتزوج الأرملة ويرفع نسل أخيه الميّت، وحوّلوا هذا الحكم إلى قضيةٍ في القيامة.",
        "theological": "لكن هذا التشريع يثبت نظاماً أرضياً يقيّم الأسرة والوراثة، لا يثبت طريقة الحياة التي لا تكون فيها الزوجية كما كانت في هذا العالم.",
        "deep": "السؤال في ذاته يبيّن أن ما يَسْتَبِين في الدنيا لا يُستدلّ به على ما بعد الموت إلا إذا كان المرء قد ثبّت قوانين الجسد على الروح.",
        "applied": "يعلم هذا أن نميّز بين نظام الحياة الحالية الذي يضمّل الأسرة والوصية، وبين وعد الله الذي لا يحدّه ترتيب هذا العالم."
      }
    },
    "22:25": {
      "reference": "40-Matthew 22:25",
      "text": "فَكَانَ عِنْدَنَا سَبْعَةُ إِخْوَةٍ، وَتَزَوَّجَ الأَوَّلُ وَمَاتَ. وَإِذْ لَمْ يَكُنْ لَهُ نَسْلٌ تَرَكَ امْرَأَتَهُ لأَخِيهِ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
