    "22:23": {
      "reference": "40-Matthew 22:23",
      "text": "فِي ذلِكَ الْيَوْمِ جَاءَ إِلَيْهِ صَدُّوقِيُّونَ، الَّذِينَ يَقُولُونَ لَيْسَ قِيَامَةٌ، فَسَأَلُوهُ",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Matt.xxiii.html#Bible_Matt.22.23-Matt.22.33"
          ],
