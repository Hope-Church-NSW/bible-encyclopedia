      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعلن العدد الطوبى للمساكين بالروح ويربط حالتهم بوعد حاضر: لهم ملكوت السماوات، لا بمقياس الثراء الظاهر.",
        "theological": "يفسر المصدر المسكنة بالروح كتواضع وإفراغ للنفس من الثقة بذاتها، مع الاعتراف بالحاجة الدائمة إلى نعمة الله.",
        "deep": "تأتي هذه الطوبى أولًا لأن التواضع يضع أساس الفضائل الأخرى؛ فمن يبدأ منخفضًا لا يبني حياته على تعظيم الذات.",
        "applied": "مارس المسكنة بالروح بأن تراجع إنجازاتك بلا كبرياء، وتعترف بحاجتك إلى المعونة بدل الاتكال على قوتك."
      }
    },
