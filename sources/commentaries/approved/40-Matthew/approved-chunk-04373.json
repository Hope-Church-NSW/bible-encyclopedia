      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُشخّص الفريسيون هنا في فرضهم أحمالًا ثقيلة على الناس، من خلال التقاليد المضافة إلى الشريعة، مع رفضهم أن يرفعوها بأصابعهم.",
        "theological": "الآية تبيّن أن تسلّط القوانين البشرية لا يبرر مخالفة روح الشريعة، لأن الطاعة لله لا تتحقق بتعذيب الناس تحت ما لا يليق به.",
        "deep": "الوقوع في التزام ظاهر لا يُثبت قداسة القلب؛ فالعبودية للتمييزات الخارجية لا تعكس معرفة الله بل استعباداً للرموز.",
        "applied": "نحذر من تعقيد الحياة الروحية بمتطلبات لا يخففها القائد، ونتعلّم أن نخفف الأحمال حين تكون الخدمة علمًا بالتواضع لا استعبادًا."
      }
    },
