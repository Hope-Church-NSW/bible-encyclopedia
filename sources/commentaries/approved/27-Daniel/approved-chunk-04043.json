      "explanation_lines": {
        "academic": "يؤكد السرد تتابع الحدث بعبارة: بينما الكلمة في فم الملك، إذ يأتي صوت من السماء يعلن أن المملكة قد فارقته.",
        "theological": "يظهر الحكم أن سلطة الله فوق الحصون التي ظن الملك أنها تحفظ ملكه؛ ففي اللحظة التي تعاظم فيها صدر الإعلان الإلهي بعزله.",
        "deep": "يقابل النص بين الكلمة المتعالية الصاعدة من فم الملك والكلمة القادرة النازلة من السماء، فينكشف الفرق بين ادعاء السيادة والسيادة الفعلية.",
        "applied": "احذر أن تثبتك لحظة المديح أو السيطرة في حكم متكبر؛ فالقدرة التي تملكها ليست ضمانا دائما، وتحتاج إلى استعمال متواضع ومسؤول."
      }
    },
