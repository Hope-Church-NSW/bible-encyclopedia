      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يطلب دانيال مقارنة مناظره بمن يأكلون من أطعمة الملك، ثم يترك للمسؤول أن يصنع بعبيده كما يرى؛ فالنتيجة معيار القرار.",
        "theological": "يجمع العدد بين الشهادة الظاهرة والاحترام؛ دانيال لا يخفي اختياره، لكنه لا ينتزع الحكم لنفسه بل يترك التقدير للمسؤول.",
        "deep": "الاستعداد لقبول النتيجة يكشف أن القناعة ليست عنادًا؛ فدانيال يقدّم ما يراه صوابًا ويقبل أن يُفحص علنًا.",
        "applied": "اعرض موقفك بوضوح، واسمح للنتائج القابلة للملاحظة أن تتكلم، وكن مستعدًا لسماع التقييم دون دفاع متوتر أو تلاعب."
      }
    },
