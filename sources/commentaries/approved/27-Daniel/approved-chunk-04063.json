      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع دانيال الخزي على جماعة الشعب كلها، فيذكر الملوك والرؤساء والآباء، لأن الخطية لم تكن عثرة فردية بل ذنباً شمل القيادة والأمة.",
        "theological": "يعترف النص بأن الخزي حقٌّ لهم أمام الله، فلا يبررون أنفسهم ولا يلقون اللوم على الظروف، بل يقرون بأن الخطية هي سبب انكسارهم.",
        "deep": "ذكر الملوك والرؤساء والآباء يعلن أن المكانة والسلطة لا تزيلان المسؤولية؛ فالامتياز الأكبر يجعل التعدي على الله أشد خطورة.",
        "applied": "حين نعترف بخطايانا، ينبغي ألا نحمي صورتنا أو نستثني أصحاب النفوذ، بل نقبل بصدق أن الخزي الناتج عن العصيان يستحق اعترافاً متواضعاً."
      }
    },
