      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يواجه دانيال بلشاصر بمعرفته السابقة بما جرى لأبيه، ثم يبيّن أن هذه المعرفة لم تنتج اتضاعاً للقلب.",
        "theological": "تجعل الآية عدم الاتضاع خطيئة أشد لأن الملك عرف ما يكفي ليتعلم من أحكام الله على غيره.",
        "deep": "ليست المشكلة في نقص الدليل، بل في قلب يرى عاقبة الكبرياء ثم يبقى صلباً غير مستفيد من الإنذار.",
        "applied": "حين نعرف نتائج العناد في حياتنا أو في حياة الآخرين، فالمطلوب أن نحول المعرفة إلى توبة وطاعة وصبر."
      }
    },
    "5:23": {
      "reference": "27-Daniel 5:23",
      "text": "بَلْ تَعَظَّمْتَ عَلَى رَبِّ السَّمَاءِ، فَأَحْضَرُوا قُدَّامَكَ آنِيَةَ بَيْتِهِ، وَأَنْتَ وَعُظَمَاؤُكَ وَزَوْجَاتُكَ وَسَرَارِيكَ شَرِبْتُمْ بِهَا الْخَمْرَ، وَسَبَّحْتَ آلِهَةَ الْفِضَّةِ وَالذَّهَبِ وَالنِّحَاسِ وَالْحَدِيدِ وَالْخَشَبِ وَالْحَجَرِ الَّتِي لاَ تُبْصِرُ وَلاَ تَسْمَعُ وَلاَ تَعْرِفُ. أَمَّا اللهُ الَّذِي بِيَدِهِ نَسَمَتُكَ، وَلَهُ كُلُّ طُرُقِكَ فَلَمْ تُمَجِّدْهُ.",
      "summary": "",
