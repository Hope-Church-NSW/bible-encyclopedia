      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفيد النص عجز جميع حكماء الملك عن مهمتين مترابطتين: قراءة الكتابة الماثلة على الجدار وتفسيرها للملك.",
        "theological": "يكشف فشل الحكماء أن المعرفة البشرية لا تملك بذاتها سلطان كشف الرسالة التي أرسلها الله في تلك الساعة.",
        "deep": "لم يكن العجز في لغة مجهولة، بل في حجب الفهم، لكي يُحفَظ لدانيال شرف تفسير العلامة الغامضة.",
        "applied": "عند مواجهة أمر يتجاوز قدرتنا، لا ينبغي أن نحول العجز إلى ادعاء؛ فحدودنا تدعونا إلى طلب الحق بتواضع."
      }
    },
