      "explanation_lines": {
        "academic": "في السنة الأولى لبيلشاصر، رأى دانيال حلمًا ورؤى على فراشه، ثم كتب الرؤيا وأخبر بجملة الأمور.",
        "theological": "هنا يظهر أن الله يفتح معرفةً للعبد في وقت السكون، ويؤكّد أن الوحي ينبغي حفظه وتبليغه.",
        "deep": "الرؤية تبدأ من سرير الإنسان، فتدلّ على أن الله يتكلم حين يهدأ العالم ويغيب الضجيج.",
        "applied": "عند الوقوف أمام مشكلات الحياة، يطلب دانيال أن يكتب ما يراه ويشاركه، فلا يظلّ الوحي سريًا."
      }
    },
