      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجيب الكلدانيون بأن لا إنسان على الأرض يستطيع كشف أمر الملك، وأن ملوكا عظاما لم يطلبوا من أهل الحكمة مثل هذا الطلب.",
        "theological": "اعترافهم يفضح الفرق بين تفسير ما يُعطى لهم وبين استرجاع ما أخفاه النسيان؛ فوسائلهم لا تعمل بلا مادة أمامها.",
        "deep": "تظهر الآية أن المكانة والخبرة لا تلغيان حدود الإنسان، وأن المطالبة بقدرة فوق بشرية ليست معيارا صالحا للحكم على الكفاءة.",
        "applied": "ميّز بين العمل الصعب والعمل المستحيل قبل محاسبة الآخرين؛ فالقيادة العادلة تضبط توقعاتها بحدود الواقع."
      }
    },
