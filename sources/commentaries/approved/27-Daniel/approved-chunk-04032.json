      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف دانيال نبوخذنصر بأنه ملك ملوك، ثم يفسر قوته ومملكته وسلطانه ومجده بوصفها عطايا منحها إله السماوات.",
        "theological": "تؤكد الآية أن عظمة الحاكم لا تنبع من ذاته فقط؛ فالسلطان السياسي عطية علوية، ولذلك يبقى صاحبه مسؤولًا أمام واهبه.",
        "deep": "يجمع النص بين أعلى ألقاب الملك وبين مصدر سلطانه، فيفكك وهم الاكتفاء الذاتي ويضع المجد البشري داخل إطار العطية.",
        "applied": "استخدم أي نفوذ أو نجاح كأمانة لا كملكية مطلقة، وانسب مصدر القدرة إلى الله بدل أن تجعل الإنجاز سببًا للغرور."
      }
    },
