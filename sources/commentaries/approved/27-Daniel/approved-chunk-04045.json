      "explanation_lines": {
        "academic": "أحضروا الأواني الذهبية من هيكل بيت الله في أورشليم، فشرب منها الملك وأمراؤه وزوجاته وسراراه.",
        "theological": "تنفيذ أمر الملك بشرب الخمر في الأواني المقدسة يظهر تجاسرهم المشترك على الله وارتكابهم خطيئة جماعية.",
        "deep": "مشاركة جميع أفراد البلاط في التدنيس تشير إلى أن الكبر والاستهزاء انتشرا في القصر بأكمله وسقطوا معاً في الخطيئة.",
        "applied": "الخطيئة التي يشارك فيها الجميع دون معارضة تشير إلى غياب القيادة الحكيمة والخوف من الله، مما يهيّئ المجتمع للدمار."
      }
    },
