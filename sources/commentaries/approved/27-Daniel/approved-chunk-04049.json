      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد تنفيذ أمر بلشاصر فورًا: أُلبس دانيال الأرجوان، ووُضعت قلادة الذهب في عنقه، وأُعلن متسلطًا ثالثًا في المملكة.",
        "theological": "يُظهر المشهد أن التكريم الملكي لم يغيّر حقيقة الدينونة المعلنة؛ فالمناصب والرموز السلطانية لا تُبطل كلمة الله.",
        "deep": "يرى هنري أن دانيال لم يكن متعلقًا بهذه الألقاب، بل أدرك أنها ستذوي سريعًا مع الملك الذي منحها؛ لذلك لا ينبغي أن يكون الفرح بها مفرطًا.",
        "applied": "قد ينال الإنسان تقديرًا عامًا أو منصبًا رفيعًا، لكن الحكمة أن يقيس قيمته بأمانته لا بسرعة الأوسمة ولا بوعود السلطة الزائلة."
      }
    },
