      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر العدد انتقال الحكم إلى داريوس المادي، ويحدد عمره بنحو اثنتين وستين سنة، فيعرض استيلاء حاكم جديد على المملكة بعد سقوط بلشاصر.",
        "theological": "ينتمي انتقال السلطة في الآية إلى تدبير الله الذي أنهى حكمًا وأقام آخر؛ فالمملكة لا تبقى حكرًا على سلالة أو ملك.",
        "deep": "يشرح هنري أن داريوس أخذ المملكة بالشراكة ومع موافقة كورش، وأن تقدمه في السن، إذ كان ابن اثنتين وستين، فسر تقدمه في الرتبة.",
        "applied": "تذكّر الآية بأن النفوذ قابل للانتقال، وأن العمر والخبرة قد يؤثران في ترتيب المسؤولية، لكن لا يضمنان دوام الحكم أو بقائه."
      }
    }
