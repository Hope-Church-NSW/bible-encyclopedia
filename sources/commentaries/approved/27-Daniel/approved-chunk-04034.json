        "academic": "يربط الأمر لحظة سماع أصوات الآلات الموسيقية بالفعل المطلوب: السجود لتمثال الذهب الذي نصبه نبوخذنصر، في توقيت واحد للجميع.",
        "theological": "يستخدم الطقس الموسيقي لتزيين العبادة الباطلة وتليين المترددين نحو الامتثال؛ لكن جمال الوسيلة لا يجعل موضوع العبادة مستحقاً لها.",
        "deep": "الموسيقى هنا ليست تفصيلاً محايداً في المشهد، بل إشارة تضبط الاستجابة الجماعية وتستميل الحواس، فتجعل الخضوع يبدو احتفالاً.",
        "applied": "ميّز بين التأثر بجمال العرض وبين صحة ما يدعوك إليه. لا تدع الأجواء الجذابة أو اندفاع الحشد تقودك إلى فعل يناقض أمانتك لله."
      }
    },
