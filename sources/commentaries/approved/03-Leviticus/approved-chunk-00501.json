      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن الكاهن في فحصه يعتمد على علامتين محددتين هما عمق المنظر عن الجلد ووجود شعر أشقر دقيق، وبناءً عليهما يحكم بأن الحالة قرع، أي برص في الرأس أو الذقن.",
        "theological": "يبيّن متى هنري أن الحكم بالنجاسة هنا لا يقوم على الظن بل على علامات محددة يقررها الكاهن، مما يعكس دقة الشريعة في صون قداسة الشعب من كل دنس معلن.",
        "deep": "يلاحظ متى هنري أن الأمر يتوقف غالباً على أمر صغير جداً هو لون الشعر، فالشعر الأشقر هنا دليل على البرص، بخلاف الأسود الذي يشير إلى السلامة كما يرد لاحقاً.",
        "applied": "يحث متى هنري القارئ على عدم الاستهانة بالعلامات الصغيرة التي قد تكشف فساداً خفياً، بل على الفحص الدقيق والخضوع لحكم من أقامه الله ليميّز الطاهر من النجس."
      }
    },
