      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُعطى سبت الأرض طعاماً للمالك والخادم والأمة والأجير والضيف المقيم، وللماشية أيضاً.",
        "theological": "يظهر أن الرب يهيئ رزق الجميع من عطائه، فلا يقتصر الخير على من يملك اليد العاملة.",
        "deep": "من يملك أرضاً لا يملكها بسلطة مطلقة، بل يشارك ما يثمره مع من لا يزرع ولا يحصد.",
        "applied": "تُرى العطية المشتركة في وقت الراحة، فيُصغي القادر إلى حاجات من لا حصة لهم في الحصاد."
      }
    },
