      "explanation_lines": {
        "academic": "تُعدّ سبع سنين من السبات، ثم تُحسب سبع مرات فيكون المجموع أربعاً وأربعين سنة حتى تُعلن السنة الخمسين.",
        "theological": "هذه المدة تذكر أن الراحة ليست اضطراباً، بل نظاماً يثبت أن الرب هو المشرّع ومالك الأرض.",
        "deep": "السبت السنوي يعلّم أن العطاء الإلهي يحتاج إلى توقف الإنسان عن الاستحواذ والتوقع التام.",
        "applied": "يُتعلّم الإنسان أن الحصاد لا يكون كل شيء، وأن التوقف عن الاجتهاد الظاهر يفتح باب الاعتماد على بركة الرب."
      }
