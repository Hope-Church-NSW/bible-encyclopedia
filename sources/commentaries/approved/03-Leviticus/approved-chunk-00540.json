      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤَدِّي الكاهِنُ عملَهُ فِي هذا اليَوْمِ بالتَّحديدِ لِتَطهيرِ الشَّعبِ مِنْ جميعِ خطاياهم أمامَ الرَّبّ، وهذا الفعلُ الكهنوتيُّ الأساسيّ.",
        "theological": "الكفارةُ تَنطوي علَى تطهيرٍ تامٍّ يشملُ كلَّ الخطايا، ممّا يُشيرُ إلى أنَّ الله يَقبَلُ الوسيطَ (الكاهِن) ليُزيلَ الحاجزَ بينَ الشَّعبِ وبينَهُ.",
        "deep": "الطهارةُ أمامَ الربِّ تعني استعادةُ العلاقةِ والاتّصالِ الرّوحيّ، فالخطيئةُ تَحجِبُ عن النّورِ وهذا اليومُ يُحيطُ بِعودةٍ إلى الصّفاءِ القلبيّ.",
        "applied": "الشّخصُ الذي يسعى إلى الطّهارةِ يجبُ أن يُدرِكَ أنَّ مجرّدَ الرّغبةِ والندمِ ليسا كافيَيْن، بل يحتاجُ إلى وسيطٍ ذي سلطةٍ روحيَّةٍ لِتَتَحَقَّقَ الكفارةُ الحقيقيَّة."
      }
    },
