      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقرر النص أن كل مركوب يستعمله صاحب السيل يصير نجسا، فيمتد الحكم إلى السرج وسائر ما يركبه لا إلى جسده وحده.",
        "theological": "تندرج نجاسة المركوب ضمن النجاسة الطقسية التي تجعل ما يتصل بصاحب السيل غير صالح للاستعمال الطاهر إلى حين التطهير.",
        "deep": "اتساع الحكم إلى السرج يكشف أن النجاسة، في شرح المصدر، تصور عدوى الخطية وخطر التلوث بمخالطة المتنجس.",
        "applied": "يدعو هذا الحكم إلى يقظة عملية في التعامل مع ما يتصل بالنجاسة، وإلى عدم الاستهانة بما يقتضي تمييزا وتطهيرا."
      }
    },
    "15:10": {
      "reference": "03-Leviticus 15:10",
      "text": "وَكُلُّ مَنْ مَسَّ كُلَّ مَا كَانَ تَحْتَهُ يَكُونُ نَجِسًا إِلَى الْمَسَاءِ، وَمَنْ حَمَلَهُنَّ يَغْسِلُ ثِيَابَهُ وَيَسْتَحِمُّ بِمَاءٍ، وَيَكُونُ نَجِسًا إِلَى الْمَسَاءِ.",
