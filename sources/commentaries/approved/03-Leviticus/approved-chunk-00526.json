      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفرق العدد بين إناء الخزف الذي يلمسه صاحب السيل فيكسر، والإناء الخشبي الذي يغسل بالماء، بحسب طبيعة كل وعاء.",
        "theological": "يظهر اختلاف المعالجة أن النجاسة الطقسية لا تعالج بصورة واحدة؛ فالخزف يكسر، أما الخشب فيقبل الغسل بالماء.",
        "deep": "تمييز الوعاءين يبرز جدية ما تلامسه النجاسة، وأن إزالة أثرها تتطلب الاستجابة للطريقة المعينة لا حلا عاما مفترضا.",
        "applied": "يدعو الحكم إلى التعامل المسؤول مع الأدوات المتأثرة: إتلاف ما أُمر بكسره، وتنظيف ما قُبل تطهيره، دون خلط بين الإجرائين."
      }
    }
