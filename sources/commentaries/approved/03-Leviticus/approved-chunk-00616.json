          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن الإسرائيلي الذي باع نفسه لغني من الغرباء يُعامل كأجير يُحسب معه سنة بسنة، لا كعبدٍ مملوكٍ مطلق التصرف فيه.",
        "theological": "يشير الشارح إلى أن عبارة أمام عينيك تعني أن قضاة بني إسرائيل يجب أن يراقبوا حال هذا الرجل، فإن ظُلم أخذوا له حقه ولو لم يشتكِ هو نفسه.",
        "deep": "يبيّن متى هنري أن هذا الحكم يمنح هذا المستعبَد لغريب مزايا أفضل مما لو باع نفسه لأخيه الإسرائيلي في بعض الجوانب، مع بقاء رقابة الشريعة عليه.",
        "applied": "يدعو الشارح إلى أن يهتم أصحاب السلطان بمن تحت أيديهم، فلا يُترك الضعيف بلا نصير حتى لو لم يرفع صوته بالشكوى أو الاعتراض."
      }
    },
    "25:54": {
      "reference": "03-Leviticus 25:54",
      "text": "وَإِنْ لَمْ يُفَكَّ بِهؤُلاَءِ، يَخْرُجُ فِي سَنَةِ الْيُوبِيلِ هُوَ وَبَنُوهُ مَعَهُ،",
      "summary": "",
