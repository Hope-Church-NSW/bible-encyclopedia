      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستشهد متى هنري بهذه العلة الإلهية أن بني إسرائيل عبيد للرب وحده لأنه أخرجهم من أرض مصر، فلا يُباعون كمماليك لبشر.",
        "theological": "يرى الشارح أن الله لا يجعل عبيده عبيداً لغيره، فما دام الرب قد افتداهم فلا يجوز أن يُعرَّضوا ثانية للبيع كالمملوكين.",
        "deep": "يشدد متى هنري على أن ملكية الرب لشعبه المفتدى من مصر هي الأساس الذي يقيّد سلطة كل سيد بشري عليهم ويمنعه من القسوة.",
        "applied": "يدعو هذا إلى تذكّر أن الانتماء لله يحرر الإنسان من استعباد الآخرين له، فلا يستعبد أحد أخاه ولا نفسه لشهوات البشر."
      }
    }
