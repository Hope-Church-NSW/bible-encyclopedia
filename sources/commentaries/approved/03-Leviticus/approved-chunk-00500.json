      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن النص أن غياب الشعر الأبيض وعدم عمق المظهر عن الجلد مع خفوت اللون يجعل الحالة غير حاسمة، فيلجأ الكاهن إلى الحجز سبعة أيام بدل الحكم الفوري.",
        "theological": "فترة الحجز سبعة أيام تعكس تمهّل الله في الحكم على حالات المخلوقين، فهو لا يتسرع بإعلان النجاسة بل يمنح مهلة للتحقق والتبيّن.",
        "deep": "يشير متى هنري إلى أن حرقًا عارضًا قد يكون سبب ظهور اللمعة، فالبلايا الجسدية تصيب الإنسان من أسباب متعددة تذكّره بضعف الجسد.",
        "applied": "يتعلم المؤمن من هذا التمهل ألا يصدر أحكامًا متسرعة على غيره حين تلتبس عليه الأمور، بل ينتظر ويتأنى حتى يتضح الحق بجلاء."
      }
    },
