      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد النص اليوم السابع موعدًا لإعادة الفحص، فمعيار الحكم هنا هو الامتداد الفعلي للّمعة في الجلد لا مجرد المظهر الأول الذي بدا غامضًا.",
        "theological": "تكرار الفحص في وقت محدد يبرز نظامًا إلهيًا دقيقًا في التعامل مع النجاسة، فالحكم يُبنى على أدلة متجددة لا على الشك الأول.",
        "deep": "يذكر متى هنري أن هذه الضوابط تتكرر في جميع الحالات المذكورة في الأصحاح، فالمبدأ واحد سواء نشأ الداء من دمل أو حرق أو قرعة.",
        "applied": "على المؤمن أن يراقب حاله باستمرار ولا يكتفي بفحص واحد لنفسه، فبعض الأمراض الروحية تحتاج إلى متابعة متجددة قبل الحكم عليها."
      }
    },
