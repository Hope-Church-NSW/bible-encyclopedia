      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبقى التيس الثاني حيًا أمام الرب بعد وقوع القرعة عليه، ليُجرى به التكفير ثم يُطلق إلى البرية.",
        "theological": "يفسر المصدر بقاء التيس وإرساله كعلامة لغفران الخطية أو صرفها برحمة الله، بخلاف التيس الذي يُذبح.",
        "deep": "جمع التيسين في ذبيحة خطية واحدة للجماعة يبيّن أن الذبح والإرسال صورتان متلازمتان في خدمة ذلك اليوم.",
        "applied": "تعلّم الآية أن رجاء الغفران لا يلغي مواجهة الخطية؛ فالإرسال يتم ضمن تقدمة منظورة أمام الرب."
      }
    },
