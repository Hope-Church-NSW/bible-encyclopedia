      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينتقل السرد إلى ثور هارون، وهو ذبيحة خطية عنه وعن بيته؛ فيقدّمه ثم يذبحه بنفسه.",
        "theological": "يشدد المصدر أن هارون يبدأ التكفير عن نفسه وبيته قبل خدمة الشعب، فلا يصالح الآخرين قبل أن يصالح هو.",
        "deep": "يفهم المصدر بيته على أنه عائلته وبيت هارون، أي الكهنة؛ لذلك لا تقف مسؤولية التقدمة عند حد الفرد.",
        "applied": "تضع الآية أولوية للفحص والمسؤولية القريبة قبل حمل أعباء الآخرين، من غير أن تجعل المحبة محصورة في البيت."
      }
    },
