      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "الذبح يتم في نفس المكان المعين للمحرقة، وسكب الدم حول المذبح يتبع نمطاً موحداً في جميع الذبائح المقدسة.",
        "theological": "رش الدم مستديراً على المذبح يرمز إلى انتشار الكفارة الكاملة، وحسب التقليد اليهودي كان هناك خط قرمزي على المذبح لتحديد موضع الرش.",
        "deep": "الطقسية الدقيقة في رش الدم تدل على عناية الله بالتفاصيل وضرورة الالتزام الحرفي بتعليماته.",
        "applied": "الدقة في تنفيذ الوصايا تعبر عن احترام عميق لمقدس العبادة والتزام حقيقي بطاعة الرب."
      }
    },
