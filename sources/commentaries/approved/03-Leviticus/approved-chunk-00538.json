      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحمل الخروف ذنوبهم إلى أرض غير مأهولة، ويُفهم أن الإبعاد ليس حذفاً للحقيقة فقط بل إشارة إلى رفع التبعة عن الشعب إلى موضع لا يُسترجع منه.",
        "theological": "يُقال إن الخروف يحمل ذنوبهم إلى أرض مقفرة، لأن المغفرة تُصوَّر كإزالة لا كإخفاء، فلا تردّ الخطيئة إلى حياة الشعب كما لو كانت لاشيء.",
        "deep": "تُظهر هذه الصورة أن التقديس يتجاوز الصفح اللفظي، لأن ما كان يثقل المجتمع يخرج من نطاقه ليُترك في أرض لا يسكنها أحد.",
        "applied": "يطلب هذا أن يدرك الإنسان أن خطاياه لا تُرَدُّ إلى مكانها في النفس كأنها عادية، بل تُتخذ موضعاً للمغفرة الحقيقية والرحمة."
      }
    },
