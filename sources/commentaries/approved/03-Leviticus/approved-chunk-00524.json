      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يمتد الحكم إلى الأشياء: كل فراش ينام عليه صاحب السيل يكون نجسًا، وكل ما يجلس عليه يصير نجسًا كذلك.",
        "theological": "يعلّم متى هنري أن هذا يشير إلى عدوى الخطية، فالمتنجّس ينجّس كل من لمسه أو لمسه، وكل ما يخصّه من فراش وكرسي ومركب.",
        "deep": "النجاسة المكتسَبة تلزم الإنسان حتى المغيب، ولا يتطهر إلا بغسل ثيابه واستحمامه بماء؛ فالتلوث ليس هيّنًا ولا يزول تلقائيًا.",
        "applied": "احترس من مخالطة الملوَّثين بغير تحفّظ، وخلّص نفسك من هذا الجيل الملتوي بيقظة دائمة وحرصٍ شديد في سلوكك."
      }
    }
