      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تسمّي الآية أربعة أصناف من الجراد المباح أكلها، وتكرر عبارة «على أجناسها» لكل صنف.",
        "theological": "يؤكد تعداد الأصناف أن الإذن بالأكل محدد، وأن الشريعة تميّز داخل فئة الحشرات الطائرة.",
        "deep": "يفصل النص بين الحكم العام والاستثناء المعيّن: فالمأذون به لا يُترك للتخمين بل يُذكر بأجناسه.",
        "applied": "تعلّمنا الآية استقبال الإذن والحدود كما وردا، وعدم توسيع الاستثناء بغير ما عيّنه الحكم."
      }
    },
