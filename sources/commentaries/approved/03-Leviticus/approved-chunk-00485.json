      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تستثني الآية من الحشرات الطائرة الماشية على أربع ما له أرجل أعلى قدميه للقفز على الأرض.",
        "theological": "يُظهر الاستثناء أن حدود المأكول تُحدَّد بأمر الشارع، مع وصفٍ دقيق للحالة المسموح بها.",
        "deep": "لا يكتفي الحكم بتسمية عامة، بل يربط الإذن بعلامة ظاهرة هي أرجل القفز فوق القدمين.",
        "applied": "تدعو الآية إلى الانتباه للتفاصيل حين يكون التمييز والطاعة مطلوبين، لا إلى الاكتفاء بالتصنيفات العامة."
      }
    },
