      "explanation_lines": {
        "academic": "يعود النص إلى القاعدة بعد الاستثناء، فيحكم على سائر دبيب الطير ذي الأرجل الأربع بأنه مكروه.",
        "theological": "يحفظ هذا الحكم وضوح الحد الفاصل: ما لم يدخل في الاستثناء المسمّى يبقى تحت المنع العام.",
        "deep": "تجاور الآية الاستثناء السابق لتمنع التعميم؛ فالخصائص وحدها لا تلغي الحاجة إلى حدود الحكم المعلنة.",
        "applied": "تنبّه الآية إلى عدم بناء قراراتنا على التشابه الظاهري، بل إلى مراعاة القيود المحددة في التوجيه."
      }
