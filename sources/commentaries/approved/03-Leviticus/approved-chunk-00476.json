      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح العدد كلاما مباشرا من الرب إلى هارون، تمهيدا للتعليمات التالية المتعلقة بسلوك الكهنة عند دخول خيمة الاجتماع.",
        "theological": "يعد الكلام المباشر إلى هارون تكريما له بعد امتثاله، ويؤكد أن توجيه الكاهن في خدمته صادر من الرب.",
        "deep": "المصدر يلاحظ أن التحذير قد يفسر كاتهام لو صدر من موسى؛ لذلك يخاطب الرب هارون بنفسه فينزع هذا الالتباس.",
        "applied": "استقبل التنبيه العملي بإنصاف، ولا تفترض أنه اتهام لشخصك؛ فقد يكون توجيها ضروريا لحفظ أمانة المسؤولية."
      }
