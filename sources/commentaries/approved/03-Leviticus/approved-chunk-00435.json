      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع المذنب يده على رأس ذبيحة الخطية تعريفاً بالقربان وإقراراً بالخطأ، ثم يذبحها في موضع المحرقة كما وصفت الشريعة.",
        "theological": "وضع اليد على رأس القربان يشير إلى تحمل المذنب مسؤولية خطيته وانتقاله إلى الذبيحة التي تقف محله أمام الرب.",
        "deep": "في هذا الفعل يعترف الفرد العادي أن خطيته تستحق الموت، وأن الذبيحة تقوم مقامه في تحمل تبعات المخالفة.",
        "applied": "علينا أن نقر بمسؤولياتنا عن أخطائنا ولا نتهرب منها، بل نسلمها إلى الله وننتظر طريقه في التكفير."
      }
    },
