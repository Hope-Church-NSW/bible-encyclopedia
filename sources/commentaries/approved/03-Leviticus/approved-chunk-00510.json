      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤخذ الطائر الحي مع خشب الأرز والقرمز والزوفا، ثم يغمس معاً في دم الطائر المذبوح فوق الماء الحي.",
        "theological": "يُظهر هذا الترتيب أن التطهير لا يكون بالماء وحده، بل بدمٍ يلامس كلّ جزء من الإجراء قبل المسح والاعتراف بالبراءة.",
        "deep": "يُشبه هذا الفعل انتقال الأثر من القتل إلى الحياة، فالدّينونة المعلنة تنتهي وتبدأ المعالجة في ما يبقى من المسبوق إلى ما يحتمل التجديد.",
        "applied": "يحمل هذا للمتطهر أن لا يقتصر على إزالة العار، بل يضع يده على كل ما يحيط به من أشياء قد استُعملت في إعادة التعيين."
      }
    },
