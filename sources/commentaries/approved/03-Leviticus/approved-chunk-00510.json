      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤمر الكاهن بذبح طائر واحد في إناء خزفي فوق ماء حيٍّ، فيتكوّن الدم الممزوج بالماء بحسب نظام التطهير.",
        "theological": "يظهر في هذا الحكم أن التغيير في حالة المبتلى لا يُنسب إلى جهده، بل إلى تعليمٍ موثوقٍ يقدمه الكاهن في موضع التقدير.",
        "deep": "تتجسد الطقوس هنا في الترتيب والتنفيذ، إذ يسبق الإعادة إلى الحياة استقرار الدم في إناءٍ ثم وضوح الماء في الفعل المعلن.",
        "applied": "يفهم المريض أن التنقية تبدأ بوضوحٍ في ما يراه الناس، فلا يطلب الخلاص من مجرد النداء بل من الإجراء الذي يقرّ به الكاهن."
      }
    },
