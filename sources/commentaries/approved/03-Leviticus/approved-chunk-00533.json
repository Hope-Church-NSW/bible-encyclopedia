      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "حَظَرَتِ الشَّريعَةُ على رئيسِ الكهنةِ الدُّخولَ إلى قُدْسِ الأقداسِ إلا مرةً واحدةً في السَّنةِ، حيثُ يكونُ الحجابُ حاجزًا بين المقدسِ والقدس الأقداس.",
        "theological": "المكانُ الذي يظهرُ فيهِ الله بحضورِهِ الإلهيِّ يجبُ أن يُحفظَ بقدسيةٍ، ولا يُقتربُ منهُ بِلا احترامٍ كي لا يموتَ الداخلُ بسببِ عظمةِ المجد الإلهي.",
        "deep": "الموتُ الذي يهددُ من يدخلُ بدونِ تحضيرٍ يعكسُ عمقَ الفجوةِ بين القدسيةِ الإلهيةِ والنجاسةِ البشريةِ، وضرورةَ الوساطةِ والكفارة.",
        "applied": "يعلِّمُ هذا الحكمُ المؤمنَ أهميةَ الاحترامِ والوقارِ عندَ الاقترابِ من الله، معَ إدراكِ أنَّ القربةَ إليهِ تتطلبُ تطهيرًا وتقديسًا من الداخل."
      }
    },
