      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصُب الكاهن بقية الزيت التي في كفه على رأس المتطهر، ثم يكفر عنه أمام الرب، فيتمم بذلك إجراء الزيت بعد مسح الأطراف.",
        "theological": "التكفير أمام الرب يعلن أن إزالة النجاسة الطقسية ليست مجرد عودة اجتماعية، بل استعادة للامتيازات التي حجبتها النجاسة.",
        "deep": "يؤكد الشرح أن البرص السابق، متى تم التطهير، لا يمنع صاحبه من القبول والاشتراك؛ فالعودة لا تبقى رهينة لوصمة الماضي.",
        "applied": "حين تُرد للإنسان حرية العبادة بعد مرض أو انقطاع، فليغتنمها بإظهار احترامه لله ومحبة موضع العبادة."
      }
    },
