      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأخذ الكاهن الأجزاء المحددة ويوقدها على المذبح كطعام وقود يُقدم للرب من ذبيحة السلام.",
        "theological": "تسمية ما يُحرق بـ'طعام الوقود' توضح أن القربان يكون غذاء النار المقدسة وقبول من الله كما يقبل الطعام من البشر.",
        "deep": "الدخان الصاعد من المذبح يمثل رفع التقديم إلى السماء، وإذابة الشحم ترمز لتحويل المادي إلى روحي في حضرة الله.",
        "applied": "العمل الكهنوتي في الحرق يعلم أن وساطة الكاهن ضرورية لقبول القربان وتقديسه أمام الله."
      }
    },
