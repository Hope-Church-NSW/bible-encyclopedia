      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتضمن التقديم إزالة الألية كاملة من عند العصعص مع الشحم الغاشي للأحشاء وسائر الشحم عليها كجزء من ذبيحة السلام.",
        "theological": "الشحم الذي قد يبدو تافهًا يصير مشرفًا حين يُكرس لخدمة الله، وذلك ليعطي الله الكرامة الحقة لكل ما يُقربه الإنسان.",
        "deep": "الإزالة الدقيقة للأجزاء المحددة تعكس الانتماء الكامل للحيوان لله، والتمييز بين ما يُحرق على المذبح وما لا يُحرق.",
        "applied": "الممارسة تُعلم أن تكريس ما لدينا لله يحول حتى الأشياء العادية إلى قرابين مقدسة مقبولة أمامه."
      }
    },
    "3:10": {
      "reference": "03-Leviticus 3:10",
      "text": "وَالْكُلْيَتَيْنِ، وَالشَّحْمَ الَّذِي عَلَيْهِمَا الَّذِي عَلَى الْخَاصِرَتَيْنِ، وَزِيَادَةَ الْكَبِدِ مَعَ الْكُلْيَتَيْنِ يَنْزِعُهَا.",
