      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُساوِي النص بين الفراش والمقعد خلال أيام السيل وبين أيام الحيض، فيصير كل ما تستقر عليه المرأة نجسًا مثل نجاستها.",
        "theological": "تظهر القاعدة أن النجاسة لا تقتصر على الجسد وحده، بل تمتد إلى ما يلتصق بالحياة اليومية، فتُحفظ حدود الطهارة في المنزل.",
        "deep": "وصف الفراش والجلوس يبرز أن العادة اليومية تضع الإنسان في علاقة مباشرة مع ما يُعدّ ملوثًا، فالإبعاد هنا لا يقتصر على اللمس بل على المكان.",
        "applied": "يُستفاد أن ما يُستعمل في الجوّ اليومي قد يحتاج إلى تدقيق، لأن الاتصال بموضع نجس يقتضي تعيينًا واضحًا للحيطة والابتعاد."
      }
    },
