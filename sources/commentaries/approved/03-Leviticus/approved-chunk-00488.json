      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن كل ما تقع عليه جثة إحدى الدواب النجسة الميتة يصير نجسًا، وأن التنور والموقدة نفسيهما يجب أن يُهدما لأنهما لا يمكن تطهيرهما من هذه النجاسة كباقي الأشياء.",
        "theological": "يرى متى هنري أن أمر هدم التنور والموقدة يعلّم الشعب أن لا شيء في حياتهم اليومية، حتى أدوات الطبخ، يُستثنى من طلب القداسة أمام الرب، فكل ما يخدمهم يجب أن يبقى طاهرًا.",
        "deep": "يعترف متى هنري بأن هذه الأحكام دقيقة وصعبة التطبيق، إذ يبدو أمرًا شاقًا أن يُهدم التنور أو موقد النار كله بسبب وقوع جثة دابة صغيرة عليه، لكن هذا كان مقصودًا لتعليمهم الدقة.",
        "applied": "يدعونا متى هنري إلى أن نطبّق مثل هذه الصرامة على أنفسنا في مقاومة الخطية، فلا نتساهل مع ما يلوّث حياتنا مهما بدا صغيرًا، بل نزيله بالكلية كما كانوا يهدمون التنور النجس."
      }
    },
