      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص مبادرة ناداب وأبيهو إلى أخذ مجمرتيهما وتقديم نار غريبة أمام الرب، وهي عبادة لم تصدر لهما فيها وصية.",
        "theological": "تُظهر النار الغريبة أن الاقتراب إلى الله لا يُدار بالرغبة الشخصية، بل بخضوع جاد لما عيّنه الله في عبادته.",
        "deep": "كانا قد نالا شرف الكهنوت حديثًا، لكن الطموح إلى دور أعلى بلا أمر حوّل امتياز الخدمة إلى افتراض متكبر أمام الله.",
        "applied": "لا تجعل معرفة الخدمة أو الحماس لها مبررًا للتصرف بلا توجيه؛ افحص أن تكون طاعتك لله مقدمة على رغبتك في الظهور."
      }
    },
    "10:2": {
      "reference": "03-Leviticus 10:2",
      "text": "فَخَرَجَتْ نَارٌ مِنْ عِنْدِ الرَّبِّ وَأَكَلَتْهُمَا، فَمَاتَا أَمَامَ الرَّبِّ.",
      "summary": "",
