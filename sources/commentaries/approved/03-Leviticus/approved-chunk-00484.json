      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل العدد 18 ثلاثة طيور داخل القائمة المفصلة للممنوعات، ويؤكد الشرح أن النهج هنا هو التعداد لا وضع معيار عام للطيور.",
        "theological": "يبرز ذكر البجع مع غيره أن نظام الطعام يطلب استجابة محددة للأمر؛ فالمعيار في هذا الموضع هو ما عينه المشرع.",
        "deep": "يضع الشرح البجع ضمن طيور تنسب إلى المواضع المظلمة والمنعزلة، مستخدما ذلك لتعليم الشعب ألا يتعمد الحزن أو الانفراد الدائم.",
        "applied": "حين لا يشرح النص سبب كل اسم، يعلمنا العدد احترام حدود واضحة بدل بناء الطاعة على ما نراه مفهوما أو مريحا."
      }
    },
