      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص العلامة الخضراء أو الحمراء التي تظهر في الثوب أو الجلد كدليل يُعرض على الكاهن ليحكم فيه، ولا يُترك الأمر لمجرد الظن أو التخمين الشخصي.",
        "theological": "يوضح متى هنري أن برص الثياب كان علامة وآية استثنائية أنزلها الله عقوبة غير عادية تدل على غضبه الشديد من شخص أو بيت معين.",
        "deep": "يشير متى هنري إلى أن هذا الأمر غير مفهوم الآن عندنا، فالخبراء يقرّون بأنه معجزة إلهية خاصة بإسرائيل ولم تكن ظاهرة طبيعية عادية في الأقمشة أو الجلود.",
        "applied": "يُعلّم النص ألا نصدر حكمًا بمجرد الشك أو الظن، بل نعرض الأمر على المختص المسؤول ليُفحص بعناية قبل اتخاذ أي قرار بشأنه."
      }
    },
