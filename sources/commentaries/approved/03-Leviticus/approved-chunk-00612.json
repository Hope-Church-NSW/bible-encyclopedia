      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تحدد الآية وضع الأخ المنكسر كأجير أو نزيل مؤقت، وتحدد مدة خدمته بحيث تنتهي بحلول سنة اليوبيل.",
        "theological": "يعكس التحديد بسنة اليوبيل مقاصد الله في استرداد الحرية ومنع العبودية الدائمة بين أبناء العهد.",
        "deep": "تؤكد حدود الخدمة المؤقتة أن القيود الاقتصادية لا تلغي رجاء التحرير والعودة لإرث الآباء.",
        "applied": "يُحث المؤمنون على وضع حدود عادلة لعلاقات العمل واحترام حريات العاملين ومنحهم حقوقهم المشروعة."
      }
