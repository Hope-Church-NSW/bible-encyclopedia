      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تفتتح الآية وحدة الأحكام الخاصة بضربة البرص في البيوت بتوجيه الكلام إلى موسى وهارون معاً.",
        "theological": "يُظهر توجيه الخطاب الإلهي أن تنظيم التعامل مع النجاسة المنزلية يبدأ من سلطان الرب لا من تقدير بشري مستقل.",
        "deep": "الآية القصيرة تضع ما يليها في إطار الوحي: ففحص البيت وإجراءاته اللاحقة استجابة لكلام الرب المعلن.",
        "applied": "عند معالجة ما يهدد سلامة البيت، يبدأ المبدأ هنا بالإنصات إلى توجيه الله وعدم الاكتفاء بالانطباعات الشخصية."
      }
    },
