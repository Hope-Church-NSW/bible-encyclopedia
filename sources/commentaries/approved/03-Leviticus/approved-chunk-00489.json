      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقرر النص استثناءً محددًا: سقوط جزء من جثة حيوان على بذرٍ معدّ للزرع لا يجعل البذر نجسًا، مع بقاء أحكام النجاسة الأخرى قائمة.",
        "theological": "يكشف هذا الاستثناء أن أحكام الطهارة الطقسية تضبط حالات ملموسة بدقة، فلا تُستنتج النجاسة من كل تماسّ دون مراعاة الحكم المعطى.",
        "deep": "تمييز البذر الجاف المعدّ للزرع يبرز دقة الشريعة في الاستثناءات؛ فالطاعة المطلوبة لا تقوم على التعميم المتسرع بل على الانتباه للتفصيل.",
        "applied": "يدعو هذا الحكم إلى التعامل المنضبط مع التعليمات: لا نضيف قيودًا من عندنا، ولا نُلغي فرقًا نصت عليه القاعدة صراحة."
      }
    },
