      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقابل العدد السابق: إذا وُضع ماء على البذر ثم وقعت عليه الجثة صار نجسًا لكم، فتغيّر حال البذر بالماء يغيّر الحكم المعلن.",
        "theological": "تظهر المقابلة أن الطهارة الطقسية ليست حكمًا عشوائيًا؛ إذ يحدد المشرّع حالة البذر بدقة ويطالب الشعب بأن يلتزم بالحدود التي وضعها.",
        "deep": "الانتقال من بذر جاف إلى بذر عليه ماء يعلّم أن التفاصيل الصغيرة قد تكون حاسمة في تطبيق الأمر، وأن الدقة جزء من ممارسة الطاعة.",
        "applied": "عند تطبيق توجيه واضح، راقب الظروف التي يذكرها بدل الاكتفاء بالقاعدة العامة؛ فاختلاف الحالة قد يستلزم استجابة مختلفة."
      }
    },
