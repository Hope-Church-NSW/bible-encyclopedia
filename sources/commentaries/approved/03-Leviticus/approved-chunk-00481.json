      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "والخنزير نجس رغم انقسام ظلفه لأنه لا يجترّ، فشرع الله يطلب كمال المعيار لا ظاهر الصورة فقط.",
        "theological": "هنا يثبت أن انطباع البشر قد يضلّ، لأنّ الظاهر لا يكفي إذا غاب ما أمر به الربّ في الحكم.",
        "deep": "التحريم يعلّم أن ما يُستساغ في العالم لا يصير طاهرًا إذا خلتْه صفة الطهارة التي يطلبها الربّ.",
        "applied": "فمن يحتذر الخنزير يعرف أن حدود الربّ لا تُتجاوز لأنّ العادة منتشرة، بل لأنّ الأمر هو المعيار."
      }
    },
