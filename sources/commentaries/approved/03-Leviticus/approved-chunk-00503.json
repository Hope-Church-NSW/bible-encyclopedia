      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن الحكم في هذه الحالة يتوقف على أمر بسيط هو لون الشعر النابت في موضع القرع، فإذا كان أسود دلّ ذلك على برء الجلد وطهارته.",
        "theological": "يرى المفسر أن ظهور الشعر الأسود علامة شفاء تُنهي حالة التعليق، فيُعلن الكاهن الطهارة رسميًا وينتهي أمر العزل عن الجماعة.",
        "deep": "يشير متى هنري إلى أن أمراض الجسد كلها دخلت بالخطية، فتذكّرنا هذه الحالة الشافية بأن نشكر الله متى مُنحنا العافية والسلامة في أجسادنا.",
        "applied": "يدعونا هذا الحكم إلى الصبر في انتظار قرار الكاهن، وإلى حمد الله إن كانت أجسادنا سليمة معافاة من هذه الأدواء الكثيرة."
      }
    },
