      "explanation_lines": {
        "academic": "يذكر متى هنري أن هذه الآية تفتح فحصًا جديدًا للكاهن حين تظهر بقع بيضاء لامعة في جلد الرجل أو المرأة، تمهيدًا للتمييز بين المرض والبثرة العادية.",
        "theological": "يُبيّن المفسر أن الشريعة لم تجعل كل تشوّه ظاهر في الجسد نجاسة طقسية، بل ميّزت بدقة بين ما يُنجّس وما لا يُنجّس أمام الله.",
        "deep": "يلاحظ متى هنري أن الحكمة الإلهية في الشريعة تحفظ الإنسان من أن يُتّهم ظلمًا بالنجاسة لمجرد وجود بقعة بيضاء عادية في جلده.",
        "applied": "يحثّنا هذا النص على عدم التسرع في الحكم على الآخرين من مظهرهم الخارجي، بل التأني والفحص كما فعل الكاهن قبل إصدار أي حكم."
      }
    },
