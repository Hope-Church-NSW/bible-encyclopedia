        "academic": "يوضح متى هنري أن الكاهن إذا رأى البقع كامدة اللون بيضاء يحكم بأنها بهق عادي أفرخ في الجلد، وهذا لا يُعدّ برصًا مُنجّسًا.",
        "theological": "يبيّن المفسر أن الشريعة ميّزت البهق عن البرص الحقيقي، فأعلنت طهارة صاحب هذه البقعة لأنها ليست علامة النجاسة التي حذّرت منها الوصية.",
        "deep": "يشير متى هنري إلى أن ليس كل تشوّه أو خلل جسدي علامة نجاسة، وأن هذا التمييز الدقيق يمنع الخلط بين الضعف الطبيعي والنجاسة الحقيقية.",
        "applied": "يعلّمنا هذا الحكم أن نميّز بين ما هو خطية حقيقية وما هو مجرد ضعف بشري عادي، فلا نحمّل أنفسنا أو غيرنا وزر ما ليس خطية."
      }
