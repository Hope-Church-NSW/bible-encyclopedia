      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح الآية الإجراء القانوني الأساسي للتشخيص حيث يُحضَر المريض إلى الكاهن للفحص الدقيق، مما يعكس نظام القضاء المركزي في الشريعة.",
        "theological": "يُعتبر البرص نجاسة طقسية موكولة للكاهن وليس للطبيب، مما يُظهر أن المرض إصابة إلهية مباشرة تتطلب حكماً دينياً لا طبياً.",
        "deep": "الحضور إلى الكاهن يعكس الحاجة إلى السلطة المُعيّنة لتمييز مستويات النجاسة والطهارة، حيث المعرفة الحقيقية بعلامات الإصابة تكون عند الكهنة.",
        "applied": "يعلِّم الآية المؤمن أن يسعى للحكم الروحي والفحص الدقيق قبل الحكم على نفسه، مع الخضوع للسلطة المشروعة المُختارة للتقييم."
      }
    },
