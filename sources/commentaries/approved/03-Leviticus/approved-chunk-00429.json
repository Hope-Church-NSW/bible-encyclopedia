      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن متى هنري أن هذا العدد يفتتح تفصيل ذبيحة خطية الكاهن الممسوح، إذ يأخذ من دم الثور ويدخله إلى خيمة الاجتماع، بخلاف ذبيحة أحد عامة الشعب.",
        "theological": "يشير متى هنري إلى أن الدم هو الذي يصنع الكفارة، فبدون سفك الدم لا تحصل مغفرة، لذا يُحمل دم الثور إلى داخل خيمة الاجتماع أمام الرب.",
        "deep": "يوضح متى هنري أن عظمة منصب الكاهن الممسوح وعلاقته بالله وبالشعب تجعل خطيته أثقل وزرًا من خطية أحد آحاد الشعب، فيستلزم أمره إدخال الدم إلى الخيمة.",
        "applied": "يعلّم متى هنري أن أصحاب المكانة الرفيعة تُحسب زلاتهم أشد خطرًا، فعليهم أن يبادروا بالاعتراف وطلب الكفارة كما فعل الكاهن الممسوح هنا."
      }
    },
