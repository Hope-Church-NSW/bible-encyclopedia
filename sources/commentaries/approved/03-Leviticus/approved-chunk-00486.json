      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفرض النص على من يحمل من جثث الحيوانات المذكورة أن يغسل ثيابه، وتستمر نجاسته الطقسية إلى المساء.",
        "theological": "تكرار الحكم يرسخ رهبة ما حرمه واضع الشريعة، مع أن سبب المنع التفصيلي لا يذكر في كل حالة.",
        "deep": "النجاسة هنا طقسية لا تدنيس للضمير في ذاتها؛ فالضرورة قد تستلزم نقل الجثة، ويصير التعدي خطأ عند احتقار الوصية.",
        "applied": "يعلمنا حمل الجثة وغسل الثياب أن نتعامل بجدية مع ما يفسد الطهارة، وأن نجدد التوبة في نهاية اليوم."
      }
    },
    "11:26": {
      "reference": "03-Leviticus 11:26",
      "text": "وَجَمِيعُ الْبَهَائِمِ الَّتِي لَهَا ظِلْفٌ وَلكِنْ لاَ تَشُقُّهُ شَقًّا أَوْ لاَ تَجْتَرُّ، فَهِيَ نَجِسَةٌ لَكُمْ. كُلُّ مَنْ مَسَّهَا يَكُونُ نَجِسًا.",
