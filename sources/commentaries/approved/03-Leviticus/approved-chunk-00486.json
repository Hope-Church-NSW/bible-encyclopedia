      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تعلن الآية نجاسة ما يمشي على كفوفه من الحيوانات الرباعية، وتربط لمس جثته بنجاسة تمتد إلى المساء.",
        "theological": "المدة المحدودة للنجاسة تبين أن الحكم كان طقسياً مؤقتاً، لا حكماً بأن الملامس مدنس الضمير أو مذنب بالضرورة.",
        "deep": "كان أثر النجاسة يمنع الملامس مؤقتاً من الخيمة والأشياء المقدسة والمخالطة المألوفة، فيجعل الحدود المرئية ذات وزن عملي.",
        "applied": "ينبهنا الحكم إلى الحذر في شؤون الحياة العادية؛ فلا نفصل العناية بالطهارة عن تصرفاتنا اليومية ومسؤولياتنا العملية."
      }
    },
