      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع شيوخ الجماعة أيديهم على رأس الثور أمام الرب، ويُذبح الثور أمام الرب كفارة عن الجماعة.",
        "theological": "تمثّل أيدي الشيوخ تبنيهم للذنب الجماعي، ويؤدي الذبح إلى إظهار أن العذاب لا يمر دون تقديم التوبة.",
        "deep": "في هذا التدبير، تُحمل مسؤولية الشعب على المذبح، فتتجسد الشراكة في الإثم والطلب للصفح.",
        "applied": "تطلب قيادة الجماعة أن تُعرض الخطيئة علناً، وأن تُؤدّى مسؤولية التوبة لا بالاهانة بل بالاعتراف والضمير."
      }
    },
