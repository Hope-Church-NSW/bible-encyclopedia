      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتطلب اليوم السابع من طقس الطهارة حلق جميع شعر الجسد والوجه والحاجبين مع غسل الثياب والجسد بماء لإتمام الطهارة الظاهرة.",
        "theological": "الغسل والحلق يرمزان إلى إزالة كل أثر للدنس السابق وتجديد حالة الطهارة القانونية قبل العودة للحياة الطبيعية.",
        "deep": "هذه الطقوس الجسدية تعكس رغبة المشروع في تطهير شامل يتضمن الجسد كله من الرأس إلى القدمين لاستعادة الكرامة الشخصية.",
        "applied": "الالتزام بتفاصيل الطهارة يظهر احترام الملتزم بتعليمات الله والتفاني في تنقية ذاته قبل العودة إلى المجتمع والعبادة."
      }
    },
