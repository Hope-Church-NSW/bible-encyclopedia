      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقدّم هارون ثور ذبيحة الخطية الذي له قبل خدمته للشعب، ويجعل الكفارة عن نفسه وعن بيته.",
        "theological": "تؤكد الآية أولوية التكفير عن هارون وبيته؛ فلا يتقدم لمعالجة خطايا الشعب قبل أن يبدأ بما يخصه.",
        "deep": "يذكر الشرح أن تقديم الثور اقترن باعتراف جاد بالخطايا وطلب الغفران، مع وضع اليدين على رأس الذبيحة.",
        "applied": "تحث الآية من يتولى خدمة الآخرين على فحص نفسه وبيته أولًا، وألا يجعل الاهتمام بالناس ستارًا لإهمال مسؤوليته القريبة."
      }
    },
