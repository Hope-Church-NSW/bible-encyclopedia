      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير متى هنري إلى أن قربان السلامة من الغنم يجوز أن يكون ذكرًا أو أنثى شرط أن يكون صحيحًا بلا عيب، بخلاف بعض الذبائح الأخرى التي تشترط الذكورة فقط.",
        "theological": "يعلّم متى هنري أن اشتراط سلامة القربان من العيب يعكس أن الله يستحق الأفضل من ممتلكات الإنسان، وأن تقديم المعيب استخفاف بقداسته وكرامته.",
        "deep": "يلاحظ متى هنري أن عدم اشتراط الذكورة في هذا القربان، خلافًا للمحرقة، يدل على أن الله في عطاياه الروحية لا ينظر إلى الجنس بل إلى حال القلب المخلص المقدَّم له.",
        "applied": "يدعو متى هنري المؤمن إلى فحص نفسه قبل أي تقدمة، فلا يقدّم لله ما هو ناقص أو رخيص من وقته أو ماله، بل ما هو سليم وكامل يليق بمن يستحق الإكرام."
      }
    },
