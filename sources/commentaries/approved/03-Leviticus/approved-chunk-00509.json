      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤكّد النص أن شريعة التطهير تبدأ من إعلان أنّ العلة قد زالت، وأنّ الكاهن هو المرجع الذي يثبت هذا التحوّل في حياة المريض.",
        "theological": "في هذا الموضع تظهر سلطة الكاهن في إعلان الطهارة، لا بوصفه مُنقذاً بحد ذاته، بل كواسطة للمشهد الذي يثبت عودة المريض إلى مجتمع القداسة.",
        "deep": "تُقرأ القاعدة بوصفها مرحلة انتقالية بين العُزلة والعودة، إذ لا تُعالج حالة الانفصال إلاّ بمرور وقتٍ رسميّ يحدّد استقرار الشفاء.",
        "applied": "عندما يختفي ألم الإنسان أو قيده، لا بدّ من شهادة واضحة ومؤكدة تعيدُه إلى المجتمع وتمنحه فرصة جديدة في العلاقة والامتثال."
      }
    },
