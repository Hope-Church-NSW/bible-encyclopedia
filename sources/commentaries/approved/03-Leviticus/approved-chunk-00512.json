      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأخذ الكاهن بعض الزيت من اللج ويصبه في كف يده اليسرى، مهيئًا الزيت للخطوات التالية من طقس تطهير الشخص.",
        "theological": "يفصل النص بين أخذ الزيت وصبه وبين استعماله اللاحق، فيُظهر أن الطقس يجري بترتيب كهنوتي مقصود أمام الرب.",
        "deep": "لا ينتقل الكاهن مباشرة إلى وضع الزيت على المتطهر، بل يحتفظ به في كفه أولًا؛ والتدرج يحفظ تمييز كل فعل داخل الطقس.",
        "applied": "تعلمنا هذه الخطوة أن استعادة العبادة لا تقوم على العجلة؛ فالاستعداد المنضبط لأداء ما أُمر به جزء من احترام قداسة الله."
      }
    },
