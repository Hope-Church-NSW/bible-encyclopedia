      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع الكاهن من دم ذبيحة الإثم على طرف الأذن اليمنى وإبهام اليد اليمنى وإبهام الرجل اليمنى للشخص الذي يُطهَّر.",
        "theological": "يرى الشرح أن الدم علامة للغفران، ووضعه على أطراف الجسد يضم الجسد كله في طقس التطهير واستعادة القبول.",
        "deep": "تكرار المواضع الثلاثة، وهي الأذن واليد والرجل، يبرز شمول الطقس؛ فالدم لا يلامس موضعًا واحدًا بل نهايات الجسد الدالة على كله.",
        "applied": "تذكّرنا الآية بأن الاستجابة للغفران لا تُحصر في الداخل؛ فالاستماع والعمل والسير تحتاج جميعًا إلى أن تُوجَّه في طريق الطهارة."
      }
    },
