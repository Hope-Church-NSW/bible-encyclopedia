      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر متى هنري أن لمس نجاسة الإنسان، أيا كانت صورتها، يوقع اللامس تحت حكم مشابه لحكم لمس جثث الحيوانات النجسة المذكورة قبله.",
        "theological": "الذنب هنا لا يقوم على قصد الإنسان بل على استمراره في الجهل بعد أن يعلم بنجاسته، فتصبح المعرفة موجبة للمسؤولية أمام الرب.",
        "deep": "خفاء الأمر عن الإنسان أولا لا يعفيه من الذنب متى تكشف له الحق، إذ العبرة عند الرب بالاستجابة للمعرفة لا بلحظة وقوع الخطأ.",
        "applied": "يحتاج المؤمن إلى يقظة داخلية تجعله يتحرك فور معرفته بما يدنسه، فلا يسوغ لنفسه التأجيل بحجة أنه لم يقصد ذلك ابتداء."
      }
    },
