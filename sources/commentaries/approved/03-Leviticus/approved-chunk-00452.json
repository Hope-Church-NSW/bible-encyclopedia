      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "التقدمة الملتوتة بزيت أو الناشفة لا تختص بكاهن واحد، بل توزع على جميع بني هارون بالتساوي، كل واحد كأخيه.",
        "theological": "يعكس الحكم روح الشركة بين الكهنة؛ ما لا يحتاج إلى استعمال عاجل يصبح قسمة مشتركة تحفظ المودة والإنصاف.",
        "deep": "بعد النصيب الفردي في التقدمة المطهوة، يبرز هنا مبدأ القسمة العادلة حين لا توجد ضرورة للاستعجال في الاستهلاك.",
        "applied": "تعلّم الآية أن موارد الخدمة لا تُحتكر بلا سبب، بل تُدار بعدل يراعي الإخوة ويحفظ الشركة بين العاملين."
      }
    },
