      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص ذبح العجل أمام الرب ثم قيام بني هارون الكهنة بتقريب الدم ورشه حول المذبح عند باب خيمة الاجتماع، وهو ما يبين ترتيبًا محددًا لأدوار المُقرِّب والكهنة في تقديم المحرقة.",
        "theological": "يشير متى هنري إلى أن رش الكهنة للدم على المذبح كان لأن الدم هو الحياة، وبه كان يُصنع الكفّارة عن النفس، فالتعامل مع الدم بهذه الدقة يعبّر عن جدّية الكفارة المطلوبة.",
        "deep": "يوضح متى هنري أن الذبح كان يجب أن يتم بأيدي الكهنة أمام الرب، أي بطريقة تقيّة دينية ومراعاة لحضور الله وكرامته، لا كذبح عادي لمناسبة اجتماعية.",
        "applied": "يُظهر هذا الترتيب أن خدمة الله تحتاج إلى تنظيم وأمانة في أداء كل جزء من العبادة، فكل شخص يقوم بدوره المحدد باحترام وخضوع لحضرة الرب."
      }
    },
