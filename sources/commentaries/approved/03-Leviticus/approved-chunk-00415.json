      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن النص أن بني هارون الكاهن هم من يضعون النار على المذبح ويرتبون الحطب عليها، وهو تفصيل يوضح أن إشعال النار وتجهيزها كانا من مسؤولية الكهنة حصرًا.",
        "theological": "يلاحظ متى هنري أن وضع النار وترتيب الحطب من قبل الكهنة كان جزءًا من نظام إلهي دقيق لا يُترك للمصادفة، بما يحفظ قداسة العمل الذي يجري أمام الرب على المذبح.",
        "deep": "يُفهم من الشرح أن تهيئة النار والحطب بترتيب مقصود كانت خطوة تسبق وضع أجزاء الذبيحة عليها، فالنار لم تكن عشوائية بل مُعَدّة خصيصًا لتكون وسيلة الاحراق المقبول.",
        "applied": "يعلّم هذا التفصيل أن خدمة الرب تتطلب إعدادًا وترتيبًا مسبقًا لا إهمالًا ولا ارتجالًا، فكل استعداد للعبادة ينبغي أن يُقام بعناية تليق بحضور الله."
      }
    },
