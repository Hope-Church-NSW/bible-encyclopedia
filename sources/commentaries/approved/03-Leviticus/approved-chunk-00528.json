      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجب غسل الثياب والجلود التي يكون عليها انبعاث الزرع بالماء قبل استخدامها مجددًا.",
        "theological": "الناموس يعلّم أن الفعل الطبيعي يفرض حالة من عدم التطهر المؤقت حتى غروب الشمس.",
        "deep": "الغسيل بالماء يرمز إلى الحدود بين حالات النجاسة والطهارة في النظام الكهنوتي.",
        "applied": "ممارسة الطهارة المنتظمة تحافظ على احترام حرم المقدس وتعاليم الاقتراب منه."
      }
    },
