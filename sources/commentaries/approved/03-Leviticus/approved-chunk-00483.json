      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضيف العدد إلى القائمة الحدأة والباشق على أجناسه، مواصلاً هنري تعداد الطيور الجارحة الممنوعة من الأكل بحسب أصنافها.",
        "theological": "اعتبار هذه الطيور نجسة يؤكد أن الرب وضع حدوداً دقيقة لتمييز شعبه عن سائر الأمم في مأكلهم.",
        "deep": "يلاحظ متى هنري أن الحمام المفترَس صالح للأكل وللقربان، أما الحدأة والباشق المفترِسان فمكروهان لأنهما يمثلان الظالم لا المظلوم.",
        "applied": "يحث هذا المؤمن على أن يقف إلى جانب المتألمين من أجل البر، لا أن يسلك مسلك من يفترسهم ويؤذيهم."
      }
    },
