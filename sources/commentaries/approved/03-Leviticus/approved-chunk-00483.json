      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يورد متى هنري أن هذا العدد يبدأ قائمة تعداديّة لطيور محرّمة لا قاعدة عامة فيها، خلافاً لقاعدة الأسماك، وأولها النسر والأنوق والعقاب.",
        "theological": "يشدّد النص على أن هذه الطيور مكروهة لا تؤكل، فامتناع الشعب عنها علامة طاعة لأمر الرب في التمييز بين الطاهر والنجس.",
        "deep": "يرى متى هنري أن هذه الطيور طيور جارحة، فأراد الله من شعبه أن يكره كل ما هو وحشيّ وقاسٍ ولا يعيش على الدم والافتراس.",
        "applied": "يدعو هذا إلى أن يرفض المؤمن روح القسوة والافتراس في تعامله، ويختار حياة الرفق بدل التسلط على الضعفاء من حوله."
      }
    },
