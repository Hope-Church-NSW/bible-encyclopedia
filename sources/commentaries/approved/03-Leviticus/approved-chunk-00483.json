      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر العدد الغراب على أجناسه ضمن قائمة الطيور المحرّمة، ويصنّفه هنري بين الطيور التي تسكن الأماكن الموحشة والخربة.",
        "theological": "امتناع الشعب عن الغراب المكروه يعبّر عن التزامهم بأحكام النجاسة التي وضعها الرب لتقديسهم.",
        "deep": "يشير متى هنري إلى أن طيوراً كالغراب تألف الخراب والعزلة، وأن الله لا يريد لشعبه أن يكونوا شعباً كئيباً يحب الانفراد الدائم.",
        "applied": "يدعو هذا المؤمنين إلى الابتعاد عن روح الكآبة والانعزال، والعيش بفرح في شركة مع جماعة الرب."
      }
