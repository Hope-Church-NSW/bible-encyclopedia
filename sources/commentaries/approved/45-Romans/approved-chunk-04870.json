            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقرر النص أن أعمال الناموس لا تبرر أي إنسان أمام الله، لأن وظيفته الأساسية هي إظهار الخطية وكشف مواضع الانحراف عن المعيار.",
        "theological": "الناموس يكشف الجرح ولا يقدّم التبرير؛ لذلك لا يستطيع الإنسان المذنب أن يحوّل طاعته إلى أساس لقبوله أمام الله.",
        "deep": "كلما قورنت الحياة بالناموس في شدته وامتداده ظهرت الخطية بوضوح، وانكشف عجز الأعمال البشرية عن معالجة الذنب السابق.",
        "applied": "استخدم كلمة الله لتشخيص خطيتك لا لتجميل صورتك، ودع معرفة التقصير تقودك إلى التواضع وطلب التبرير بدل الاتكال على الإنجاز."
      }
    },
    "3:21": {
      "reference": "45-Romans 3:21",
      "text": "وَأَمَّا الآنَ فَقَدْ ظَهَرَ بِرُّ اللهِ بِدُونِ النَّامُوسِ، مَشْهُودًا لَهُ مِنَ النَّامُوسِ وَالأَنْبِيَاءِ،",
      "summary": "",
