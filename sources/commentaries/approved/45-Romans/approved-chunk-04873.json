      "explanation_lines": {
        "academic": "ينقل بولس الحجة من الختان إلى الناموس: وعد الميراث لإبراهيم ونسله لم يأت بواسطة الناموس بل ببر الإيمان.",
        "theological": "الوعد مؤسس على ثقة تُحسب برًا، لا على نظام الناموس، لأن الوعد سبق الناموس ولا يستمد قوته منه.",
        "deep": "الميراث في الآية يبقى وعدًا رحبًا، لكن مفتاحه ليس الامتلاك أو الاستحقاق القانوني بل علاقة إيمان بالله الواعد.",
        "applied": "عندما تتعامل مع وعود الله، لا تجعل استحقاقك القانوني مركز الرجاء؛ اجعل الثقة بمن وعد هي طريق الثبات."
      }
    },
