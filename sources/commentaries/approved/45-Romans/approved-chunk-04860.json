      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوجّه الرسالة إلى جميع الموجودين في رومية، ويصفهم بأحباء الله ومدعوين قديسين، ثم يفتتح بتحية النعمة والسلام من الآب والرب يسوع المسيح.",
        "theological": "الحب والدعوة يحددان امتياز الجماعة وواجبها معًا؛ والنعمة والسلام عطيتان مصدرهما الله الآب والرب يسوع المسيح، وهما أساس التحية الرسولية.",
        "deep": "يخاطب بولس الجماعة كلها لا فئة منتقاة، فيجمع بين هوية المحبوبين ونداء القداسة، ثم يضع حياتهم تحت عطية النعمة وسلامها.",
        "applied": "عش هويتك كمحبوب ومدعو إلى القداسة في آن واحد؛ وابدأ علاقاتك وصلواتك طالبًا نعمة الله وسلامه بدل الاعتماد على الاستحقاق الشخصي."
      }
    },
