      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تحدد الآية محتوى الفم بأنه لعنة ومرارة، فتصف نمطًا مستمرًا من الكلام الذي يتمنى الشر ويعكس قسوة القلب.",
        "theological": "اللعنة والمرارة ليستا زلة عابرة في هذا الوصف، بل مظهران لفساد داخلي يوجهان الكلام ضد الله والناس.",
        "deep": "امتلاء الفم يبين أن المرارة صارت مادة الكلام المعتادة؛ فما يفيض على اللسان يكشف ما استقر في الداخل.",
        "applied": "استبدل التذمر والتمني بالشر بكلام منضبط، واطلب أن تنكشف مرارتك الداخلية قبل أن تؤذي من حولك."
      }
    },
