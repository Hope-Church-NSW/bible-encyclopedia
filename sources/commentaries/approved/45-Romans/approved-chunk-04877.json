      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن العدد أن دخول الناموس كشف ازدياد التعدي وأعلن فيض النعمة فوقه.",
        "theological": "لا يخلق الناموس الخطيئة، بل يكشف كثرتها كما يكشف الضوء غبار الغرفة.",
        "deep": "كشف الذنب ليس غاية في ذاته؛ إنه فحص للجرح الضروري لبدء العلاج.",
        "applied": "حين تكشف الوصية خطأك، لا تنكره؛ دع هذا الكشف يقودك إلى رجاء النعمة."
      }
    },
