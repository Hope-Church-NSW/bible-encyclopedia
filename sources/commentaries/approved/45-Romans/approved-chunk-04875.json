      "explanation_lines": {
        "academic": "والصبر يثمر تجربة، والتجربة تُصاغ رجاءً، فلا يكمل الإيمان في السهولة وحدها.",
        "theological": "تجربة الله في المحنة تُظهر ثباته، وتُنشئ في القلب رجاءً لا ينهار عند النقص والاختبار.",
        "deep": "الرجاء هنا نضج يترسخ من خلال الصبر، فيصبح يقيناً أهدأ من الخوف ويقوّي المشي في العسر.",
        "applied": "يُدعى المؤمن أن يلاحظ كيف تُنبت المحنة في قلبه تجربة ثم رجاء، فيُستقر في الله لا في الظروف."
      }
    },
