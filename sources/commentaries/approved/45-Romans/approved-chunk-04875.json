      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "بالمسيح صار لنا دخول بالإيمان إلى هذه النعمة التي نقف فيها، فنستبشر بروح الرجاء في مجد الله.",
        "theological": "الدخول إلى النعمة يثبت أن الإيمان ليس مجرد اعتراف بل موضع إقامة، إذ يثبت المؤمن في محبة الله.",
        "deep": "النعمة موضع يقف فيه الإنسان لا مجرد لحظة عابرة، فالعلاقة مع الله تُبنى على الثقة المستمرة والرجاء.",
        "applied": "يُشجّع هذا القلب على الوقوف بثقة في موضع النعمة، لأن الله لا يترك المؤمن في خلوة التشكيك بل في حضور الفرح."
      }
    },
