      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعلل الكاتب دعوته إلى الهدوء بخطر المساءلة عن فتنة ذلك اليوم، إذ لا توجد علة تفسر هذا التجمع.",
        "theological": "يكشف التحذير أن الجماعة مسؤولة عن أعمالها العلنية، وأن غياب السبب لا يزيل تبعة الفوضى الناتجة عنها.",
        "deep": "الاجتماع الذي لا يستطيع أصحابه بيان علته يقف مكشوفًا أمام السؤال؛ كثرة الحاضرين لا تمنحه مبررًا.",
        "applied": "قبل الانضمام إلى احتجاج أو حملة غاضبة، اسأل عن سببها وغايتها وما يمكن قوله بصدق عند طلب الحساب عنها."
      }
    },
