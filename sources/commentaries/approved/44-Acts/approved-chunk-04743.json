      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجمع بطرس في جوابه بين التوبة والمعمودية باسم يسوع المسيح، ويربط هذا المسار بغفران الخطايا وقبول عطية الروح القدس.",
        "theological": "التوبة هنا تغيير في الفكر والطريق، والمعمودية إعلان علني للإيمان والخضوع؛ والوعد بالغفران وعطية الروح مقدم لكل واحد يستجيب.",
        "deep": "تكرار الدعوة لكل واحد يزيل الاتكال على الانتماء الجماعي، ويؤكد أن كل شخص مدعو إلى موقف شخصي من الخطيئة ويسوع.",
        "applied": "استجب للتوبة استجابة عملية: اترك الطريق القديم، وأعلن إيمانك بيسوع، واطلب أن يظهر غفرانك الجديد في حياة خاضعة له."
      }
    },
