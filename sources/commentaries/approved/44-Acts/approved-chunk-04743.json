      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح العدد امتداد الوعد إلى المخاطبين وأبنائهم وإلى البعيدين، لكنه يحدد المستفيدين بمن يدعوهم الرب إله الجماعة.",
        "theological": "النعمة المعروضة ليست محصورة في دائرة قريبة، بل تمتد إلى أجيال وأماكن بعيدة، مع بقاء الدعوة الإلهية أساس الاستجابة.",
        "deep": "يجمع النص بين اتساع الوعد وخصوصية النداء؛ فلا يضع حدًا جغرافيًا للرجاء، ولا يحوله إلى امتياز آلي بلا دعوة.",
        "applied": "لا تعتبر بُعدك أو بُعد الآخرين عائقًا أمام الرجاء؛ أعلن الوعد للجميع، واترك لله أن يدعو مستجيبيه ويقودهم إلى الإيمان."
      }
    },
