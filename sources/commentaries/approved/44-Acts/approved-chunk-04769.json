      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "بعد أن شهدا وبشّرا بكلمة الرب، عاد بطرس ويوحنا إلى أورشليم وهما يعلنان البشارة في قرى سامرية كثيرة.",
        "theological": "لا يقدّم الرسولان رسالة جديدة، بل يشهدان للكلمة التي تسلماها ويثبتان ما أُعلن سابقًا في السامرة.",
        "deep": "تجمع الآية بين إنجاز المهمة الخاصة بهما واستثمار فرصة الطريق؛ فالخدمة لا تقف عند المدن أو الجماعات الكبيرة.",
        "applied": "يدعو المثال الخادم إلى استثمار فرص الطريق اليومية للشهادة بالكلمة، وعدم احتقار الأماكن الصغيرة أو الناس المجهولين."
      }
    },
