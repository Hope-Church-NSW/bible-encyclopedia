      "explanation_lines": {
        "academic": "يتابع العدد حركة بولس في سورية وكيليكية، محددًا غاية الرحلة بأنها تثبيت الكنائس.",
        "theological": "يؤكد تثبيت الكنائس أن الخدمة لا تقف عند البداية، بل تهتم بتقوية الذين سبق أن آمنوا.",
        "deep": "يربط المصدر استمرار بولس بقدرته على متابعة العمل بفرح رغم فقدانه رفيقه القديم وتغير معاونه.",
        "applied": "لا تجعل تغير الشركاء أو خيبة الخلاف توقفك عن واجبك؛ واصل تقوية الآخرين بما يلائم احتياجهم."
      }
    }
