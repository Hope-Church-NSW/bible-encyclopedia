      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُعرف الخبر في كل يافا، فيستجيب كثيرون بإنكار للموت ويؤمنون بالرب، إذ استحال الحدث إلى شهادة عامة في المدينة.",
        "theological": "هنا المعجزة لا تُعد نهاية في ذاتها بل بداية للاعتراف، لأن ما جرى جعل المدينة تنظر إلى ما فعله الله في بطرس، فاستيقظت القلوب إلى حقيقة الخلاص المعلن.",
        "deep": "المعلومة تنتشر كأنها صوت يخرج من الغرفة العليا إلى الطريق، فيعبر الخبر البلدة كلها، ويخلف في الناس وقفة بين التفرج والاعتماد على ما رأوا.",
        "applied": "يُسأل كل مؤمن: هل يروي خبر الخير كما يروي خبر الحزن؟ فالخبر الذي يُنقل عن نعمة الله يكون منبعًا للايمان ومصدرًا للثقة للمحتاجين."
      }
    },
