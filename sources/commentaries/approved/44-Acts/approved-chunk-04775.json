      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينتقل السرد من مجاهرة شاول إلى مخاطبته ومباحثته اليونانيين، ثم يذكر مباشرةً أن خصومه شرعوا في تدبير قتله.",
        "theological": "يُظهر المقطع أن الكلام الجريء باسم الرب يسوع قد يثير مقاومة، وأن العجز عن مجاراة الحجة لا يجعل العنف جواباً مشروعاً.",
        "deep": "كان شاول من هذه الفئة نفسها، ولذلك بدا تحوله واستدلاله أشد إزعاجاً لهم؛ فالخصومة تشتد أحياناً حين يأتي الشاهد من الداخل.",
        "applied": "عند اشتداد الحوار، لا يُقاس صدق القضية بارتفاع التهديدات؛ ليكن الرد ثابتاً وواضحاً، مع رفض تحويل الخلاف إلى أذى."
      }
    },
