            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير النص إلى بعض الرجال من قبرص وقيروان الذين جاءوا إلى أنطاكية وتكلموا إلى اليونانيين، فالأخبار تبرز انتقال البشارة من نطاق اليهود إلى جماعة جديدة.",
        "theological": "تُستشهد هنا بمدى عمل الرب في فتح قلوب المستمعين، لأن التبشير يتم بحسب استعداد الناس، لا بحسب مكان التبشير وحده.",
        "deep": "تتجاوز الرسالة حدود موضعها الأولي، فتتحول إلى خدمة تُكلّم فئة من الناس بلسانهم وملابساتهم، ولا تُلغى الهوية القومية بل تُستكمل في المسيح.",
        "applied": "حين يفتح الرب الطريق، لا تكتفِ بحقلٍ واحد؛ ابحث عن من يسمعون ويحتاجون إلى الرب في محيطهم الخاص."
      }
    },
    "11:21": {
      "reference": "44-Acts 11:21",
      "text": "وَكَانَتْ يَدُ الرَّبِّ مَعَهُمْ، فَآمَنَ عَدَدٌ كَثِيرٌ وَرَجَعُوا إِلَى الرَّبِّ.",
