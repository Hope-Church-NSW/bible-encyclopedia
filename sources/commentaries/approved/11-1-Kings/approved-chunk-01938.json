      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل النص أن سليمان استدعى شمعي وأمره ببناء بيت في أورشليم والإقامة فيها دون مغادرتها، وهو إجراء إداري يحصر حركته ضمن حدود المدينة الملكية.",
        "theological": "يوضح متى هنري أن سليمان، الملك الذي أقامه الله، لم ينقض وعد داود لشمعي بحياته، بل جعل الطاعة لهذا الأمر شرطًا لبقائه حيًا، فجمع بين الرحمة والعدل.",
        "deep": "يشير هنري إلى أن حصر شمعي في أورشليم، مدينة الجمال والفرح، جعل قيده سهلاً محتملاً، بينما أتاح لسليمان مراقبة تحركاته عن كثب ومنع أذاه لغيره.",
        "applied": "يعلّم الحادث أن قبول القيود التي يضعها الله أو من فوقنا لأجل سلامتنا قد يكون طريق الحياة، وأن رفضها استخفافًا بالنعمة المعروضة."
      }
    },
