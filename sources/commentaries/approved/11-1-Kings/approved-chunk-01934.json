      "explanation_lines": {
        "academic": "جاء أدونيا ابن حجيث إلى بثشبع أم سليمان وسألته إن كان قدومه سلميًا، فأجاب بأنه جاء للسلام، مع أن نيته كانت مغايرة لذلك تمامًا.",
        "theological": "سؤال بثشبع يعكس حذرها المشروع تجاه أدونيا الذي حاول اغتصاب الملك سابقًا، إذ لم تنسَ دوره في محاولة الانقلاب على سليمان.",
        "deep": "كلمات أدونيا كانت أنعم من الزبد لكن الحرب كانت في قلبه، فقد أخفى مشروعه الخبيث وراء ظاهر السلام والتواضع أمام أم الملك.",
        "applied": "يحذّر هذا من الثقة بمن أظهر خضوعًا مصطنعًا بعد فشل سابق، فقد يخفي وراء كلمات السلام مشروعًا خفيًا لم يتخلَّ عنه بعد."
      }
    },
