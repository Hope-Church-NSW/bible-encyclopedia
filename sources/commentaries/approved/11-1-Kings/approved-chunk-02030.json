      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أليشع وجد في الحقل يحرث مع اثني عشر فدان ثيران، موضحاً أنه رجل مجد وموارد، قبل أن يُدعى للخدمة النبوية العظيمة.",
        "theological": "ألقاء رداء إيليا عليه لم يكن مجرد اتصال جسدي بل علامة على انتقال الروح والسلطة النبوية من معلم إلى تلميذ.",
        "deep": "الدعوة جاءت بغتة وغير متوقعة من شخص لا يبحث عنها، مما يظهر أن اختيار الله قائم على مشيئته لا على استحقاق الإنسان.",
        "applied": "المؤمن قد يُدعى إلى عمل عظيم وهو منشغل بأموره اليومية؛ الاستجابة الفوريّة للدعوة الإلهية هي اختبار الإيمان الحقيقي."
      }
    },
