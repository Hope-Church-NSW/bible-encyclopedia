      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "اعتراض عوبديا يصوغ الخطر كسؤال عن الذنب، إذ فهم أن نقل الخبر إلى أخآب قد يجعله كمن دُفع إلى يد ملك يقتله.",
        "theological": "المصدر يبيّن أن عوبديا لا يرفض النبي استخفافا، بل يطلب الإعفاء لأن الطغاة في غضبهم قد يبطشون حتى بالمقرّبين.",
        "deep": "سؤال ما هي خطيتي يكشف توتر رجل أمين يعمل في بلاط شرير؛ فهو يخاف أن تُفسَّر الطاعة للرسالة كخداع يستحق الموت.",
        "applied": "عندما يختلط الواجب بالخطر، لا يلزم إخفاء الخوف؛ عوبديا يصرّح به بصدق ويطلب أن لا يُعرَّض بلا سبب للهلاك."
      }
    },
    "18:10": {
      "reference": "11-1-Kings 18:10",
      "text": "حَيٌّ هُوَ الرَّبُّ إِلهُكَ، إِنَّهُ لاَ تُوجَدُ أُمَّةٌ وَلاَ مَمْلَكَةٌ لَمْ يُرْسِلْ سَيِّدِي إِلَيْهَا لِيُفَتِّشَ عَلَيْكَ، وَكَانُوا يَقُولُونَ: إِنَّهُ لاَ يُوجَدُ. وَكَانَ يَسْتَحْلِفُ الْمَمْلَكَةَ وَالأُمَّةَ أَنَّهُمْ لَمْ يَجِدُوكَ.",
      "summary": "",
      "sources": [
