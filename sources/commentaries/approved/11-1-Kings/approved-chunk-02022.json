      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعرّف إيليا نفسه لعوبديا بلا مواربة، ويحوّل لقب السيد إلى أخآب كما يشرح المصدر، لأن مهمة النبي هنا إعلان الحضور لا طلب الكرامة.",
        "theological": "ظهور إيليا في هذه اللحظة مرتبط بأمر الرب أن يخرج من اختفائه، فالكلام إلى أخآب يبدأ طريق معالجة الضيق بإعلان نبوي مباشر.",
        "deep": "عبارة هوذا إيليا تجعل اللقاء فعلا مقصودا من النبي لا مفاجأة عابرة، لكي يعلم الملك أن إيليا حاضر بإرادته للحديث معه.",
        "applied": "تدعو الآية إلى أمانة الرسالة حين يكلَّف الإنسان بكلام صعب؛ فوضوح إيليا يسبق الخوف ويجعل الخبر محددا لا ملتبسا."
      }
    },
    "18:9": {
      "reference": "11-1-Kings 18:9",
      "text": "فَقَالَ: «مَا هِيَ خَطِيَّتِي حَتَّى إِنَّكَ تَدْفَعُ عَبْدَكَ لِيَدِ أَخْآبَ لِيُمِيتَنِي؟",
