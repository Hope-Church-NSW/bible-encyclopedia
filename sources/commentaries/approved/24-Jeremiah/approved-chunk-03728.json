      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يؤكد العدد أن الملك وعبيده سمعوا كل الكلام، ومع ذلك لم يخافوا ولم يشقوا ثيابهم، فجمع بين اكتمال السماع وغياب الاستجابة.",
        "theological": "يبيّن النص أن التأثر الظاهري ليس هو التوبة؛ فقد يصل الإنذار إلى الأذن دون أن يولّد خوفًا أو انكسارًا أمام الله.",
        "deep": "المشكلة هنا ليست نقص المعلومات، بل انفصال السماع عن القلب؛ فالإنسان قد يعرف خطورة الكلام ثم يرفض أن يتغير بسببه.",
        "applied": "بعد كل قراءة أو عظة، اسأل ما الذي ينبغي أن يتغير فيك عمليًا؛ فالمعرفة التي لا تقود إلى خشوع وتصحيح قد تصبح حجابًا جديدًا."
      }
    },
