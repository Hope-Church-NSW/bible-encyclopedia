      "explanation_lines": {
        "academic": "يسجل العدد أن ألْناثان ودلايا وجمريا ترجوا الملك ألا يحرق الدرج، لكنه لم يسمع لهم، فظهر اختلاف موقفهم عن قراره.",
        "theological": "يبرز النص قيمة الاعتراض على إهانة الرسالة، لكنه يوضح أيضًا أن النصيحة قد تُرفض حين يصر صاحب السلطة على موقفه.",
        "deep": "يقف الرجال الثلاثة عند حدٍّ واضح: لا يستطيعون منع القرار، لكنهم لا يشاركون فيه؛ وهكذا يظهر الفرق بين العجز والموافقة.",
        "applied": "حين ترى رفضًا للحق، قدّم النصيحة بأمانة واحترام، ولا تجعل فشل الآخرين في الإصغاء سببًا لتتخلى أنت عن موقفك المستقيم."
      }
    },
