      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد علامة حسية: مد الرب يده ولمس فم إرميا، ثم فسّر العلامة بإعلان أنه وضع كلماته في فمه.",
        "theological": "المبادرة كلها من الرب: هو يلمس الفم ويضع الكلمات، فتقوم قدرة الرسول على ما يمنحه الرب لا على طلاقته الذاتية.",
        "deep": "تتجاوز العطية المعرفة في الذهن إلى صياغة الكلام نفسه؛ فالرسالة المنسوبة إلى الرب ينبغي أن تُبلَّغ بدقة لا بحسب رغبة المتكلم.",
        "applied": "لا تعتمد على الثقة بالنفس وحدها عند أداء كلمة مأمونة؛ اطلب أمانة التعبير، وامتنع عن تليين الرسالة لتنال قبول السامعين."
      }
    },
