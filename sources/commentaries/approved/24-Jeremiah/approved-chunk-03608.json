      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤمر إرميا أن يقف عند باب بيت الرب، في موضع دخول الشعب إلى الدار الخارجية، حيث يجتمع الداخلون للسجود ويسمعون النداء.",
        "theological": "اختيار باب البيت يبين أن العبادة المعلنة لا تعفي العابدين من الوعظ والتوبيخ؛ فالرب يخاطب من يأتون باسمه لا الغرباء فقط.",
        "deep": "الوقوف عند العتبة يكشف مفارقة حادة: الناس يدخلون للسجود، لكنهم يحتاجون أن يسمعوا كلمة تهدم ثقتهم بالمظاهر الدينية.",
        "applied": "عند الاقتراب من العبادة لا يكفي الحضور؛ ينبغي أن نصغي بتواضع، لأن زمن العبادة نفسه قد يكون أنسب وقت لتصحيح القلب."
      }
    },
