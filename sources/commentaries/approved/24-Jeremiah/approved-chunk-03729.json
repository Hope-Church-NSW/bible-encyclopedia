      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تُوسِّعُ هذه الآيةُ القضاءَ ليشملَ نسلَ يَهُويَاقِيمَ وعبيدَه بسببِ إثمِهم، وتُنزِلَ على سكانِ أورشليمَ ورجالِ يهوذا كلَّ الشرِّ الذي أنذَرَ به الربُّ ولم يُسمَعْ له.",
        "theological": "يُظهِرُ هذا النصُّ أنَّ إثمَ الملكِ لا يبقى محصورًا فيه وحدَه، بل يمتدُّ أثرُه إلى نسلِه وعبيدِه وشعبِه الذين شاركوه في عدمِ الإصغاءِ لكلمةِ الرَّبِّ.",
        "deep": "يُبرِزُ متى هنري أنَّ رفضَ سماعِ الإنذارِ مرارًا هو ما استوجبَ إحلالَ كلِّ الشرِّ المُتكلَّمِ به، فالعقوبةُ هنا ثمرةُ إصرارٍ جماعيٍّ على عدمِ التوبةِ.",
        "applied": "يدعونا هذا النصُّ إلى الانتباهِ لأنَّ عنادَنا في عدمِ الاستماعِ لتحذيراتِ اللهِ قد يجرُّ الشرَّ على من حولِنا لا علينا وحدَنا."
      }
    },
