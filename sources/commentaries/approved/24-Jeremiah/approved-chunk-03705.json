  "verses": {
    "31:29": {
      "reference": "24-Jeremiah 31:29",
      "text": "فِي تِلْكَ الأَيَّامِ لاَ يَقُولُونَ بَعْدُ: الآبَاءُ أَكَلُوا حِصْرِمًا، وَأَسْنَانُ الأَبْنَاءِ ضَرِسَتْ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc4/OEBPS/mhc4.Jer.xxxii.html"
          ],
          "ranges": [
            "24-Jeremiah 31:1-40"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينهي القول المأثور عن الحصرم مرحلةً كان الأبناء فيها يصفون أنفسهم متأثرين بخطايا الآباء، في سياق وعدٍ بزوال المعاملة القومية الشديدة.",
        "theological": "يعلن الوعد أن الله يضع حدًا لسبب الشكوى من انتقال العقوبة، ممهّدًا لإظهار عدله في محاسبة الشخص بحسب طريقه هو.",
        "deep": "صورة الأسنان التي تضرس من حصرم لم يأكله صاحبها تكشف مرارة الإحساس بعواقب موروثة؛ والوعد ينقل النظر من التذمر إلى المسؤولية الشخصية.",
        "applied": "لا تجعل أخطاء من سبقوك عذرًا لتعطيل التوبة والطاعة؛ اعترف بأثر الماضي، لكن واجه أمام الله ما تفعله أنت اليوم."
      }
    },
    "31:30": {
      "reference": "24-Jeremiah 31:30",
      "text": "بَلْ كُلُّ وَاحِدٍ يَمُوتُ بِذَنْبِهِ. كُلُّ إِنْسَانٍ يَأْكُلُ الْحِصْرِمَ تَضْرَسُ أَسْنَانُهُ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc4/OEBPS/mhc4.Jer.xxxii.html"
          ],
          "ranges": [
            "24-Jeremiah 31:1-40"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تفسر الآية المثل السابق بإسناد الموت والنتيجة إلى ذنب كل واحد، وتعيد صورة الحصرم لتؤكد أن من يأكله هو الذي تضرس أسنانه.",
        "theological": "الخلاص العام الموعود للشعب لا يمنح الفرد حصانة من الحساب؛ فالله يواصل محاسبة من يثيره على إثمه الشخصي.",
        "deep": "يربط التشبيه بين فعل الخطيئة ومرارتها اللاحقة: ما يبدو مرغوبًا قد يصير حصرمًا مؤلمًا، فتظهر في الإنسان ثمرة اختياره نفسه.",
        "applied": "افحص اختياراتك بدل تعليق اضطرابك كله على الأسرة أو المجتمع؛ فالتوبة الصادقة تبدأ بتسمية الذنب الذي صنعته أنت."
      }
    },
    "31:31": {
      "reference": "24-Jeremiah 31:31",
      "text": "«هَا أَيَّامٌ تَأْتِي، يَقُولُ الرَّبُّ، وَأَقْطَعُ مَعَ بَيْتِ إِسْرَائِيلَ وَمَعَ بَيْتِ يَهُوذَا عَهْدًا جَدِيدًا.",
      "summary": "",
      "sources": [
