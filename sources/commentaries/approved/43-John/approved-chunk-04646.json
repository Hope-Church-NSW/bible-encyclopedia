      "explanation_lines": {
        "academic": "يجيب يسوع بأن ساعة آتية لن يكون فيها هذا الجبل ولا أورشليم الموضع المحدد للسجود للآب.",
        "theological": "يبقى الله الآب موضوع العبادة، لكن الآية تنزع مركزية المكان من السؤال الذي شغل المرأة بين الموضعين.",
        "deep": "تضع الآية النزاع المكاني تحت علامة الزوال، فتدعو إلى تمييز ما هو عابر مما هو جوهري في العبادة.",
        "applied": "حين يستنزفنا خلاف حول المكان أو المظهر، فلنهدأ ونتذكر أن قيمة العبادة لا تتوقف على تفضيل موضع بعينه."
      }
    },
