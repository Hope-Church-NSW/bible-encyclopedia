      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعلن يسوع أن الساعة حاضرة وآتية، وأن الساجدين الحقيقيين يسجدون للآب بالروح والحق، والآب يطلبهم.",
        "theological": "تحدد الآية الساجدين الحقيقيين بحالهم الداخلية وصدقهم، لا بمجرد موقعهم أو شكلهم الخارجي في العبادة.",
        "deep": "قول الآية إن الآب يطلب مثل هؤلاء يبين أن العبادة الروحية الصادقة ليست أمرًا ثانويًا بل ما يطلبه الله.",
        "applied": "عند العبادة، لنفحص حضور القلب وصدق القصد: هل نتوجه إلى الله لتمجيده أم نكتفي بأداء ظاهر يراه الناس؟"
      }
    },
