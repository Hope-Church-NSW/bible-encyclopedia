      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يؤرخ الكاتب المشهد بقرب الفصح، عيد اليهود، ولا يفيد تعبير «بعد هذا» أن الوقائع جاءت مباشرة بعد ما سبق في السرد.",
        "theological": "قرب العيد يضع الحدث في زمن استعداد وترقب، ويبرز قيمة الانتباه إلى فرص سماع كلمة يسوع قبل انقضائها.",
        "deep": "الإشارة إلى عيد قريب تجعل الزمن جزءا من الرواية؛ فالفرصة الروحية ليست فكرة مجردة بل لحظة ينبغي إدراكها واستثمارها.",
        "applied": "عندما تقترب مناسبة للعبادة أو للتعلم، استعد لها مسبقا بالانشغال بكلمة المسيح بدلا من ترك الفرصة تمر بلا انتباه."
      }
    },
