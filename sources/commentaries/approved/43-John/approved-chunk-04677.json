      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعلن يسوع أنه نور العالم ما دام فيه، فيأتي القول ضمن سياق عمله على فتح عيني رجل عاش في الظلمة منذ مولده.",
        "theological": "النور في هذا السياق ليس فكرة مجردة، بل حضور فاعل يقود إلى الشفاء ويمنح القدرة على رؤية ما كان محجوباً.",
        "deep": "تتضح وظيفة النور حين يقابل عيوناً مغلقة؛ فالإعلان لا يكتفي بإزالة الظلمة، بل يهيئ لاختبار رؤية جديدة.",
        "applied": "اطلب توجيه الحق في قراراتك، واسمح للنور أن يكشف ما يحتاج إلى تصحيح، ثم تصرف وفق ما يتضح لك بدلاً من البقاء في الحيرة."
      }
    },
