      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعبّر يسوع عن ضرورة إنجاز أعمال من أرسله خلال النهار، ويقابل فرصة العمل المحدودة بليل لا يستطيع فيه أحد أن يعمل.",
        "theological": "العمل هنا مرتبط بالإرسال وبالوقت المعين؛ لذلك لا يقدّم يسوع الخدمة كخيار عابر، بل كمسؤولية ينبغي إنجازها في أوانها.",
        "deep": "صورة النهار والليل تجعل الزمن مورداً محدوداً، وتحوّل إدراك النهاية القادمة إلى دافع للجدية بدلاً من الركون إلى التأجيل.",
        "applied": "استثمر الفرص الحالية لفعل الخير وإتمام المسؤوليات؛ فما يمكن إنجازه اليوم قد لا يبقى متاحاً بالظروف نفسها غداً."
      }
    },
