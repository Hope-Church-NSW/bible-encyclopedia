      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح هنري أن يسوع بيّن أن الصوت لم يأتِ لأجله شخصيًا بل لأجل السامعين، إذ لو كان لأجله لكفى أن يُهمس في أذنه.",
        "theological": "ما قيل من السماء عن يسوع ومجد الآب فيه إنما قيل لكي يُدفع السامعون إلى التسليم له والاتكال عليه إيمانًا.",
        "deep": "العون الممنوح ليسوع في ساعته يمتد ليصير عزاءً لتلاميذه الذين سيتبعونه في الآلام فيما بعد بذات الروح.",
        "applied": "لنا أن نستمد التشجيع مما وهبه الله ليسوع في ضيقه، فنثبت حين تدعونا تلمذتنا إلى احتمال شدائد من أجله."
      }
    },
