      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يلاحظ هنري أن الجمع انقسم بين قول إنه رعد وقول إن ملاكًا كلّمه، مع أن الصوت كان واضحًا مسموعًا حتى لغير المؤمنين به.",
        "theological": "هذا التردد يكشف نفورًا من قبول برهان جليّ على إرسالية المسيح، فالله يتكلم مرة ومرتين والإنسان لا يتنبّه.",
        "deep": "محاولة تفسير الصوت السماوي بأسباب طبيعية أو وسيطة تُظهر كيف يهرب القلب غير المستعد من مواجهة كلام الله المباشر.",
        "applied": "يدعونا هذا إلى فحص أنفسنا لئلا ننسب علامات عمل الله في حياتنا إلى صدفة أو تفسير عابر بدل الاعتراف به."
      }
    },
