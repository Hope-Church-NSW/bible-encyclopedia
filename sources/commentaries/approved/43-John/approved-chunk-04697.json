      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر هنري أن الصوت الآتي من السماء كرامة خُصّت بها استجابة يسوع وحده، إذ لم يرد نظيرها إلا في شهادتي المعمودية والتجلي.",
        "theological": "طلب يسوع «مجّد اسمك» هو تسليم آلامه لمجد الله، إذ يعرض نفسه عوضًا يوفي عدل الله المُهان بالخطية بدل الخاطئ.",
        "deep": "جوابا الآب «مجّدت وأمجّد أيضًا» يشيران إلى مجد ظهر في حياة يسوع وتعاليمه، وسيظهر أعظم في آلامه وموته الآتي.",
        "applied": "إجابة الآب المؤكدة تشجع كل نفس مهمومة على أن تسلّم قلقها لله راجية أنه سيتمم مجده فيما يبدو ظلامًا الآن."
      }
    },
