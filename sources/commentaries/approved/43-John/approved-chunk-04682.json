      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقابل العدد المتسلل بالشخص الذي يدخل من الباب، ويعرّفه بوضوح بأنه راعي الخراف.",
        "theological": "الدخول من الباب علامة سلطة صحيحة ورعاية أصيلة؛ فالراعي يأتي ليؤدي للخراف خدمة نافعة لا ليستغلها.",
        "deep": "تربط المقارنة بين صحة الطريق وصحة القصد، فلا تنفصل هوية الراعي عن كيفية اقترابه من القطيع.",
        "applied": "تدعو الآية إلى تقدير القيادة التي تظهر أمانتها في سلوك واضح وفي عناية حقيقية بمن اؤتمنت عليهم."
      }
    },
