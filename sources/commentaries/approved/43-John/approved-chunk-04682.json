      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعدد العدد أفعال الراعي المتتابعة: يفتح له البواب، وتسمع الخراف صوته، ويدعو خرافه بأسمائها ويخرجها.",
        "theological": "تظهر العلاقة هنا معرفة شخصية وعناية دقيقة؛ فالراعي لا يعامل خرافه كجماعة مجهولة بل يلحظ كل واحدة.",
        "deep": "الصوت والاسم والقيادة ترسم اتصالًا يعرف فيه الراعي خرافه ويقودها خارج الحظيرة إلى ما تحتاجه.",
        "applied": "يشجع النص على الإصغاء للقيادة الصادقة وعلى ممارسة عناية شخصية بمن تقع مسؤوليتهم في نطاقنا."
      }
    },
