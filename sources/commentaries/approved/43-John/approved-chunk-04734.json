      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد النص فعل سمعان بطرس في جذب الشبكة إلى البر، ويذكر عدد السمك الكبير، ثم يبرز أن كثرتها لم تمزق الشبكة.",
        "theological": "يفسر متى هنري كثرة الصيد كعلامة على قوة يسوع وعنايته بحاجات تلاميذه، مع بقاء الشبكة سليمة رغم الامتلاء.",
        "deep": "يجمع العدد بين وفرة ملموسة ونظام محفوظ؛ فالعطاء الغزير هنا لا يتحول إلى فوضى، بل يصل إلى الشاطئ دون خسارة.",
        "applied": "استقبل الوفرة بمسؤولية جماعية: اسحب الشبكة مع الآخرين، واحفظ ما أُعطي لك، ولا تجعل كثرة النعمة سبباً للتبديد."
      }
    },
