      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يدعو يسوع التلاميذ إلى الطعام بعد وصولهم، ويسجل النص أنهم لم يجرؤوا على سؤاله عن هويته لأنهم كانوا يعلمون أنه الرب.",
        "theological": "يصور المشهد قرب يسوع الودود من تلاميذه بعد قيامته؛ فمعرفته عندهم لا تمنع دعوته لهم إلى الجلوس والطعام.",
        "deep": "يجمع النداء بين المعرفة الصامتة والحضور المشترك: لم يحتاجوا إلى سؤال لفظي، لأن ما عرفوه في الموقف كان أوضح من الاستفهام.",
        "applied": "اترك مجالاً للسكينة أمام حضور الرب؛ فالإيمان لا يُقاس بكثرة الأسئلة فقط، بل أيضاً بالجلوس معه وقبول دعوته."
      }
    },
