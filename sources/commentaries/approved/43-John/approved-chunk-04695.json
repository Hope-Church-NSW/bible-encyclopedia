      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد أفعال الجمع وأقواله معًا: أخذوا سعوف النخل وخرجوا للقائه وهتفوا ببركة الآتي وملك إسرائيل.",
        "theological": "يهتف الجمع ليسوع بصفته ملك إسرائيل الآتي باسم الرب، ويستعمل ألفاظًا كتابية للتعبير عن الترحاب والرجاء.",
        "deep": "الاستقبال هنا ليس صمتًا داخليًا؛ فالسعوف والخروج والهتاف تجعل التقدير المعلن ليسوع فعلًا جماعيًا ظاهرًا.",
        "applied": "دع تقديرك ليسوع يتجاوز المشاعر الخاصة إلى كلمات وأعمال أمينة تعترف به دون خجل أمام الناس."
      }
    },
