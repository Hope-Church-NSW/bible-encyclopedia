      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدّد النص استثناءً واضحًا: لا أحد رأى الآب، إلا الذي هو من الله؛ فهو وحده الذي رأى الآب، فيميّز بين معرفة عامة ومعرفة فريدة مصدرها الله.",
        "theological": "يكشف العدد أن معرفة الآب ليست ثمرة اطلاع بشري مستقل، بل ترتبط بالذي جاء من الله ورأى الآب، ولذلك تُقبل شهادته عن الله بثقة.",
        "deep": "يضع القول حدًا للفضول الديني: لا يكفي أن يتحدث الإنسان عن الله، لأن رؤية الآب ومعرفته هنا منوطة بالذي جاء منه ورآه حقًا.",
        "applied": "حين أطلب معرفة الله، أترك التخمين والتصورات الذاتية، وأصغي بتواضع إلى شهادة الذي يعلن أنه من الله وقد رأى الآب."
      }
    },
