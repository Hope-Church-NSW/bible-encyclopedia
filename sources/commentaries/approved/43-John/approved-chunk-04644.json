      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر النص بئر يعقوب وتعب يسوع من السفر وجلوسه عندها نحو الساعة السادسة، وهي ساعة حر النهار بحسب المصدر.",
        "theological": "يستدل المصدر من تعبه على أنه إنسان حقيقي خاضع لضعفات الطبيعة البشرية المعتادة في السفر.",
        "deep": "يشدد المصدر على تواضعه وفقره في جلوسه على موضع صلب غير مريح، واختياره ما كان في متناول اليد.",
        "applied": "حين تضيق وسائل الراحة، تعلم القناعة وعدم التكلف؛ فالتعب لا يمنعك من التوقف الهادئ والاستعداد لعمل الخير."
      }
    },
