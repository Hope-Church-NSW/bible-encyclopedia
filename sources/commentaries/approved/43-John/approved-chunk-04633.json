      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يورد النص سؤالين متتابعين عن إيليا وعن النبي، ويبيّن أن يوحنا أجاب بالنفي عن التصورات التي أراد السائلون إسقاطها عليه.",
        "theological": "يرفض يوحنا أن يقبل هوية دينية لا تنطبق عليه، مؤكدًا أن أمانة الخادم تتطلب الدقة لا استثمار توقعات الآخرين.",
        "deep": "قد يكون الناس مستعدين لصنع صورة كبيرة عن الشخص، لكن يوحنا لا يسمح لتوقعاتهم أن تعيد تعريف رسالته أو تمنحه مجدًا ليس له.",
        "applied": "لا توافق على وصف يرفعك أو يحددك خطأً؛ صحح الفهم بهدوء، فالأمانة للحقيقة أهم من كسب إعجاب السائلين."
      }
    },
