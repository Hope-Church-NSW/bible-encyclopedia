        "academic": "يقتبس يوحنا صورة الصوت الصارخ في البرية، ويربط خدمته بكلام إشعياء؛ فسلطته التفسيرية مستندة إلى الكتاب لا إلى ادعاء ذاتي.",
        "theological": "وظيفة يوحنا هي الدعوة إلى تقويم طريق الرب، أي تصحيح الفهم الفاسد لطرق الله وتهيئة الناس لسماع رسالته.",
        "deep": "اختياره كلمة «صوت» يعبّر عن التواضع والاعتماد؛ فالصوت وسيلة لإبلاغ الرسالة، وليس موضوع الرسالة النهائي.",
        "applied": "اجعل كلامك نداءً واضحًا إلى الاستقامة، واطلب أن تُفهم خدمتك كوسيلة تقود إلى طريق الرب لا كمنصة لتمجيدك."
      }
    },
