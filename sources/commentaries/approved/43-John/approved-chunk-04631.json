        "theological": "يؤكد المفسّر أن الإنسان لا يحلّ محل النور، فكل مَن يرفع خادماً فوق المسيح يفسد الهدف الذي من أجله أُرسل الشاهد.",
        "deep": "يُعلّم هذا الموضع أن الحضور الإلهي لا يتبدل في صورة بشرية، بل يظل في رسالته لا في كرامة المرتبطين به.",
        "applied": "يُحذّر النص من إضفاء ألوهية على القادة أو المعلّمين، لأن التقدير الصحيح للخدمة يكون بانحيازها إلى المسيح لا إلى ذاتها."
      }
    },
