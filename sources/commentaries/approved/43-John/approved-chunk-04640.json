      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "جاء نيقوديموس ليلًا في لقاء خاص، وخاطب يسوع معلّمًا مرسلًا من الله مستندًا إلى الآيات التي رآها.",
        "theological": "تُقدَّم الآيات هنا بوصفها شهادة تؤيد أن يسوع معلّم من الله، ودعوة إلى قبول تعليمه بجدية.",
        "deep": "يعترف نيقوديموس بما أدركه، لكن الحوار يكشف أن الإعجاب بالآيات لا يكفي دون استقبال ما يعلّمه يسوع.",
        "applied": "اجعل ما تراه من دلائل الحق دافعًا للبحث الصادق والحوار، لا بديلًا عن الاستجابة لتعليم يسوع."
      }
    },
