      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح النص ظهورًا جديدًا ليسوع عند بحر طبرية، ويقدمه بوصفه كشفًا مقصودًا للتلاميذ بعد أحداث القيامة.",
        "theological": "تظهر المبادرة من يسوع نفسه؛ فهو الذي يعلن حضوره لتلاميذه، لا نتيجة توقعهم أو سعيهم في تلك اللحظة.",
        "deep": "اختيار مشهد العمل العادي يوسع إطار الظهور: فالتعرف إلى يسوع لا ينحصر في الاجتماع الرسمي، بل يفاجئهم وسط انتظارهم.",
        "applied": "عند انشغالنا بواجبات مألوفة، لا ينبغي أن نعدها بعيدة عن عناية الرب؛ فالانتظار الأمين لا يلزم أن يكون خاملًا."
      }
    },
