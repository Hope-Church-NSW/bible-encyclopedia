      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد السرد الزمان في اليوم الثالث والمكان في عرس بقانا الجليل، ويذكر حضور أم يسوع قبل وصف دعوة يسوع وتلاميذه.",
        "theological": "اختيار قانا، وهي موضع غير بارز بعيد عن مركز الظهور العام، ينسجم مع عرض يسوع الذي لا يطلب كرامة من الناس.",
        "deep": "يبدأ المشهد بعرس وفرح عائلي عادي، فيبيّن أن الحدث الآتي ينشأ داخل تفاصيل الحياة المشتركة لا في مسرح استعراض.",
        "applied": "أعط للواجبات والعلاقات اليومية وزنها؛ فالحضور الأمين في المناسبات القريبة قد يفتح مجالا لخدمة نافعة وغير متكلفة."
      }
    },
