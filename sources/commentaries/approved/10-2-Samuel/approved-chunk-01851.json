      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "بعد إعلان الغفران، يذكر ناثان قيدا مؤلما: فعل داود أعطى أعداء الرب مادة للشماتة، لذلك يموت الابن المولود له.",
        "theological": "يفسر متى هنري موت الطفل كإظهار لكره الله للخطية حتى في محبوبه، وكدفاع عن كرامته حين صار سقوط داود عثرة للآخرين.",
        "deep": "تكشف الآية أن الغفران لا يمحو بالضرورة العواقب المنظورة؛ فالرحمة تجاه داود تقترن بحكم يفضح خطورة العثرة العامة.",
        "applied": "من ينتسب إلى الله ينتبه أن خطيته لا تبقى شأنا خاصا؛ قد تمنح المقاومين سببا للتجديف وتجر ألما يتطلب تواضعا حقيقيا."
      }
    },
