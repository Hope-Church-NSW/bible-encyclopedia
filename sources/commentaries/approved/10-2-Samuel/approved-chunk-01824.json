      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينسب داود «العظائم» التي أعلنها الرب إليه إلى كلمة الله وإلى ما في قلبه، لا إلى استحقاق العبد أو تدبيره.",
        "theological": "يكشف القول أن مبادرة الله في الوعد والعمل صادرة عن قصده الصالح، وأنه يعرّف عبده بما صنعه وبما وعد به.",
        "deep": "معرفة العبد ليست امتلاكاً لمعلومات عن الله، بل استجابة دهشة أمام أعمال يختار الله أن يكشفها بحسب كلمته.",
        "applied": "حين نرى خيراً في حياتنا، نتعلم أن ننسبه إلى أمانة الله وقصده، وأن نقابل ما يعلنه لنا بالشكر المتواضع."
      }
    },
