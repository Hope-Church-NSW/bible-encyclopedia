      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر النص تاج ملك عمون، بوزنة من الذهب وحجر كريم، يوضع على رأس داود، مع إخراج غنيمة المدينة بكثرة عظيمة.",
        "theological": "يقدّم المصدر هذا التاج مثالاً على مجد دنيوي ناله داود بنعمة الله، لكنه لا ينبغي أن يحجب عنه ثقل الذنب القائم.",
        "deep": "انتقد المصدر تعلّق داود بالتاج النفيس؛ فالقلب المنكسر من الخطيئة لا يجعل الزينة والسلطة مقياساً لكرامته.",
        "applied": "عند نيل تقدير أو مكسب ظاهر، تذكّر أن الامتياز لا يداوي التقصير الأخلاقي؛ قابل النجاح بتواضع ومراجعة صادقة."
      }
    },
    "12:31": {
      "reference": "10-2-Samuel 12:31",
      "text": "وَأَخْرَجَ الشَّعْبَ الَّذِي فِيهَا وَوَضَعَهُمْ تَحْتَ مَنَاشِيرَ وَنَوَارِجِ حَدِيدٍ وَفُؤُوسِ حَدِيدٍ وَأَمَرَّهُمْ فِي أَتُونِ الآجُرِّ، وَهكَذَا صَنَعَ بِجَمِيعِ مُدُنِ بَنِي عَمُّونَ. ثُمَّ رَجَعَ دَاوُدُ وَجَمِيعُ الشَّعْبِ إِلَى أُورُشَلِيمَ.",
