      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقارن داود بين بيت الأرز الذي يسكنه وبين سكن تابوت الله داخل الشقق، ويعرض الأمر على ناثان.",
        "theological": "يكشف هذا التباين عن امتنان داود لما ناله ورغبته في توجيه موارده واهتمامه نحو إكرام الله.",
        "deep": "انزعاج داود ليس رفضًا لبيته، بل إدراكٌ أن راحته الخاصة لا ينبغي أن تحجب اهتمامه بما يخص عبادة الله.",
        "applied": "افحص مواطن راحتك وامتيازاتك، واسأل هل تقودك إلى العطاء والخدمة بدل أن تعزلك عن احتياجات العبادة."
      }
    },
