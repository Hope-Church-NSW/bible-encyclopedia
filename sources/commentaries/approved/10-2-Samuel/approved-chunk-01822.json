      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشرح المصدر عبارة الأب والابن كعلاقة تبنٍّ عهدية مع الملك، تشمل الرعاية الأبوية ومسؤولية الابن في الطاعة.",
        "theological": "يجمع الوعد بين القرب الأبوي والتأديب عند الاعوجاج؛ فالتقويم هنا جزء من العلاقة لا نقيض لها.",
        "deep": "يقدّم قضيب الناس والضربات تأديبًا مناسبًا لضعف الإنسان، غايته ردّ المخطئ لا معاملته بقوة ساحقة.",
        "applied": "تدعو الآية المسؤول إلى أن يرى التصحيح الصادق دعوة للرجوع والطاعة، لا مبررًا لرفض العلاقة أو الاستسلام للخطأ."
      }
    },
