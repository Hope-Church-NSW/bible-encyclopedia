      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسرد الرسول وجوه البعد السابق: بلا مسيح، وأجانب عن رعاية إسرائيل، وغرباء عن عهود الموعد.",
        "theological": "يربط الشرح غياب الرجاء الثابت بغياب العلاقة بالمسيح وبالعهود التي تضم وعود الحياة الأبدية.",
        "deep": "وجود معرفة عامة بإله أو ممارسة عبادة لا يساوي معرفة الله الحق ولا الاعتماد عليه ولا الشركة معه.",
        "applied": "افحص أساس رجائك: هل يقوم على وعود الله وعلاقة حقيقية به، أم على معرفة دينية لا تغيّر الاتكال؟"
      }
    },
