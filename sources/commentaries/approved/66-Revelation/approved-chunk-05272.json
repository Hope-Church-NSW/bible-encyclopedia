      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن طوبى الذين يصنعون وصايا المسيح مرتبطة بحقهم في شجرة الحياة ودخولهم المدينة، وهذا يؤكد صدق كلمة الكتاب.",
        "theological": "يرى متى هنري أن المسيح بكلمته هذه يمنح شعبه المتوافقين معها حقًا في شجرة الحياة ودخولًا إلى السماء، فيثبت بذلك سلطان كلامه وصحته.",
        "deep": "يشير متى هنري إلى أن هذه الطوبى تحمل سند الحالة المقدسة والسعيدة المُعدة لشعب الله في السماء، فهي عهد وليست مجرد وعد عابر.",
        "applied": "يدعو هذا القول القارئ إلى العمل بوصايا المسيح لا الاكتفاء بسماعها، لينال الحق في شجرة الحياة ويدخل من الأبواب إلى المدينة، بحسب متى هنري."
      }
    },
