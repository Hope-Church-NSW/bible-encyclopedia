      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشرح متى هنري أن هذا الكتاب المفتوح سيكون له أثر مزدوج: الأشرار والنجسون يزدادون في شرهم، بينما الأبرار والقديسون يتثبتون ويتقدسون أكثر.",
        "theological": "بحسب متى هنري فإن كلمة الله تصير رائحة حياة لبعض ورائحة موت لآخرين، فتثبّت من هو بار وتقدّس من هو مقدس، وتترك الظالم في ظلمه.",
        "deep": "يلاحظ متى هنري أن هذا القول لا يشجع على الاستمرار في الشر بل يصف واقع النفوس أمام النور الإلهي الذي يكشف حال كل إنسان كما هو.",
        "applied": "يدعو هذا النص القارئ إلى فحص حاله أمام كلمة الله، فإما أن يستمر في القداسة والبر أو يزداد رسوخًا في نجاسته وظلمه، بحسب متى هنري."
      }
    },
