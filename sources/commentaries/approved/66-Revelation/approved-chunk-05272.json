      "explanation_lines": {
        "academic": "يشرح متى هنري أن هذا الكتاب يدين ويستبعد من السماء الأشرار وغير الأبرار، وبخاصة الذين يحبون الكذب ويصنعونه، مما يثبت صدقه.",
        "theological": "يرى متى هنري أن استبعاد الكلاب والسحرة والزناة والقتلة وعبدة الأوثان ومحبي الكذب يظهر قداسة هذا الكتاب، فلا يمكن أن يكون هو نفسه كذبًا.",
        "deep": "يلاحظ متى هنري أن ذكر هذه الفئات خارج المدينة يقابل طوبى الذين يصنعون الوصايا في الآية السابقة، فيبرز التباين بين حال الداخلين والخارجين.",
        "applied": "يحذّر هذا النص القارئ من السلوك في هذه الخطايا المذكورة، وأولها محبة الكذب وصنعه، لئلا يجد نفسه خارجًا عن المدينة، كما بيّن متى هنري."
      }
    },
