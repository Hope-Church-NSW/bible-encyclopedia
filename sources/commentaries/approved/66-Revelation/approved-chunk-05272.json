          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير متى هنري إلى أن الملاك يأمر يوحنا بألا يختم على أقوال النبوة لأن الوقت قريب، ويرى أن هذا أمر بترك الكتاب مفتوحًا ليقرأه الجميع ويتأملوا فيه.",
        "theological": "يوضح متى هنري أن الله يتعامل بصراحة وانفتاح مع الناس، فلا يتكلم في الخفاء، بل يدعو كل إنسان ليشهد على ما أعلنه في هذا الكتاب.",
        "deep": "يرى متى هنري أن ترك النبوة مفتوحة يتيح للناس أن يجتهدوا في فهمها وأن يقارنوا كلماتها بالأحداث التي تتحقق مع الزمن.",
        "applied": "يدعونا هذا القول إلى قراءة كلمة النبوة بجدية والتأمل فيها بدل إغفالها، لأن وقت تحققها قريب كما ذكر متى هنري."
      }
    },
    "22:11": {
      "reference": "66-Revelation 22:11",
      "text": "مَنْ يَظْلِمْ فَلْيَظْلِمْ بَعْدُ. وَمَنْ هُوَ نَجِسٌ فَلْيَتَنَجَّسْ بَعْدُ. وَمَنْ هُوَ بَارٌّ فَلْيَتَبَرَّرْ بَعْدُ. وَمَنْ هُوَ مُقَدَّسٌ فَلْيَتَقَدَّسْ بَعْدُ».",
      "summary": "",
