      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن دعوة الروح والعروس للمجيء هي دعوة عامة ومفتوحة لكل من يشعر بعطش في نفسه لا يرويه شيء في هذا العالم.",
        "theological": "يرى متى هنري أن اشتراك الروح مع العروس أي أعضاء الكنيسة الحقيقيين في الدعوة يشهد لصدق الإنجيل وامتيازاته المقدمة مجانًا للجميع.",
        "deep": "يلاحظ متى هنري أن تكرار الدعوة تعالَ وامتدادها لكل عطشان ولكل من يريد يبرز شمول العرض الإلهي وعدم اشتراطه بشيء سوى الإرادة والعطش.",
        "applied": "يدعو هذا النص كل قارئ يشعر بعطش روحي إلى أن يأتي ويأخذ ماء الحياة مجانًا، مستجيبًا لدعوة الروح والعروس كما شرح متى هنري."
      }
    },
