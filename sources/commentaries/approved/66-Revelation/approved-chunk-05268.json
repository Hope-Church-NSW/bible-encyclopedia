      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفسر متى هنري ميراث الغالب لكل شيء بأنه بلوغ منبع كل بركة، فمن يتمتع بالله يتمتع بكل شيء، لأن الله هو الكل في الكل بحسب وصف الشارح لهذه العبارة.",
        "theological": "بحسب الشرح فإن هذا الميراث يكون بحق البنوة، وهو أكرم الألقاب لصلته الوثيقة بالله نفسه، وأثبتها لأنها لا يمكن أن تزول ما دامت العلاقة التي تنبع منها قائمة.",
        "deep": "يوازن متى هنري بين فُرادة العلاقة الأبدية بين الله والغالبين وبين ثباتها التام، فلا يكون الميراث عرضيًا بل مبنيًا على علاقة بنوة راسخة لا تتغير ولا تنقطع أبدًا.",
        "applied": "يُحفَّز المؤمن على الثبات في الغلبة رجاءً في هذا الميراث الكامل، إذ إن التمتع بالله نفسه كافٍ ليغني عن كل شيء آخر، فهو يمنح كل ما يحتاجه المؤمن حقًا وفعلًا."
      }
    },
    "21:8": {
