      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يلاحظ متى هنري أن كل باب من الأبواب الاثني عشر مصنوع من لؤلؤة واحدة، وأن شارع المدينة من ذهب نقي كالزجاج الشفاف، وهو وصف لعظمة المدخل والداخل معًا.",
        "theological": "المسيح هو اللؤلؤة الكثيرة الثمن، وهو الطريق الذي به يصل الناس إلى الآب، فلا مدخل إلى المدينة إلا من خلاله بحسب هذا التفسير.",
        "deep": "القديسون في السماء يدوسون على الذهب ويمشون معًا في شركة كاملة، فخطواتهم كلها ثابتة ونقية كالذهب الشفاف الذي لا شائبة فيه.",
        "applied": "يشجع هذا الوصف المؤمن على الثقة بأن دخوله إلى المجد مؤمّن بالمسيح وحده، وأن حياته في الشركة مع الإخوة تصير أنقى كلما اقترب من الله."
      }
    },
