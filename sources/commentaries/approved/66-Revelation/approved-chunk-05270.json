      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر متى هنري أن أمم الذين خلصوا يسيرون في نور المدينة، وأن ملوك الأرض يحضرون مجدهم وكرامتهم إليها، وهذا وصف لكثرة المخلَّصين وتنوع مراتبهم.",
        "theological": "يشاء الله أن يملأ مساكن السماء من جميع رتب الناس ودرجاتهم، عظماء وصغارًا، فلا يُستثنى أحد من دخولها بحسب مقامه الأرضي.",
        "deep": "حين يصل أعظم الملوك إلى المجد يرون أن كل كرامتهم السابقة قد ابتلعها هذا المجد السماوي الذي يفوقها فوقًا عظيمًا لا يُقاس.",
        "applied": "لا ينبغي أن يفتخر أحد بمكانته الدنيوية، بل يسعى ليكون من بين الأمم المخلَّصة السائرة في نور المدينة مهما كان مقامه في هذه الحياة."
      }
    },
