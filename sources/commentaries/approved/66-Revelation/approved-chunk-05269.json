        "academic": "تصف المدينة بأنها مربعة الشكل، ومقاساتها متساوية في الطول والعرض والارتفاع، فالتناسق يبرز كمال ترتيبها.",
        "theological": "يعكس التساوي بين الأبعاد استقامة المدينة ووضوح نظامها، إذ لا يوجد فيها تضخم أو نقص في ما يليق بمجد الرب.",
        "deep": "يمثل الشكل الرباعي التوازن بين الهداية والسكينة، فلا اضطراب فيها، بل هي منظومة كاملة في نظامها الداخلي.",
        "applied": "يؤكد هذا الوصف أن حياة من يثبت في المدينة لا تكون متقلبة بل متوازنة، لأن الرب يضع فيها معيارًا متكاملًا."
      }
    },
