      "explanation_lines": {
        "academic": "تركز الآية على رؤيتهم وجهه ووضع اسمه على جباههم، وهما علامتان للمعاينة والاعتراف بالانتماء.",
        "theological": "يفسر المصدر رؤية الوجه بأسمى سعادة تلك الحالة، ووجود الاسم بأن الله يقرهم كمن عليهم ختمه وملكيته.",
        "deep": "الوجه والاسم يجمعان القرب والقبول؛ فالسعادة ليست في المكان وحده بل في معرفة الله العلنية لأخاصته.",
        "applied": "تدعو الآية إلى طلب رضا الله فوق كل علامة بشرية، لأن الكرامة الحقيقية أن يعرف الله عبيده ويعلن انتماءهم له."
      }
    },
