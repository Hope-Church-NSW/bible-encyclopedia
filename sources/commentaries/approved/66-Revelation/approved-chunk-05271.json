      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تجمع الآية بين نفي اللعنة ووجود عرش الله والخروف وخدمة العبيد، فتجعل طهارة المكان أساس العبادة فيه.",
        "theological": "غياب اللعنة هو امتياز هذا الفردوس الكامل؛ فلا مجال هناك لما يبعد العبيد عن خدمة الله أو يزعجهم فيها.",
        "deep": "ليست الحرية في الآية فراغا من الشر فقط، بل حضورا للعرش يثبت الخدمة ويجعل العبادة آمنة من كل اضطراب.",
        "applied": "تدعو الآية إلى تقدير الخدمة لله كغاية مكرمة، حيث يزول كل ما يفسد العبادة أو يحول القلب عن سيده."
      }
    },
