      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يركز المشهد على سفر في يمين الجالس على العرش؛ يفسره المصدر كسجل مقاصد العناية الإلهية الثابتة تجاه الكنيسة والعالم.",
        "theological": "وجود السفر في اليد اليمنى يعلن سلطان الله على محتواه واستعداده لتنفيذ ما سطر فيه من مشورات وأغراض.",
        "deep": "كونه مكتوبا من داخل ومن وراء ومختوما بسبعة ختوم يصور كمال التدبير مع بقاء سره محجوبا عن إدراك المخلوق.",
        "applied": "تدعو الآية القارئ إلى الاتضاع أمام ما لم يكشف بعد، والثقة بأن المقاصد المضبوطة محفوظة في يد صاحب العرش."
      }
    },
