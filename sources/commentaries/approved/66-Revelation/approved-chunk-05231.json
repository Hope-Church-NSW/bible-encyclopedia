      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تعدد المواضع: في السماء وعلى الأرض وتحت الأرض، يؤكد فحصا شاملا انتهى بعجز كل المخلوقات عن فتح السفر أو النظر إليه.",
        "theological": "حتى الملائكة والأنبياء والحكماء لا ينفذون إلى مراسيم الله إلا بقدر ما يكشفه هو؛ فالمعرفة النهائية تخصه وحده.",
        "deep": "العجز عن النظر فضلا عن الفتح يكشف عمق السر؛ ليست المشكلة نقص فرصة، بل محدودية الخليقة أمام المشورة الإلهية.",
        "applied": "تعلم الآية ترك الغرور المعرفي؛ فبعض أبواب التدبير لا تفتحها العبقرية ولا الخبرة، بل الإذن الإلهي وحده."
      }
    },
