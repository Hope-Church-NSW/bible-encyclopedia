      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "رفض الملاك الطعام وأوضح أن أي تقدمة يجب أن توجّه لله وحده، وأنه كملاك لا يحتاج إلى الطعام والشراب.",
        "theological": "توجيه العبادة والتكريم إلى الله وحده لا إلى رسله، وأن جميع القرابين والتقدمات يجب أن تُصرف نحو الخالق سبحانه.",
        "deep": "إصرار الملاك على تحويل القربان إلى الله يعلّم الدرس أن أي عمل من أعمال الطاعة والتقديس يجب أن يكون موجّهًا نحو الله وليس نحو المخلوقات.",
        "applied": "يجب على المؤمن أن يكون حذرًا من جعل المخلوقات محلّ التبجيل والعبادة، وأن يوجّه كل عمل من أعماله نحو رضا الله الوحيد."
      }
    }
