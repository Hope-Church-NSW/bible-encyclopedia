      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأخذ منوح جدي المعزى والتقدمة ويصعدهما على الصخرة للرب، فيما يشاهد هو وامرأته العمل العجيب.",
        "theological": "ينفذ منوح التوجيه بتحويل ما أُعد للضيافة إلى تقدمة للرب، ويأتي الفعل العجيب مصاحبًا لهذه التقدمة.",
        "deep": "يظهر الزوجان شاهدين لا صانعين للآية؛ فدورهما هو الطاعة والتأمل فيما يفعله الله أمامهما.",
        "applied": "تدعونا الآية إلى تحويل الامتنان إلى طاعة موجّهة لله، وإلى التوقف بتوقير حين تتجاوز أعماله قدرتنا على التفسير."
      }
    },
    "13:20": {
      "reference": "07-Judges 13:20",
      "text": "فَكَانَ عِنْدَ صُعُودِ اللَّهِِيبِ عَنِ الْمَذْبَحِ نَحْوَ السَّمَاءِ، أَنَّ مَلاَكَ الرَّبِّ صَعِدَ فِي لَهِيبِ الْمَذْبَحِ، وَمَنُوحُ وَامْرَأَتُهُ يَنْظُرَانِ. فَسَقَطَا عَلَى وَجْهَيْهِمَا إِلَى الأَرْضِ.",
      "summary": "",
