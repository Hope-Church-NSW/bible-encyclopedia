        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع السرد أمر جدعون ليثر بكره في مقابلة مباشرة مع امتناع الغلام: لم يخترط سيفه، ويعلل النص ذلك بخوفه وحداثة سنه.",
        "theological": "يرى التفسير أن جدعون أراد من ابنه، لقربه من المقتولين، أن ينوب عنه ويتدرب على العدل والجرأة، لكن حداثته حالت دون التنفيذ.",
        "deep": "يكشف خوف يثر أن شجاعة الأب لا تنتقل تلقائيا إلى الابن؛ فالقرب العائلي والمكانة لا يلغيان أثر السن وقلة الاعتياد.",
        "applied": "تنبه الآية إلى ألا نفترض استعداد الشاب لمهمة ثقيلة لمجرد نسبه؛ فالمسؤولية تحتاج نضجا وتدريبا يناسبان صعوبتها."
      }
    }
