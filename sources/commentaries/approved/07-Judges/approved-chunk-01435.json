      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "انتقل جدعون من سكوت إلى فنوئيل وكرر طلبه، لكن أهل فنوئيل أعادوا الجواب نفسه، فامتد رفض إمداد رجاله من مدينة إلى أخرى.",
        "theological": "كرر أهل فنوئيل خطية سكوت، إذ امتنعوا عن مساندة من أقامه الله لخلاص إسرائيل وأغلقوا الرحمة عن رجال يلاحقون العدو المشترك.",
        "deep": "يبين تشابه الجوابين كيف يمكن لموقف قاس أن يتكرر جماعيا: رأى أهل فنوئيل حاجة المتعبين وسمعوا الطلب، لكنهم اختاروا منطق الرفض ذاته.",
        "applied": "لا تتبن موقف الجماعة لمجرد أنه سبقك إليه آخرون؛ قيّم الطلب العادل بنفسك، واختر إسناد المتعبين بدلا من تكرار قسوة المحيطين بك."
      }
    }
