      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "انقطاع ظهور ملاك الرب يحدد نهاية اللقاء الخاص؛ فالإرسال كان لمناسبة معينة لا لعلاقة مستمرة كعلاقة الأنبياء.",
        "theological": "معرفة منوح جاءت بعد العلامة العجيبة؛ لم يعد يرى رجلا عاديا بل رسولا سماويا أعلن قبول التقدمة وصعد في اللهيب.",
        "deep": "صمت الظهور اللاحق لا يلغي صدق الرسالة، بل ينقل الثقل إلى تذكّر ما قيل وحفظه دون طلب إشارات جديدة.",
        "applied": "حين تنتهي لحظة إعلان واضحة، لا يلزم انتظار تكرارها؛ الأمانة تكون في حفظ التعليم المعطى والعمل به."
      }
    },
    "13:22": {
      "reference": "07-Judges 13:22",
      "text": "فَقَالَ مَنُوحُ لامْرَأَتِهِ: «نَمُوتُ مَوْتًا لأَنَّنَا قَدْ رَأَيْنَا اللهَ»",
      "summary": "",
