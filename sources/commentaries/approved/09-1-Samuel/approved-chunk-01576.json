      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يورد النص سؤال عالي المباشر لابنيه عن سبب هذه الأفعال، ويبين أن مصدر علمه هو سماعه بأمورهم الخبيثة من جميع الشعب.",
        "theological": "تظهر كلمة عالي أن الشر المبلغ عنه لا يصير مقبولا بتكراره، بل يبقى فعلا خبيثا يستوجب توبيخا داخل البيت المسؤول.",
        "deep": "يجمع السؤال بين صلة الأبوة ووضوح الإدانة: فهو يخاطب ابنيه، لكنه لا يخفف وصف ما وصل إليه من شهادة الناس عن أعمالهما.",
        "applied": "تعلم الآية أن المحبة لا تعني الصمت عن الشر؛ فالمسؤولية تقتضي تسمية الخطأ بوضوح ومواجهة أثره عندما تتواتر الشهادات."
      }
    },
