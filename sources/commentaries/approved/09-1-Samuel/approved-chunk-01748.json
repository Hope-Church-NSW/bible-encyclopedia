      "explanation_lines": {
        "academic": "رفض داود قتل شاول لأنه المسيح المعين من الرب ملكاً على إسرائيل بتعيين إلهي مباشر.",
        "theological": "لمس المسيح الرب بالأذى يعتبر إساءة لنظام الله الإلهي ويستوجب الذنب أمام الله.",
        "deep": "فضّل داود ضميره وبراءته على سلامته الشخصية ورغبته في الملك، مظهراً أولوية الأمانة الأخلاقية.",
        "applied": "احترام السلطة المشروعة يحفظ نقاء المؤمن الروحي حتى وسط الظروف الحاسمة."
      }
    },
