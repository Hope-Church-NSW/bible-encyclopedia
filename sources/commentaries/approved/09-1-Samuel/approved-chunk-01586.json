      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أرسل الشعب إلى شيلوه فجلبوا تابوت عهد رب الجنود الجالس على الكروبيم، وكان حفني وفينحاس معه.",
        "theological": "كان التابوت علامة منظورة لحضور الله بحسب التعيين، لكن نقله لم يمنحهم حقًا مضمونًا في المعونة أو النصرة.",
        "deep": "يرى المفسر أنهم أهانوا الله إذ ظنوا أن الصندوق المقدس يعمل بذاته، وأن حضور ابني عالي لا يوافق انتظار البركة.",
        "applied": "لا تتعامل مع الرموز والممارسات المقدسة كضمان آلي للنجاح؛ فالمظهر الديني لا يغني عن احترام الله والطاعة له."
      }
    }
