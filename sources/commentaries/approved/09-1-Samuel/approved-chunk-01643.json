      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص الممر المؤدي إلى حرس الفلسطينيين بين سني صخرة حادتين، ويسميهما بوصيص وسنه، مبرزًا الطبيعة الوعرة لطريق يوناثان.",
        "theological": "يفهم المفسر صعوبة الصخور بوصفها عائقًا لم يطفئ عزيمة يوناثان؛ فالمقاومة الظاهرة زادت قراره صلابة بدل أن ترده عن مقصده.",
        "deep": "لا يختصر السرد المسافة إلى هدف يوناثان، بل يرسم ضيق المعابر وحدّة جانبيها، ليبين أن مبادرته واجهت عائقًا طبيعيًا قبل مواجهة الحرس.",
        "applied": "تشجع الآية على تقدير صعوبة الطريق بواقعية دون الاستسلام لها؛ فوضوح العقبات يمكن أن يشحذ العزم ويهيئ الإنسان لعبورها بثبات."
      }
