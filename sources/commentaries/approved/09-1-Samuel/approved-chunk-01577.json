      "explanation_lines": {
        "academic": "يفتتح رجل الله رسالته إلى عالي بسؤال يستدعي ظهور الرب لبيت أبيه في مصر، فيجعل العطية السابقة أساسًا للمحاسبة اللاحقة.",
        "theological": "يفسر المصدر إرسال الرسالة إلى عالي نفسه بوصفه دعوة إلى التوبة، إذ إن تساهله مع أبنائه أسهم في تقوية أيديهم في الشر.",
        "deep": "الاقتراب من موضع العبادة والامتياز العائلي لا يحصنان من التوبيخ؛ بل يجعل الإهمال في أداء الواجب موضع مساءلة أشد.",
        "applied": "حين يمنحنا موقعنا قدرة على كبح الخطأ، لا يكفي الاستياء الداخلي؛ فالتراخي الذي يترك الشر بلا ضبط يشارك في نتائجه."
      }
    },
