      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُسجّل القول طمأنة يوناثان لداود بأن يد شاول لن تصل إليه، مع إعلان مُلك داود ورضا يوناثان بأن يكون ثانيًا له.",
        "theological": "يقوّي يوناثان يد داود في الله، فيربط الأمان لا بقدرتهما على التصرف بل بوعد الله وخبرات عنايته السابقة.",
        "deep": "يتجلى في تنازل يوناثان عن حقه المتوقع في المُلك صدقُ صداقة لا تنافس فيها؛ فهو يفرح بتقدم داود بدل أن يعدّه خصمًا.",
        "applied": "عند الخوف، تحتاج النفس إلى صديق يذكّرها بأمانة الله لا إلى وعود بشرية فارغة؛ والمحبة الصادقة تفرح بخير الآخر."
      }
    },
    "23:18": {
      "reference": "09-1-Samuel 23:18",
      "text": "فَقَطَعَا كِلاَهُمَا عَهْدًا أَمَامَ الرَّبِّ. وَأَقَامَ دَاوُدُ فِي الْغَابِ، وَأَمَّا يُونَاثَانُ فَمَضَى إِلَى بَيْتِهِ.",
