        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل هنري أن عالي، بعدما أدرك أن الرب هو الذي ينادي الغلام، أرشد صموئيل إلى الجواب الصحيح: \"تكلم يا رب لأن عبدك سامع\"، وهذا نصح صادق رغم أن الكرامة انتقلت من عالي إلى الغلام.",
        "theological": "يبرز متى هنري أن عالي، مع أن نداء الرب تجاوزه إلى صموئيل، لم يحسد الغلام بل بذل جهده الصادق لإعانته على تلقي الوحي، فأعطاه أفضل ما عنده من إرشاد.",
        "deep": "يلاحظ هنري أن عالي علّم صموئيل أن يسمي نفسه عبد الرب وأن يهيئ قلبه للاستماع، فالرب يتكلم حين يتهيأ الإنسان فعلاً للإصغاء إلى كلامه.",
        "applied": "يدعو هنري إلى أن يُلقَّن الأولاد كلمات التقوى منذ الصغر، فتُعدّهم مثل \"تكلم يا رب\" للتعرف على أمور الله وللسلوك في حضرته بقلب مُصغٍ."
      }
    },
    "3:10": {
      "reference": "09-1-Samuel 3:10",
      "text": "فَجَاءَ الرَّبُّ وَوَقَفَ وَدَعَا كَالْمَرَّاتِ الأُوَلِ: «صَمُوئِيلُ، صَمُوئِيلُ». فَقَالَ صَمُوئِيلُ: «تَكَلَّمْ لأَنَّ عَبْدَكَ سَامِعٌ».",
