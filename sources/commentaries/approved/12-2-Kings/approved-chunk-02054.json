      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح العدد بإعلان الحدث المرتقب، ثم يضع إيليا وأليشع في حركة مشتركة من الجلجال قبل وقوع الإصعاد في العاصفة.",
        "theological": "ينسب النص المبادرة إلى الرب؛ فهو الذي عزم أن يصعد إيليا إلى السماء، وفي ذلك تكريم إلهي لخدمته وأمانته السابقة.",
        "deep": "يجمع المشهد بين اقتراب مفارقة استثنائية واستمرار الرفقة الهادئة، فكأن الرحلة الأخيرة تهيئ إيليا وأليشع لما قرره الرب.",
        "applied": "يدعو اقتراب نهاية مرحلة نافعة إلى مواصلة السير بأمانة، واستثمار الوقت الباقي في نقل الخبرة والتشجيع والبركة."
      }
    },
    "2:2": {
      "reference": "12-2-Kings 2:2",
      "text": "فَقَالَ إِيلِيَّا لأَلِيشَعَ: «امْكُثْ هُنَا لأَنَّ الرَّبَّ قَدْ أَرْسَلَنِي إِلَى بَيْتِ إِيلَ». فَقَالَ أَلِيشَعُ: «حَيٌّ هُوَ الرَّبُّ، وَحَيَّةٌ هِيَ نَفْسُكَ، إِنِّي لاَ أَتْرُكُكَ». وَنَزَلاَ إِلَى بَيْتِ إِيلَ.",
