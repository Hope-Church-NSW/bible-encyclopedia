      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأمر الرب آحاز أن يطلب علامة من الرب إلهه، ويترك له مجال الطلب من العمق أو من العلاء.",
        "theological": "العرض يؤكد صدق الوعد السابق وقدرة الله على تأييده بعلامة يختارها الملك، لا بعلامة مفروضة عليه.",
        "deep": "اتساع مجال العلامة من العمق إلى العلاء يبرز أن العائق أمام اليقين ليس ضيق قدرة الله بل موقف الإنسان.",
        "applied": "عندما يفتح الله أمامك برهانًا يقود إلى الطاعة، لا تجعل الحيرة ذريعة لتأجيل الثقة والاستجابة."
      }
