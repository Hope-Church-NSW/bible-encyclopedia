      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "طلب حزقيا من الله أن ينحني سمعه وينظر، ثم يسمع جميع كلام سنحاريب الذي أرسله ليعيّر الله الحي.",
        "theological": "حرية الوصول إلى الله وحرية الكلام أمامه حق مطلق للشعب المؤمن، خاصة في أوقات الشدة والخطر.",
        "deep": "نشر الرسالة أمام الله لا يعني الشكوى، بل عرض الحقائق الصريحة ليحكم الله بعدل وفقاً لما يراه بعينيه.",
        "applied": "يمكن للمؤمن أن يأتي إلى الله بصراحة تامة، يعرض أمامه التفاصيل كاملة، واثقاً أن الله يرى ويسمع ويعرف."
      }
    },
