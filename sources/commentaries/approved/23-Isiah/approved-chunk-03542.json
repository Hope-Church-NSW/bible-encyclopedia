      "explanation_lines": {
        "academic": "ينتقل العدد من ظن الجماعة إلى إعلان الحمل: أحزاننا وأوجاعنا هي التي حملها، لا ما افترضوه عن استحقاقه.",
        "theological": "يقرر المصدر أن المتفرجين حسبوه مضروبا من الله لذنب خاص، مع أن معاناته كانت لأجل خير الآخرين.",
        "deep": "تكشف كلمة «نحن» انقلاب الفهم: الذين أخطأوا في تفسير آلامه هم أنفسهم أصحاب الأحزان التي حملها.",
        "applied": "لا تفسر الشدة سريعا كدليل إدانة إلهية، وتعلّم أن تتعامل مع ألم الآخرين بتواضع ورحمة بدلا من الاتهام."
      }
    },
