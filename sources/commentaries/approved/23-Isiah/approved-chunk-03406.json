      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصور النص إزالة لسان بحر مصر وضرب النهر إلى سبع سواق، بحيث يعبر الناس فيها بأحذيتهم دون عائق.",
        "theological": "ينسب الفعل كله إلى الرب الذي يهز يده بقوة ريحه، معلنا قدرته على رفع ما يعترض طريق شعبه.",
        "deep": "تحويل المياه التي تفصل إلى معابر يبرز أن العوائق التي تبدو منيعة لا تقف أمام وقت الله لخلاص شعبه.",
        "applied": "عند اشتداد العوائق، يدعو هذا الوعد إلى رفض اليأس والثقة بأن الله قادر أن يفتح طريقا حيث لا يظهر طريق."
      }
    },
