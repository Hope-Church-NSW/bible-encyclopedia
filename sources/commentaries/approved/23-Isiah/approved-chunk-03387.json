      "explanation_lines": {
        "academic": "سؤال الله عن المرسل يعكس حاجة الرب لنبي موثوق يعلن رسالته للشعب في الساعة الحرجة.",
        "theological": "إجابة إشعياء بالتطوع تظهر تسليم النبي الكامل لله بعد رؤية مجده وتطهر شفتيه من الخطية.",
        "deep": "الاستعداد النبوي يتطلب رؤية الحقيقة الإلهية أولاً ثم الموافقة على الرسالة المرهقة بشهادة صادقة.",
        "applied": "الدعوة الإلهية تتطلب من المؤمن أن يرفع يده قائلاً هأنذا بعد شعور عميق بحاجة العالم للكلمة."
      }
    },
