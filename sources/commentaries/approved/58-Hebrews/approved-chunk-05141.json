      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "كان المسكن الأول يسمى القدس، واحتوى المنارة والمائدة وخبز التقدمة؛ وهذه العناصر تحدد ملامح القسم الخارجي من المسكن.",
        "theological": "المنارة تشير إلى الحاجة إلى النور، والمائدة وخبز التقدمة إلى provision مقدَّم في بيت الملك، كما يشرح المصدر.",
        "deep": "وجود النور والطعام في القدس يربط العبادة بالإرشاد والتغذية، فلا يقتصر الاقتراب من الله على المعرفة أو الشعيرة وحدها.",
        "applied": "اطلب نورًا يميز به قلبك، وتغذَّ روحيًا بما يعينك على الثبات؛ فالعبادة السليمة تجمع البصيرة والعناية بالنفس."
      }
    },
