      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد العدد موقع المسكن الثاني وراء الحجاب الثاني، ويسميه قدس الأقداس، مميزًا إياه عن القدس الخارجي.",
        "theological": "كان الحجاب يفصل بين القسمين، ولذلك لم يكن الدخول إلى أقدس موضع متاحًا للكهنة العاديين، بل ارتبط برئيس الكهنة.",
        "deep": "ترتيب المكان يبرز درجات الاقتراب والحدود المفروضة في العبادة القديمة، ويجعل القداسة أمرًا يتطلب احترامًا لا اندفاعًا.",
        "applied": "تعلّم أن القرب من الله ليس استخفافًا؛ اقترب بتواضع، واحترم ما يخص العبادة، ولا تتجاوز حدود دعوتك ومسؤوليتك."
      }
    },
