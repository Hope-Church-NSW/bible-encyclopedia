      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسند الكاتب التحذير إلى قولين كتابيين: الانتقام لله، وهو يجازي؛ والرب سيدين شعبه، فتقوم الحجة على إعلان معروف.",
        "theological": "ينسب النص الدينونة والجزاء إلى الله نفسه، فلا يجعل الثأر حقا فرديا، بل فعلا من أفعال عدله المعلن.",
        "deep": "معرفة قائل الوعد هي أساس رهبة الآية: فالذي يملك الجزاء هو أيضا الذي يفحص شعبه ويميز ما يخفيه الادعاء.",
        "applied": "عند الظلم أو الخيانة، يحررنا النص من طلب الانتقام بأيدينا ويعلمنا أن نترك الجزاء والدينونة العادلة لله."
      }
    },
