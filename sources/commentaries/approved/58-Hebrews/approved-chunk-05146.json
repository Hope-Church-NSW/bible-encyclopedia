      "explanation_lines": {
        "academic": "يستنتج النص أن تقدمة واحدة أكملت إلى الأبد الذين هم في طريق التقديس، بخلاف الكهنوت اللاوي الذي لم يحقق هذه الغاية.",
        "theological": "كفاية التقدمة تمتد إلى الأبد، وهي تمنح المقدسين يقين الخلاص من ذنب الخطية وقوتها وعقوبتها، وتقودهم إلى القداسة والسعادة الكاملة.",
        "deep": "يجمع العدد بين الاكتمال الحاضر والمسار المستمر للتقديس: العمل كامل، والمؤمنون الذين قُدّسوا مدعوون إلى الثبات في هذا الطريق.",
        "applied": "اقترب إلى الله بثقة لا بيأس، وواصل السعي إلى القداسة؛ فاكتمالك لا يلغي النمو، بل يمنحه أساسًا ثابتًا ورجاءً مستمرًا."
      }
    },
