      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تقارن الآية بين دخول الكهنة بدم تيوس وعجول ودخول المسيح بدم نفسه، مرة واحدة، إلى الأقداس مع فداء أبدي.",
        "theological": "يشدد المصدر على أن دخوله ليس سنويًا ولا مؤقتًا؛ فقد نال لا مهلة لعام واحد بل فداءً أبديًا لا يحتاج إلى تكرار.",
        "deep": "قوة الآية في كلمة مرة واحدة: ما كان يتكرر ليعلن النقص يقابله عمل كامل يثبت كفاية الدم الذي به دخل المسيح.",
        "applied": "يدعو هذا النص إلى طمأنينة الضمير؛ فالفداء الذي ناله المسيح ليس عابرًا، بل أساس ثابت للثقة أمام الله."
      }
    },
