      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل العدد متنّاي لبيت يويا ريب، وعزي لبيت يدعيا، بوصفهما من الكهنة البارزين في أيام يوياقيم.",
        "theological": "يؤكد تعاقب ممثلي البيوت أن خدمة الله لا تعتمد على شخص واحد، بل تستمر حين ينهض جيل جديد للأمانة.",
        "deep": "يحفظ الاسمَين في قائمة قد تبدو مقتضبة، غير أن اختيارهما يربط الكرامة الكهنوتية بسيرة خدمة معروفة لجيلهم.",
        "applied": "يدعونا متنّاي وعزي إلى عدم احتقار المسؤوليات المتوارثة، بل إلى ملئها بإخلاص يكرم السابقين وينفع اللاحقين."
      }
    },
