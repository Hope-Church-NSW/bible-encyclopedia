  "verses": {
    "2:1": {
      "reference": "50-Philipians 2:1",
      "text": "فَإِنْ كَانَ وَعْظٌ مَا فِي الْمَسِيحِ. إِنْ كَانَتْ تَسْلِيَةٌ مَا لِلْمَحَبَّةِ. إِنْ كَانَتْ شَرِكَةٌ مَا فِي الرُّوحِ. إِنْ كَانَتْ أَحْشَاءٌ وَرَأْفَةٌ،",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc6/OEBPS/mhc6.Phi.iii.html#Bible_Phil.2.1-Phil.2.11"
          ],
          "ranges": [
            "50-Philipians 2:1-11"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:f-philippi",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "فيلبي",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "أعمال 16:11-40؛ فيلبي 1:1-30؛ 2:1-11؛ 4:10-20"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجمع العدد أربعة دوافع للاتحاد: التعزية في المسيح، وراحة المحبة، وشركة الروح، والأحشاء والرأفة.",
        "theological": "يقدّم التعزية والشركة والرحمة كأسس ظاهرة في حياة المؤمنين، تدفعهم إلى إظهار المحبة بعضهم لبعض.",
        "deep": "النداء لا يكتفي بإثارة العاطفة؛ بل يربط اختبار التعزية والرحمة بمسؤولية أن يصير القلب رحيما تجاه الآخرين.",
        "applied": "حين تختبر تعزية المسيح أو مساندة المحبة، حوّل هذا الاختبار إلى مبادرة رحيمة تخفف عن شخص قريب منك."
      }
    },
    "2:2": {
      "reference": "50-Philipians 2:2",
      "text": "فَتَمِّمُوا فَرَحِي حَتَّى تَفْتَكِرُوا فِكْرًا وَاحِدًا وَلَكُمْ مَحَبَّةٌ وَاحِدَةٌ بِنَفْسٍ وَاحِدَةٍ، مُفْتَكِرِينَ شَيْئًا وَاحِدًا،",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc6/OEBPS/mhc6.Phi.iii.html#Bible_Phil.2.1-Phil.2.11"
          ],
          "ranges": [
            "50-Philipians 2:1-11"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:f-philippi",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "فيلبي",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "أعمال 16:11-40؛ فيلبي 1:1-30؛ 2:1-11؛ 4:10-20"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد تمام فرح الرسول باتحاد الفكر والمحبة والنفس والقصد، لا بمجرد اتفاق شكلي بين المؤمنين.",
        "theological": "وحدة المحبة المتبادلة هي طريق التقارب في الحكم، مع إمكان بقاء اختلافات لا تمس الأمور العظمى.",
        "deep": "لا يطلب النص إلغاء كل تباين في الفهم، بل يطالب بأن تقود المحبة المشتركة الجماعة إلى انسجام في مقصدها.",
        "applied": "عند اختلاف الرأي، ابدأ بحفظ المحبة والسعي إلى القصد المشترك بدلا من دفع مصلحة منفصلة أو خصومة."
      }
    },
    "2:3": {
      "reference": "50-Philipians 2:3",
      "text": "لاَ شَيْئًا بِتَحَزُّبٍ أَوْ بِعُجْبٍ، بَلْ بِتَوَاضُعٍ، حَاسِبِينَ بَعْضُكُمُ الْبَعْضَ أَفْضَلَ مِنْ أَنْفُسِهِمْ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc6/OEBPS/mhc6.Phi.iii.html#Bible_Phil.2.1-Phil.2.11"
          ],
          "ranges": [
            "50-Philipians 2:1-11"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:f-philippi",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "فيلبي",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "أعمال 16:11-40؛ فيلبي 1:1-30؛ 2:1-11؛ 4:10-20"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينهى العدد عن العمل بدافع الخصومة أو المجد الباطل، ويأمر بتواضع يعد فيه كل واحد الآخرين أفضل من نفسه.",
        "theological": "الكبرياء والانفعال خصمان للمحبة؛ فالمسيح جاء ليقتل العداوات ويعلّم شعبه التواضع لا روح المعارضة.",
        "deep": "التواضع هنا ليس إنكار الخير في النفس، بل صرامة في معرفة عيوبها وسخاء في تقدير الخير الموجود في الآخرين.",
        "applied": "قبل الدفاع عن إنجازك أو رأيك، افحص دافعك، واعترف بضعفك، ثم امنح الآخر تقديرا صادقا لخير تراه فيه."
      }
    },
    "2:4": {
      "reference": "50-Philipians 2:4",
      "text": "لاَ تَنْظُرُوا كُلُّ وَاحِدٍ إِلَى مَا هُوَ لِنَفْسِهِ، بَلْ كُلُّ وَاحِدٍ إِلَى مَا هُوَ لآخَرِينَ أَيْضًا.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc6/OEBPS/mhc6.Phi.iii.html#Bible_Phil.2.1-Phil.2.11"
          ],
          "ranges": [
            "50-Philipians 2:1-11"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:f-philippi",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "فيلبي",
          "source_file": "encyclopedia_ar.json",
          "references": [
