      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "قال يسوع إن الذي ينجّس الإنسان ليس ما يدخل، بل ما يخرج من داخله، لأن التنجيس الحقيقي من الجذور الباطنة.",
        "theological": "النجاسة الروحية تنبع من القلب، لا من الطعام، فتظهر في طبيعة الإنسان المتردية قبل أن تُفصح عنها الأفعال.",
        "deep": "الرحلة تبدأ في القلب ثم تتجسد في الكلام والمشي، فالمسألة ليست وسيلة خارجية بل فساد أصيل في الداخل.",
        "applied": "ينبغي التوبة من الحِقد والشر، لأن التغيير الحقيقي يبدأ بمداواة القلب قبل ضبط المظاهر الخارجية."
      }
    },
