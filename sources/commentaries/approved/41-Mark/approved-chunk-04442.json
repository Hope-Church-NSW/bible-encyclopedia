      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "لا يدخل الطعام إلى القلب، بل يمرّ بالجوف ثم يخرج إلى الخلاء، لذلك لا ينجّس ما يُؤكل في ذاته.",
        "theological": "العبارة تعلّم أن الطهارة لا تُقاس بما يدخل من خارج، بل بما يخرج من الفساد الداخلي في الإنسان.",
        "deep": "الروح يحكم على ما يخرج من القلب لا على ما يمرّ بالجسد، فالفصل بين المأكولات والنجاسة هنا واضح.",
        "applied": "يُستبعد الحكم على الناس بحسب مظهريهم، ويُطلب فحص القلب ومراقبة ما يخرج منه في القول والعمل."
      }
    },
