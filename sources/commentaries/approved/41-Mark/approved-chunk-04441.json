      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "المسيح يقرر مبدأ روحياً: ليس الطعام الذي يدخل الجسد بل ما يخرج من القلب هو الذي ينجس الإنسان.",
        "theological": "هذا التعليم ينسف أساس التقاليس الطقسية عن الطعام، ويحول التركيز من الخارج إلى الداخل، من الجسد إلى الروح.",
        "deep": "الآية تفصل بوضوح بين المادية والروحية، وتؤكد أن النجاسة الحقيقية تأتي من القلب الفاسد لا من المادة الخارجية.",
        "applied": "على كل إنسان أن ينظر إلى نفسه بصدق: ما يدخل فمك قد يمر وينسى، لكن ما يخرج من قلبك يعكس حقيقة روحك."
      }
    },
