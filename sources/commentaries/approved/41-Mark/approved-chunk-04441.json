      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "موسى أمر بإكرام الوالدين وتوعد بالموت من يسب أباه أو أمه، وهذا أساس واجب الأبناء نحو والديهم في الشريعة الموسوية.",
        "theological": "الوصية بإكرام الوالدين تعكس أمر إلهي أساسي للمجتمع، وعقوبة السب تبين خطورة الإساءة لمن أنجباك وربياك.",
        "deep": "المسيح يستخدم هذه الآية لتجريد الفريسيين من حجتهم، إذ أنهم بتقاليدهم ألغوا الوصايا الإلهية الأساسية مقابل ابتكارات بشرية.",
        "applied": "على الناس أن يعطوا الوالدين حقهم المادي والمعنوي بكل احترام، وأن لا يدعوا تقاليس مختلقة تحول دون برهم وإعانتهم."
      }
    },
