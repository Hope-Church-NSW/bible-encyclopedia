      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل العدد إدراك يسوع الفوري لما كان الكتبة يفكرون فيه داخل أنفسهم، ثم مواجهته المباشرة لسؤالهم عن سبب هذا التفكير في قلوبهم.",
        "theological": "يرى هنري أن معرفة الأفكار تؤكد قدرة يسوع التي يبرهن بها سلطانه على الغفران؛ فهو لا يجيب على كلمات مسموعة فقط، بل يكشف ما في الداخل.",
        "deep": "يكشف هذا العدد أن القلب ليس منطقة مستترة عن يسوع؛ فهو يعرف الاعتراض قبل أن يتحول إلى كلام، ولذلك يطلب صدقًا داخليًا لا مظهرًا دينيًا فحسب.",
        "applied": "تحدث مع يسوع بصدق في أفكارك الخفية، ولا تبرر المرارة أو الشك بالصمت؛ فالمواجهة الصريحة تفتح الطريق لتصحيح القلب."
      }
    },
