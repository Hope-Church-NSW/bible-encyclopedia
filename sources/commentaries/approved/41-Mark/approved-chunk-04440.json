      "explanation_lines": {
        "academic": "كان اليهود يغسلون أنفسهم عند عودتهم من السوق، ويحافظون على نظافة الأواني والأكواس والآنية النحاسية والأسرّة.",
        "theological": "توسع التقليد ليشمل تطهير كل شيء يلمسه المرء، مما يظهر كيف تتراكم الممارسات البشرية وتتسع بلا حدود.",
        "deep": "هذا الاهتمام المفرط بالنظافة الخارجية عكس اعتقاداً أن القرب من غير الطاهرين يلحق نجاسة، مما قاد لعزلة واجتماعية.",
        "applied": "يعلمنا هذا أن الزهد الحقيقي والطهارة الروحية ليست عن الامتناع الخارجي فقط، بل عن تنقية القلب من الشهوات."
      }
    },
