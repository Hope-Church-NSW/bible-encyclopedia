      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تجمع الفريسيون والكتبة من أورشليم حول يسوع ليراقبوا ممارسات تلاميذه ويفحصوها في ضوء التقاليد الموروثة.",
        "theological": "قدوم هؤلاء المعلمين من بعيد يعكس اهتمامهم بالسيطرة على الممارسات الدينية وفرض سلطتهم على المجتمعات المحلية.",
        "deep": "كان قصد الفريسيين والكتبة خلط الأمور بين الشريعة الموسوية والتقاليد البشرية، مما يظهر الحاجة الإنسانية للسيطرة على الدين.",
        "applied": "يذكرنا هذا المشهد بضرورة فحص دوافعنا عند الدفاع عن الممارسات الدينية، هل نحن نسعى لتمجيد الله أم لفرض سلطتنا."
      }
    },
