      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أجاب يسوع بالاستشهاد من النبي إشعياء، منتقداً نفاق الفريسيين الذين يُكرّمونه بالشفاه بينما قلوبهم بعيدة عنه.",
        "theological": "التمييز بين العبادة الحقيقية والعبادة الباطلة يعتمد على حالة القلب، لا على الممارسات الخارجية والكلمات المنطوقة.",
        "deep": "النفاق ليس مجرد كذب بل هو الفصل التام بين ما يُظهره الإنسان وما يختفي في أعماق نفسه، وهذا أساس كل رياء ديني.",
        "applied": "يجب أن نفحص حقيقية قلوبنا في العبادة، هل نعبد الله حقاً من القلب أم أننا نؤدي طقوساً فارغة لإرضاء الناس."
      }
    },
