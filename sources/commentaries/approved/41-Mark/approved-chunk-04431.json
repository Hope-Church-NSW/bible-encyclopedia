      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن السؤال أن المسيح أحسّ بنزوع القوة من نفسه، فالمعجزة كانت محسوسةً في الداخل قبل أن تُكشف في الخارج، ولا يخفى عليه ما جرى.",
        "theological": "الآية توضح أن النعمة ليست بحاجةٍ إلى إعلانٍ علني ليعرفها صاحبها، لأن المسيح يدرك وقت خروج البركة ومن استقبلها.",
        "deep": "حتى في الزحمة والضغط، بقيت العناية الداخلية حاضرةً، كأن القوة خرجت من مصدرها فاستدعت منه نظرةً دقيقةً إلى من لمس ثوبه.",
        "applied": "لا تظن أن ما جرى في السرّ لا يراه الله، فإن ما يمرّ بينك وبين نعمته لا يخفى عليه حين يفتح الطريق إلى الاعتراف."
      }
    },
