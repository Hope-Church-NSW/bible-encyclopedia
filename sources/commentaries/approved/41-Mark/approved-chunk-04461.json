      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "واجه بارتيماؤس محاولة كثيرين إسكاتَه، لكن السرد يبرز تصاعد صراخه؛ فبدل أن ينقطع نداؤه، كرّر طلب الرحمة بإلحاح أكبر.",
        "theological": "لا يجعل اعتراض الجمع حاجة الرجل أقل استحقاقًا للرحمة؛ بل يبيّن أن بارتيماؤس استمر في التوجه إلى يسوع رغم تثبيط المحيطين به.",
        "deep": "يتحوّل المنع في هذا العدد إلى امتحان للرجاء: الصوت الذي أراد الآخرون خنقه صار أكثر إصرارًا، لأن الحاجة لم تُحلّ بعد.",
        "applied": "لا ينبغي أن نسمح لتثبيط الآخرين أن يمنعنا من طلب العون المشروع؛ كما ينبغي ألا نسكت المحتاج حين يرفع صوته طلبًا للرحمة."
      }
    },
