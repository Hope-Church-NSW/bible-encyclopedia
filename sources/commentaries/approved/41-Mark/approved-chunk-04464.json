      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتذكر بطرس الكلمة السابقة ويلفت انتباه يسوع إلى أن التينة التي لعنها قد يبست، رابطًا القول بالنتيجة المرئية.",
        "theological": "تسجيل تذكر بطرس يبرز أن كلمات يسوع تستحق الحفظ والملاحظة، لأن آثارها تكشف جدية ما يصدر عنه.",
        "deep": "دهشة بطرس ليست وصفًا للشجرة وحدها، بل بداية تعلم من واقعة جعلت الحكم الذي سُمع بالأمس منظورًا في الصباح.",
        "applied": "يساعدنا العدد على مراجعة ما نسمعه بجدية، ثم ملاحظة كيف يختبر الواقع صدق الكلمة بدل تجاهلها بعد لحظتها."
      }
    },
