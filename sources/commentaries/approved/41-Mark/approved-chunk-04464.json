      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يستعمل يسوع صورة الجبل الذي ينتقل إلى البحر ليصف قولًا يصاحبه إيمان بلا شك في القلب وثقة بأن ما يقال يكون.",
        "theological": "يربط العدد فاعلية هذا الكلام بالإيمان وعدم الانقسام الداخلي، لا بمجرد تكرار الطلب أو قوة التعبير اللفظي.",
        "deep": "الصورة لا تجعل الجبل محور الرسالة؛ محورها قلب لا يتردد حين يتكلم ضمن ما يستند إليه إيمانه من كلمة الله.",
        "applied": "بدل الاستسلام أمام الصعوبات الكبيرة، يعلّم العدد أن نرفعها إلى الله بإيمان صادق، لا بقلب منقسم بين الرجاء والشك."
      }
    },
