      "explanation_lines": {
        "academic": "يُفصح النص عن معاناة كثيرة من أطبّاء كثيرين، وأنها أنفقت كل ما عندها ولم تجد فائدة، بل زاد بها المرض سوءاً.",
        "theological": "في هذا السرد يبرز أن قوة البشر لا تكفي عند نقطة الانكسار، وأن الرحمة الحقيقية لا تأتي من الوسائل الإنسانية وحدها.",
        "deep": "الآلام الطويلة تُصيب القلب بالفتور والتعب، فتدفع صاحبتها إلى أن تترك كل أملٍ في العلاج ولا تبقى إلا في حاجةٍ صادقةٍ.",
        "applied": "قد تؤول محاولات الإنسان إلى أن تبقيه في حالة أسوأ، لكن هذا هو الوقت الذي تُفهَم فيه قيمة التوجه إلى الربّ."
      }
    },
