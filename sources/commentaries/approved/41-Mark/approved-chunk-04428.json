      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقول الرجل: «ما لي ولك أيها يسوع، ابن الله العليّ؟» في هذا النداء صدى خوفٍ لا يخفى، إلى جانب اعترافٍ لا يذهب إلى محض التمرد.",
        "theological": "تتجلى هنا حقيقة أن الشر يعرف من يملك السلطان، وإن كان اعترافه مختلطًا بالخوف، فيقرّ بكرامة المسيح وجبروته.",
        "deep": "يُستفاد من هذا النداء أن الشيطان يَعرف اسم المسيح، لكن معرفته لا تُؤدي إلى خلاص، بل إلى رهبةٍ غير مُخلِصة.",
        "applied": "يُحذّرنا هذا من أن المعرفة الخارجية لسلطان الله لا تكفي، بل لا بد من أن تفتح القلب لطلب الرحمة لا لمجرد الرهبة."
      }
    },
