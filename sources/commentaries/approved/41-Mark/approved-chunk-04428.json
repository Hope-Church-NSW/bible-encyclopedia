      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "عندما رأى يسوع من بعيد، ركض واستسلم له في تعظيم، وهو ما يثبت أن حتى الروح الفاسدة تعترف بسلطان من لا يعبأ به البشر.",
        "theological": "هنا يظهر أن محبة الله تُنقذ الإنسان قبل أن يَتحدثَ القوّة، لأن الارتجاع إلى المسيح يكون في لحظةٍ تُعيده إلى سلطانٍ أعلى.",
        "deep": "بتعظيمه ليعظّم صاحب السلطة، تضحى الفوضى سريعة التجلية، ومشهد الرجل المذعور يتحول إلى مشهد طلبٍ للنجاة.",
        "applied": "يعلّمنا هذا أن الإنسان المنهك لا يحتاج فقط إلى ناصحٍ، بل إلى من يراه قادرًا على أن يغيّر ما لا تخرجُه به جهوده."
      }
    },
