  "verses": {
    "1:37": {
      "reference": "41-Mark 1:37",
      "text": "وَلَمَّا وَجَدُوهُ قَالُوا لَهُ: «إِنَّ الْجَمِيعَ يَطْلُبُونَكَ».",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Mark.ii.html#Bible_Mark.1.29-Mark.1.39"
          ],
          "ranges": [
            "41-Mark 1:29-39"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:k-capernaum",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "كفرناحوم",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "متى 4:13-17؛ 8:5-17؛ مرقس 1:21-39؛ يوحنا 6:24-59"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر النص أن التلاميذ وجدوا يسوع بعد خروجه إلى موضع منفرد، فنقلوا إليه خبر إقبال الناس جميعًا عليه وطلبهم حضوره.",
        "theological": "يكشف الخبر أن نجاح الخدمة وكثرة الطالبين لم يغيّرا اتجاه يسوع، إذ ظلّ يميّز بين طلب الناس وبين الغاية التي جاء من أجلها.",
        "deep": "في قولهم «الجميع يطلبونك» يظهر ضغط الشعبية على الخادم، كما يظهر أن العزلة والصلاة سبقتا اتخاذ القرار بشأن الخطوة التالية.",
        "applied": "قد يصلح أن تسأل نفسك: هل تدفعك كثرة الطلب إلى إهمال دعوتك، أم تراجع في الصلاة ما ينبغي أن تفعله قبل الاستجابة للضغوط؟"
      }
    },
    "1:38": {
      "reference": "41-Mark 1:38",
      "text": "فَقَالَ لَهُمْ: «لِنَذْهَبْ إِلَى الْقُرَى الْمُجَاوِرَةِ لأَكْرِزَ هُنَاكَ أَيْضًا، لأَنِّي لِهذَا خَرَجْتُ».",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Mark.ii.html#Bible_Mark.1.29-Mark.1.39"
          ],
          "ranges": [
            "41-Mark 1:29-39"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:k-capernaum",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "كفرناحوم",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "متى 4:13-17؛ 8:5-17؛ مرقس 1:21-39؛ يوحنا 6:24-59"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يرد يسوع على خبر ازدحام الناس بتحديد مجال أوسع للخدمة: القرى المجاورة، حيث يريد أن يكرز هناك أيضًا لأن هذا هو سبب خروجه.",
        "theological": "يؤكد القول أن رسالته لا تُحصر في موضع واحد أو جمهور واحد، بل تتقدم بحسب الغرض الذي حدده، لا بحسب رغبة الناس في إبقائه بينهم.",
        "deep": "تتضح أولوية الكرازة في العبارة؛ فالمعجزات والطلب الشعبي لا يستبدلان الإعلان، بل يظلّ التعليم هو الغاية المعلنة للتحرك.",
        "applied": "حين تنجح في موضع مألوف، راجع حدود خدمتك بهدوء، وابحث عن الأماكن القريبة التي تحتاج إلى كلمة الحق بدل الاكتفاء بما يحقق لك القبول."
      }
    },
    "1:39": {
      "reference": "41-Mark 1:39",
      "text": "فَكَانَ يَكْرِزُ فِي مَجَامِعِهِمْ فِي كُلِّ الْجَلِيلِ وَيُخْرِجُ الشَّيَاطِينَ.",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Mark.ii.html#Bible_Mark.1.29-Mark.1.39"
          ],
          "ranges": [
            "41-Mark 1:29-39"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:k-capernaum",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "كفرناحوم",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "متى 4:13-17؛ 8:5-17؛ مرقس 1:21-39؛ يوحنا 6:24-59"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يلخص النص نمط الخدمة في الجليل كله: كرازة متواصلة في المجامع، مقترنة بإخراج الشياطين بوصفه عملًا مصاحبًا للإعلان.",
        "theological": "يقدّم العدد التعليم والعمل معًا؛ فالكلمة المعلنة ليست منفصلة عن مواجهة الشر، بل يظهر أثرها في تحرير من كانوا تحت سلطانه.",
        "deep": "تكرار الانتشار «في كل الجليل» يبرز اتساع المجال، بينما يبيّن الجمع بين الكرازة والإخراج أن الرسالة تتجه إلى الفكر والحياة معًا.",
        "applied": "اجعل تعليمك واضحًا ومصحوبًا بخدمة نافعة؛ فالشهادة لا تُقاس بكثرة الكلام وحدها، بل بما يصاحبه من مقاومة للشر وخير ملموس."
      }
    },
    "1:40": {
      "reference": "41-Mark 1:40",
      "text": "فَأَتَى إِلَيْهِ أَبْرَصُ يَطْلُبُ إِلَيْهِ جَاثِيًا وَقَائِلاً لَهُ: «إِنْ أَرَدْتَ تَقْدِرْ أَنْ تُطَهِّرَنِي»",
