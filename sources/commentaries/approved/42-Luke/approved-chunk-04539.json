      "explanation_lines": {
        "academic": "تأتي المرأة من وراء يسوع وتلمس هدب ثوبه، ويقرر السرد أن نزفها توقف في الحال عقب هذه اللمسة.",
        "theological": "يفسر المصدر فعلها على أنه ثقة قوية بأن لمسة ثوبه تكفي لنيل الشفاء، ويشدد على التغير الفوري الذي اختبرته.",
        "deep": "تجمع الآية بين اقتراب خفي ونتيجة ظاهرة في جسدها؛ فالذي أرادت أن يتم دون ملاحظة صار تحولاً مؤكداً لديها.",
        "applied": "قد تكون الخطوة الأولى في طلب النجدة هادئة وغير ملحوظة للناس، لكنها لا ينبغي أن تكون مترددة أو خالية من الثقة."
      }
