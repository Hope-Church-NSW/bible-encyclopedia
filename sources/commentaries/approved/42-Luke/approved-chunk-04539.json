      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص استجابة جماعية من أهل كورة الجدريين: طلبوا من يسوع أن يغادر، لأن الخوف العظيم استولى عليهم بعد ما رأوه.",
        "theological": "يكشف رحيل يسوع استجابته لطلبهم؛ فالمصدر يلاحظ أن من يرفضون حضوره يخسرون الرجاء المعروض لهم.",
        "deep": "قارن الناس بين خسارة الخنازير وخلاص جارهم المضطرب، فرجحت عندهم الخسارة المرئية على التحرير الذي حدث بينهم.",
        "applied": "يفحص هذا الموقف ما إذا كان الخوف من التغيير أو من الكلفة يجعلنا نطلب ابتعاد العون بدل أن نتأمل خيره."
      }
    },
