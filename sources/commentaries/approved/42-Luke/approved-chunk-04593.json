      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص أن يسوع دخل أريحا ومضى فيها، في موضعٍ يبرز عبورَه لا وقوفَه أمام حاجات الناس.",
        "theological": "يُظهر هذا أن الخلاص يمرّ في الطريق العام، لا يقتصر على المدن المقدسة أو الأماكن المعلنة.",
        "deep": "يرسم المشهد انتقالًا من الطريق إلى اللقاء، لأن المدينة لا تُعدّ مجرد مكانٍ بل مسرحًا لمرور الخلاص.",
        "applied": "يدعو هذا المقطع إلى أن يلاحظ المؤمنون طريق اليوم العادي، لأن يسوع يمرّ في أماكن لا يراها الناس كفرصٍ للرحمة."
      }
    },
