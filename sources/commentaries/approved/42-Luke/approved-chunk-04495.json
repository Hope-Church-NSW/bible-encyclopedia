      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعرّف الملاك نفسه لجَكَرِيّا باسم جبريل، ويحدد موقعه واقفًا أمام الله ووظيفته رسولًا بالكلام والبشارة.",
        "theological": "تسند الآية خبر الميلاد إلى رسول حاضر أمام الله ومرسَل منه، فتقدمه خبرًا ذا سلطة لا تخمينًا بشريًا.",
        "deep": "جواب جبريل يعالج طلب جكريا علامةً بإبراز هوية المرسل وقربه من مصدر الرسالة، ثم يصف الخبر بأنه بشارة.",
        "applied": "عند مواجهة وعد يصعب تصديقه، تذكّر الآية أن وزن الخبر يتصل بأمانة مرسله لا بمحدودية الظروف الظاهرة."
      }
    },
