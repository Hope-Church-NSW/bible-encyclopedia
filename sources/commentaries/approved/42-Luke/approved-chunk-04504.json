      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد العدد اليوم الثامن للختان وتسمية الصبي يسوع، رابطا الاسم بما أعلنه الملاك قبل الحبل به في البطن.",
        "theological": "يفسر المصدر هذا الحدث كخضوع مبكر للناموس؛ فالطفل دخل تحت ما عُيّن، واتخذ الاسم الموافق لإرسالية الخلاص التي أُعلنت عنه.",
        "deep": "تسمية يسوع عند الختان تجمع الطاعة والألم والبشارة؛ فالاسم لا يبرز مجدا ظاهرا بل قصدا رحيما يرتبط بخلاص شعبه.",
        "applied": "يدعو العدد إلى تقدير الطاعة الدقيقة في موعدها، وإلى تلقي اسم يسوع كما أُعطي من الله لا كما تصوغه التوقعات البشرية."
      }
    },
