        "academic": "تصل الرسالة أثناء كلام يسوع بأن ابنة رئيس المجمع ماتت، ويقترح الرسول ألا يُتعب المعلّم بعد الآن.",
        "theological": "يكشف الخبر حدود رجاء الناس في الوسائل المعتادة، إذ يرون أن الموت أنهى مجال الطلب والعون.",
        "deep": "ما يبدو للآخرين نهايةً لا يحدد وحده إمكان الرجاء؛ الخبر القاسي يمهّد لكلمة يسوع التالية.",
        "applied": "عند وصول خبر يبدد التوقعات، لا تجعل حكم اليأس السريع هو الكلمة الأخيرة في قلبك."
      }
    },
