  "verses": {
    "17:10": {
      "reference": "42-Luke 17:10",
      "text": "كَذلِكَ أَنْتُمْ أَيْضًا، مَتَى فَعَلْتُمْ كُلَّ مَا أُمِرْتُمْ بِهِ فَقُولُوا: إِنَّنَا عَبِيدٌ بَطَّالُونَ، لأَنَّنَا إِنَّمَا عَمِلْنَا مَا كَانَ يَجِبُ عَلَيْنَا».",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Luke.xviii.html#Bible_Luke.17.1-Luke.17.10"
          ],
          "ranges": [
            "42-Luke 17:1-10"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يختم يسوع تعليم الخدام بمثال العمل المأمور به، فيربط قيمة الخدمة بإتمام الواجب لا بطلب المدح أو اعتبار النفس مستحقة للمكافأة.",
        "theological": "الخادم لله لا يملك أن يجعل الله مدينًا له؛ فالطاعة المطلوبة لا تنشئ استحقاقًا، بل تكشف خضوع الإنسان لسيده.",
        "deep": "تعبير «عبيد بطالون» لا يعني أن الخدمة بلا نفع، بل أن صلاحها لا يضيف شيئًا إلى كمال الله، وأن فضلها يعود إلى الخادم المحتاج.",
        "applied": "بعد إنجاز الواجب، ليتجنب المؤمن التفاخر، ويستمر في خدمة الله بتواضع، عالمًا أن المطلوب منه هو الأمانة لا مطالبة الله بالجزاء."
      }
    },
