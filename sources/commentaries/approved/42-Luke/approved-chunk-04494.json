      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع النص صلاة جمهور الشعب خارج الهيكل بالتزامن مع تقديم البخور، فيربط المشهد الجماعي بزمن العبادة المعيّن.",
        "theological": "تظهر الصلاة هنا خدمة أساسية ترافق الطقس ولا تُستبدل به؛ فالحضور إلى العبادة يستلزم اشتراك القلب فيها.",
        "deep": "اجتماع الشعب في الصلاة بينما يعمل زكريا يبرز أن العبادة ليست مهمة فرد منعزل، بل انتظار جماعي أمام الله.",
        "applied": "حين تشترك الجماعة في الصلاة بصدق، لا يبقى الطقس عادة خارجية، بل يصير مجالاً لرفع الطلبات وتكريم الله."
      }
    },
