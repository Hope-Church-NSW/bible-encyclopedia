            },
            {
              "relation": "messianic",
              "text": "1 كورنثوس 15:20"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد النص أسماء مريم المجدلية ويونا ومريم أم يعقوب، ويضيف نساء أخريات، بوصفهن ناقلات خبر القبر إلى الرسل.",
        "theological": "تظهر الآية أن خبر القيامة وصل إلى الجماعة عبر شهادة نساء كنّ حاضرات عند القبر، فالمقصود إعلان ما رأينه وسمعنه.",
        "deep": "تسمية الشاهدات تحفظ شهادتهن في السرد، وتبيّن أن الإيمان بالخبر بدأ من أناس رجعوا من القبر ليخبروا الآخرين.",
        "applied": "حين تختبر حقاً واضحاً، انقله بأمانة وبأسماء الوقائع كما هي، ولا تدع مكانتك الاجتماعية تحدد قيمة شهادتك."
      }
    },
    "24:11": {
      "reference": "42-Luke 24:11",
      "text": "فَتَرَاءَى كَلاَمُهُنَّ لَهُمْ كَالْهَذَيَانِ وَلَمْ يُصَدِّقُوهُنَّ.",
