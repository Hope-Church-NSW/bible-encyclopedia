              "relation": "encyclopedia",
              "text": "لوقا 10:25-37"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يقر يسوع بصواب جواب الرجل، ثم يحوّل المعرفة بالوصية إلى أمر مباشر بالفعل.",
        "theological": "تربط الآية بين الجواب الصحيح وبين دعوة عملية إلى السلوك بحسب ما أُعلن في الشريعة.",
        "deep": "المدح لا ينهي الحوار، لأن عبارة «افعل هذا» تكشف أن الامتحان الحقيقي هو تحويل الفهم إلى ممارسة.",
        "applied": "لا تكتفِ بصياغة إجابة دينية سليمة؛ حدّد اليوم عملاً يترجم محبة الله والقريب إلى سلوك."
      }
    },
    "10:29": {
      "reference": "42-Luke 10:29",
      "text": "وَأَمَّا هُوَ فَإِذْ أَرَادَ أَنْ يُبَرِّرَ نَفْسَهُ، قَاَلَ لِيَسُوعَ: «وَمَنْ هُوَ قَرِيبِي؟»",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
          "locators": [
            "mhc5/OEBPS/mhc5.Luke.xi.html#Bible_Luke.10.25-Luke.10.37"
          ],
          "ranges": [
            "42-Luke 10:25-37"
          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:s-samaritan",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "السامري الصالح",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "لوقا 10:25-37"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن السرد أن سؤال الرجل عن القريب صدر من رغبته في تبرير نفسه بعد جواب يسوع.",
        "theological": "يكشف النص خطورة استخدام السؤال الأخلاقي لتحديد حدود البر بدل قبول فحص الوصية للقلب.",
        "deep": "بدلاً من مواجهة ما يقتضيه الحب، ينقل الرجل النقاش إلى تعريف القريب، فيبحث عن مخرج من الإلزام.",
        "applied": "عندما تميل إلى سؤال يضيّق واجب الرحمة، افحص إن كان هدفك الفهم الصادق أم حماية صورتك."
      }
    },
    "10:30": {
      "reference": "42-Luke 10:30",
      "text": "فَأَجَابَ يَسُوعُ وَقَالَ: «إِنْسَانٌ كَانَ نَازِلاً مِنْ أُورُشَلِيمَ إِلَى أَرِيحَا، فَوَقَعَ بَيْنَ لُصُوصٍ، فَعَرَّوْهُ وَجَرَّحُوهُ، وَمَضَوْا وَتَرَكُوهُ بَيْنَ حَيٍّ وَمَيْتٍ.",
      "summary": "",
      "sources": [
