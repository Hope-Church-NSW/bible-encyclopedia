    "10:28": {
      "reference": "42-Luke 10:28",
      "text": "فَقَالَ لَهُ:«بِالصَّوَابِ أَجَبْتَ. اِفْعَلْ هذَا فَتَحْيَا».",
      "summary": "",
      "sources": [
        {
          "id": "matthew_henry",
