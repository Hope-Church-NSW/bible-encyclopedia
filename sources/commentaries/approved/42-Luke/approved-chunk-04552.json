      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبدأ يسوع المثل برجل نازل من أورشليم إلى أريحا وقع بين لصوص جرّدوه وجرحوه وتركوه شبه ميت.",
        "theological": "تضع الآية أمام السامع إنساناً في ضيق شديد، فتجعل الحاجة الواقعية هي محور اختبار المحبة.",
        "deep": "تتراكم أفعال اللصوص: سلب وتجريد وجرح وترك، لتصوّر عجز المصاب الكامل عن إنقاذ نفسه في الطريق.",
        "applied": "انتبه لمن أرهقته خسارة أو أذى؛ لا تؤجل الاستجابة لأن احتياجه لا يأتيك في وقت مناسب."
      }
    },
