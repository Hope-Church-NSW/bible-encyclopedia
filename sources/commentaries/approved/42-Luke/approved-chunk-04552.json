      "explanation_lines": {
        "academic": "يذكر المثل كاهناً مرّ في الطريق نفسه، ورأى الرجل الجريح ثم اجتاز من الجهة الأخرى.",
        "theological": "تظهر الآية أن رؤية الحاجة وحدها لا تكفي، إذ يمكن للمرء أن يعرف الموقف ويظل بعيداً عن الرحمة.",
        "deep": "تقوم المفارقة في أن صاحب المكانة الدينية حاضر أمام الجريح، لكن قربه المكاني لا يصير عوناً فعلياً.",
        "applied": "إذا رأيت ألماً واضحاً، قاوم عادة الابتعاد؛ اقترب أولاً واسأل ما المساعدة الممكنة والمسؤولة."
      }
    },
