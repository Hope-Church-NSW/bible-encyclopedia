      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد بلوغ التلميذين القرية المقصودة، فيما بدا يسوع كأنه سيواصل السير إلى موضع أبعد.",
        "theological": "إظهار يسوع رغبته في متابعة الطريق أتاح للتلميذين أن يعبرا بحرية عن رغبتهما في بقائه معهما.",
        "deep": "لا يفرض الضيف نفسه على البيت أو الرفقة؛ فمظهر الانصراف هنا يستدعي دعوة صادقة لا قبولاً شكلياً.",
        "applied": "حين يمنحنا حديث الكتاب تعزية وفهماً، يجدر بنا ألا نقطع التأمل سريعاً بل نطلب استمرار هذا التعليم."
      }
    },
