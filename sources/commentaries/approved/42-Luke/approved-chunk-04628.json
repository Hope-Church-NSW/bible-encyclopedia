      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يلح التلميذان في دعوة رفيقهما إلى المكوث، مستندين إلى اقتراب المساء وانقضاء النهار، فيدخل ليبقى معهما.",
        "theological": "استجاب يسوع لإلحاحهما ودخل للمكوث، فيظهر استعداده لمواصلة التعليم والتعزية لمن ينتفع بما تلقاه.",
        "deep": "الدعوة الملحّة لا تصدر من مجاملة عابرة، بل من إدراك أن صحبة هذا الرفيق في آخر النهار صارت ثمينة.",
        "applied": "يمكن أن تتحول نهاية اليوم إلى فرصة لطلب حضور الرب في الفكر، وملء القلب بتأملات صالحة ومحبة صادقة."
      }
    },
