      "explanation_lines": {
        "academic": "تذكر الآية أن بعض النساء من جماعة التلاميذ ذهبن باكرًا إلى القبر، وأن خبرهن أحدث حيرة في الجماعة.",
        "theological": "يبرز الخبر أن شهادة النساء لم تُهمَل من السرد، لكنها وصلت إلى التلاميذ أولًا بوصفها أمرًا يثير الدهشة والحيرة.",
        "deep": "الاستيقاظ المبكر والذهاب إلى القبر يقدمان شهادة حركةٍ وبحث، بينما تكشف حيرة السامعين أن الخبر واجه توقعاتهم السابقة.",
        "applied": "عند ورود خبر يربك تصوراتنا، لا ينبغي أن تتحول الحيرة إلى رفض فوري؛ بل نسمع الشهادة ونتحقق من معناها."
      }
    },
