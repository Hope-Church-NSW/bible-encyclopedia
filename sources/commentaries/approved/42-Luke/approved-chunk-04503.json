      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يضع الخبر الملائكي الرعاة أمام انتقال من خوف شديد إلى بشارة فرح عظيم معلنة علنا، لا كخبر خاص بل كرسالة تتسع لجميع الشعب.",
        "theological": "تؤكد الآية أن قصد الله في هذه الولادة ليس الرعب بل الفرح؛ فالبشارة تأتي من السماء لتكشف صلاحا إلهيا يبدد خوف السامعين.",
        "deep": "عمق القول في أن الفرح العظيم يولد حيث كان الخوف غالبا؛ فحضور الله لا يبقى تهديدا حين يحمل رسالته بالنعمة.",
        "applied": "حين يداهمك الخوف من أخبار السماء أو أحكام الله، اسمع أولا قوله: لا تخافوا، وافتح قلبك لفرح البشارة لا للذعر."
      }
    },
