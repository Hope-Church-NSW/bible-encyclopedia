          ]
        }
      ],
      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "miracle:leper",
          "relation": "direct",
          "scope": "verse_or_passage",
          "title": "تطهير الأبرص",
          "source_file": "study-miracles-christ.html",
          "references": [
            {
              "relation": "direct",
              "text": "مرقس 1:40-45؛ متى 8:1-4؛ لوقا 5:12-16"
            },
            {
              "relation": "background",
              "text": "لاويين 13-14؛ 2 ملوك 5"
            },
            {
              "relation": "messianic",
              "text": "مرقس 1:41-42"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينقل العدد مشهد رجل ممتلئ بالبرص يرى يسوع، فيخر على وجهه، ثم يطلب التطهير معلّقًا الأمر على إرادة السيد وقدرته.",
        "theological": "يقدّم الرجل نموذجًا للإيمان المتواضع: يعترف بحاجته، ويثق بقدرة يسوع، ويسلّم طلبه لإرادته دون أن يشكك في قدرته.",
        "deep": "اجتماع الامتلاء بالبرص مع السقوط على الوجه يكشف عمق العجز، بينما تجعل عبارة إن أردت الطلبَ خضوعًا واثقًا لا يفرض النتيجة.",
        "applied": "تعال إلى يسوع بصدق، واعترف بما يلوث حياتك، واطلب التطهير بإلحاح، مع ترك توقيت الاستجابة وطريقتها لإرادته الصالحة."
      }
    },
    "5:13": {
      "reference": "42-Luke 5:13",
      "text": "فَمَدَّ يَدَهُ وَلَمَسَهُ قَائِلاً:«أُرِيدُ، فَاطْهُرْ!». وَلِلْوَقْتِ ذَهَبَ عَنْهُ الْبَرَصُ.",
      "summary": "",
      "sources": [
