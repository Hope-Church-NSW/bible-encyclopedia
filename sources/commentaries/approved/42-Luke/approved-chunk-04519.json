      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح العدد أن خبر يسوع انتشر أكثر، فاجتمعت جموع كثيرة لا لتسمع تعليمه فقط، بل أيضًا لتنال الشفاء من أمراضها.",
        "theological": "يجمع النص بين خدمة الكلمة وخدمة الشفاء؛ فالمعجزات جذبت الناس، وأكدت التعليم، وقدمت لهم منفعة ملموسة.",
        "deep": "كلما حاول يسوع أن يبتعد عن طلب الشهرة، ازداد انتشار خبره؛ وكان المجد الحقيقي في وصول الناس إلى التعليم والعون لا في المدح.",
        "applied": "اجعل خدمتك نافعة في الكلمة والعمل معًا، ولا تجعل انتشار اسمك هدفًا؛ فالمقياس أن يصل الناس إلى الحق وينالوا معونة حقيقية."
      }
    },
