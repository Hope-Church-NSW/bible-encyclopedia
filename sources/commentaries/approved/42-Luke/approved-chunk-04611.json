      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "فذهبوا ووجدوا كما قال لهم، فأعدّوا الفصح في المكان الذي أشار إليه، فثبتت صدق كلمته في الممارسة.",
        "theological": "هذا التحقق يثبت أن ما قاله المعلم لا يبقى وعداً مجرداً، بل يسبق التجربة في تفاصيل البيت والوقت والموضع.",
        "deep": "التلاميذ لم يذهبوا إلى طريق مجرّد، بل إلى موقف تتحقق فيه الكلمات قبل أن تُحسّ، فالثقة بالرب تستلزم طاعة دون سؤالٍ مستمر.",
        "applied": "عندما يفتح الرب الطريق، لا تضعف الثقة لأنك لا ترى كل ما وراء الباب؛ فالتجربة تُرَدّد أن كلامه صادق، وأنك تُؤتى للموعد في حينه."
      }
    },
