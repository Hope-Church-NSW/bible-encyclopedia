      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر العدد إطعام المن في البرية، وهو طعام لم يعرفه الآباء، ويحدد غاية هذا التدبير في الإذلال والامتحان والإحسان في النهاية.",
        "theological": "يجمع النص بين التأديب والرعاية: فالاختبار لا ينفصل عن حفظ الحياة، والغاية المعلنة هي الإحسان في العاقبة.",
        "deep": "قد يبدو الطريق شاقًا، لكن المن اليومي يكشف أن الله يعمل وسط الضعف لتعليم الاتكال وتهيئة خير لاحق.",
        "applied": "عندما يحدّك ظرف يعلّمك الاتكال، انتبه إلى عطايا العناية اليومية ولا تحكم على قصد الله من مشقة المرحلة وحدها."
      }
    }
