            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يكرر النص شريعة سبق ذكرها بأن يخدم العبد أو الأمة العبراني ست سنين ثم يُطلق حرًا في السنة السابعة.",
        "theological": "شعب الرب شعب حر لا يجوز استعباده أبديًا، فحرية الإسرائيلي تعكس كونه من شعب الله المدعو إلى الحرية.",
        "deep": "تحديد مدة الخدمة بست سنين يحمي كرامة الأخ العبراني من الاستمرار في وضع العبودية داخل شعبه ذاته.",
        "applied": "على كل من يملك خادمًا عبرانيًا أن يطلقه حرًا بعد ست سنين، محترمًا حده الزمني المفروض بلا تأخير أو تحايل."
      }
    }
