      "interpreter_names": [
        "متى هنري"
      ],
      "supplemental_sources": [
        {
          "id": "encyclopedia:sh-sharira",
          "relation": "encyclopedia",
          "scope": "chapter_context",
          "title": "شريعة",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "خروج 20؛ تثنية 6؛ مزمور 119؛ متى 5:17-20"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يجمع النداء بين السماع والاحتراز والعمل، ثم يربط ذلك بالخير وكثرة الشعب ووعد الأرض التي تفيض لبناً وعسلاً.",
        "theological": "يصل النص خير إسرائيل وكثرته بأمانة الرب لإله الآباء الذي سبق أن كلّمه ووعده بالأرض.",
        "deep": "السماع المقصود ليس استقبالاً عابراً؛ إذ يكتمل بالانتباه العملي الذي يحفظ الوصية ويترجمها إلى فعل.",
        "applied": "عند سماع وصية، حدّد خطوة طاعة واضحة بدلاً من الاكتفاء بالإعجاب بها، واجعل التنفيذ ثمرة الإصغاء."
      }
    },
    "6:4": {
      "reference": "05-Deut 6:4",
      "text": "«اِسْمَعْ يَا إِسْرَائِيلُ: الرَّبُّ إِلهُنَا رَبٌّ وَاحِدٌ.",
