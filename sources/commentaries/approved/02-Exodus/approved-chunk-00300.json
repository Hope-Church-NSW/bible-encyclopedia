      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتابع النص وصف الصف الثاني من الحجارة: بهرمان وياقوت أزرق وعقيق أبيض، ضمن الصفوف الأربعة التي يفصلها متى هنري كوحدة واحدة من 28: 15-30.",
        "theological": "يوضح هنري أن هذه الحجارة المرصعة كانت وسيلة تمثيل الأسباط أمام الله، إذ كان الكاهن يحملها كما يحمل رداء الخدمة على كتفيه.",
        "deep": "يشير هنري إلى أن نقش الاسم على الحجر الكريم يعبر عن كرامة الشعب وشرفه عند الرب رغم ضعفه الظاهر بين الأمم.",
        "applied": "يذكّر هنري القارئ بأن حمل الأسماء على الصدر يعلّم أن محبة الله لشعبه قريبة من القلب لا مجرد سلطة بعيدة."
      }
    },
