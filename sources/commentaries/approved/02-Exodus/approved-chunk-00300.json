      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعدد النص الصف الثالث: عين الهر ويشم وجمشت، وهو جزء من وصف متى هنري التفصيلي لصدرة القضاء وحجارتها الاثني عشر.",
        "theological": "يربط هنري بين هذه الحجارة والأوريم والتُّميم اللذين وُضعا في الصدرة، مما جعلها تُدعى صدرة القضاء لمعرفة مشيئة الرب.",
        "deep": "يفسر هنري أن حكم الله الإسرائيل كان تيوقراطيا، وأن الكاهن حامل هذه الحجارة كان بمثابة مجلس مشورة إلهية للأمة.",
        "applied": "يستخلص هنري أن اللجوء إلى مشورة الرب في الأمور الصعبة، كما فعل يشوع، درس في طلب هداية الله باستمرار."
      }
    },
