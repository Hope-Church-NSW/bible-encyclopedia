      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأمر النص بحفظ الذبيحة إلى اليوم الرابع عشر ثم بذبحها في المساء بمشاركة جماعة إسرائيل كلها.",
        "theological": "يفسر المصدر الذبح الجماعي في المساء بوصفه جزءا من طقس ديني يقر بخير الله في الحفظ والإنقاذ من الضربات.",
        "deep": "يجمع حفظ الذبيحة ثم ذبحها بين انتظار منضبط وفعل جماعي؛ فالخلاص الموعود لا يلغي الاستعداد والطاعة في الوقت المحدد.",
        "applied": "تعلمنا الآية أن الاستعداد للعبادة لا يكون ارتجالا، وأن الجماعة تتشارك المسؤولية عندما يجيء وقت تنفيذ أمر الله."
      }
    },
