      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر متى هنري أن إلباس هرون القميص وجبة الرداء والرداء والصدرة وشده بزنار الرداء جاء ضمن سلسلة طقوس تكريس الكهنة عند باب خيمة الاجتماع.",
        "theological": "يرى متى هنري أن إلباس الثياب المقدسة يدل على أنه لا يكفي نزع دنس الخطية بل يجب لبس فضائل الروح والتسربل بالبر كقوله في مزمور 132: 9.",
        "deep": "يوضح متى هنري أن الشد بالزنار يشير إلى الاستعداد والتقوي للعمل، فكأن الكاهن يُهيَّأ جسدياً ورمزياً لحمل مسؤولية الخدمة أمام الله.",
        "applied": "يدعو هذا الفعل من يخدمون الله اليوم إلى أن يقرنوا الطهارة الداخلية بلبس صفات الروح، فلا يكتفوا بترك الخطية بل يتسربلوا بالبر في خدمتهم."
      }
    },
    "29:6": {
      "reference": "02-Exodus 29:6",
      "text": "وَتَضَعُ الْعِمَامَةَ عَلَى رَأْسِهِ، وَتَجْعَلُ الإِكْلِيلَ الْمُقَدَّسَ عَلَى الْعِمَامَةِ،",
