      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير متى هنري إلى وضع العمامة على رأس هرون ثم الإكليل المقدس عليها كخطوة تالية ضمن ترتيب إلباس الثياب المقدسة الوارد في الآيات 5 و6 و8 و9.",
        "theological": "يذكر متى هنري أن هرون كان يُلبَس ويُتوَّج ليُعتبر عمله ومنصبه شرفاً حقيقياً له، فالتتويج هنا علامة كرامة الخدمة الكهنوتية لا زينة عابرة.",
        "deep": "يربط متى هنري بين الإكليل المقدس ومعنى لبس جمال القداسة، فوضع الإكليل فوق العمامة يكمل صورة الكاهن المهيأ بالكامل للمثول أمام الرب.",
        "applied": "يذكّر هذا بأن من يُدعى لخدمة مقدسة ينبغي أن يعتبرها كرامة تستحق الجدية والوقار، لا مجرد وظيفة، بحسب ما بيّنه متى هنري في شرحه."
      }
    },
    "29:7": {
      "reference": "02-Exodus 29:7",
      "text": "وَتَأْخُذُ دُهْنَ الْمَسْحَةِ وَتَسْكُبُهُ عَلَى رَأْسِهِ وَتَمْسَحُهُ.",
