      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبيّن متى هنري أن سكب دهن المسحة على رأس هرون ومسحه به يختلف عن مسحة الكهنة الأدنى الذين مُزج الزيت في دمائهم المرشوشة على ثيابهم دون رؤوسهم.",
        "theological": "يفسر متى هنري المسحة بأنها علامة سكب الروح على هرون ليؤهله لعمله، وليمتلئ الشعب ويُسر برائحة خدمته الطيبة كرائحة الدهن والطيب.",
        "deep": "يقارن متى هنري هذا الدهن بالمحبة الأخوية الممسوح بها هرون في مزمور 133: 2، فيربط بين الوحدة والمحبة بين الإخوة وبين رمزية هذا الزيت المقدس.",
        "applied": "يعلّم هذا أن التأهل للخدمة لا يأتي من الإنسان نفسه بل عطية من فوق، فمن يخدم يحتاج أن يستمد قوته وتأهيله من الرب لا من ذاته."
      }
    },
