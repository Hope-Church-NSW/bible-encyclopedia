      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يعلل النص خبز الفطير بأن العجين أُخرج من مصر بلا تخمير، لأنهم طُردوا على عجل ولم يستطيعوا التأخر أو إعداد زاد.",
        "theological": "يربط المصدر بساطة الطعام بفرح الحرية؛ فخبز غير مختمر وقليل المتعة صار وجبة بهيجة بسبب الخلاص من العبودية.",
        "deep": "توضح الآية أن الاستعداد المحدود لم يمنع المسير، وأن الاستجابة العاجلة غلبت البحث عن مؤونة أكمل وراحة أكبر.",
        "applied": "تعلّم الآية قبول البساطة عند أداء الواجب، فلا تجعل إرضاء الشهية أو اكتمال الترتيبات سبباً لتأجيل الطاعة."
      }
    },
