      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل النص انتقال بني إسرائيل من رعمسيس إلى سكوت، ويحدد العدد بنحو ستمئة ألف من الرجال المشاة دون الأولاد.",
        "theological": "يرى المصدر في هذا العدد الكبير برهاناً على فاعلية البركة الإلهية حين يأمر الله شعبه بالإثمار والتكاثر.",
        "deep": "لم يؤخر الخارجون رحيلهم إلى وقت أنسب بعد الإذن، إذ كان تبدل موقف فرعون سبباً كافياً لرفض التباطؤ.",
        "applied": "عند انفتاح طريق واجب، تدعو الآية إلى الاستجابة بلا تسويف، لا إلى انتظار ظروف أكثر راحة أو ضماناً."
      }
    },
