      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد النص أن الابن الذي يخلف هارون يلبس الثياب سبعة أيام عند دخوله خيمة الاجتماع للخدمة في الموضع المقدس.",
        "theological": "تجعل مدة الأيام السبعة تسلم الكهنوت إجراءً علنيًا متدرجًا، يؤكد جدية الانتقال إلى خدمة مخصصة لله.",
        "deep": "لا يكتمل الدخول إلى المنصب في لحظة عابرة؛ فاللباس المتكرر خلال أسبوع يفصل الخلف عن حالته السابقة ويهيئه لثقل مهمته.",
        "applied": "تعلم الآية أن تكليف المسؤوليات الجسيمة يحتاج إلى وقت وانضباط، لا إلى استعجال، كي يدخل الخادم عمله بوعي واستعداد."
      }
    },
