      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشرح متى هنري أن هذا النص وصية مكملة لعهد عدم مصادقة الوثنيين، إذ يحذر من سكناهم في الأرض لئلا يجرّوا الشعب إلى الخطيئة.",
        "theological": "يرى متى هنري أن الله يربط وعد امتلاك الأرض بشرط الطاعة، فبقاء الوثنيين فخ يقود إلى عبادة آلهتهم ومخالفة الرب.",
        "deep": "يبيّن متى هنري أن الألفة مع الوثنيين تُضعف تدريجيًا كراهية الخطيئة، فيصير التنازل الصغير مجاملة ثم شركًا خفيًا في العبادة.",
        "applied": "يحث متى هنري على الابتعاد عن الرفقة الفاسدة لأن من يريد الخلاص من الشر يجب أن يتجنب مصاحبة أهله ومخالطتهم القريبة."
      }
    }
