      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "المواد المحددة للملابس الكهنوتية هي الذهب والأسمانجوني والأرجوان والقرمز والبوص، وهي مواد غالية تعكس أهمية الخدمة الكهنوتية.",
        "theological": "اختيار هذه المواد الفاخرة يرمز إلى أن الكهنوت خدمة مقدسة تتطلب أفضل ما يقدمه الشعب.",
        "deep": "المزج بين المعادن والألوان في هذه المواد يعكس التنوع والتعقيد في الخدمة الكهنوتية المسؤولة عن وسائط اتصال الشعب بالله.",
        "applied": "تعليم المؤمنين اليوم أن تكريس الموارد الثمينة لخدمة إلهية يعبر عن القيمة الحقيقية للعبادة والشركة مع الله."
      }
    },
