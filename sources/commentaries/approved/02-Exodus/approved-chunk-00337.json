      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينزل موسى من الجبل حاملا لوحي الشهادة؛ ويلاحظ النص أنهما مكتوبان على الجانبين، كوثيقة عهد جاهزة للإيداع في التابوت.",
        "theological": "تسليم اللوحين لموسى علامة Favor إلهي بحسب المصدر، فالله كان متقدما نحو إدخال الشعب في العهد رغم علمه بسقوطهم.",
        "deep": "كون اللوحين في يد موسى قبل رؤية العجل يجعل فقدانهما لاحقا أكثر إيلاما: البركة كانت قريبة، وما منعها لم يكن إلا خطية الشعب.",
        "applied": "تذكّر الآية أن الامتياز الروحي قد يكون بين أيدينا، لكن الاستهانة بالطاعة تحوّل القرب من العهد إلى خسارة محسوسة ومخجلة."
      }
    },
