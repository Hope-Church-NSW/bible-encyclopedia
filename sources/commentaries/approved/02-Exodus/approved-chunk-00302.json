      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تُثبتان طرفي السلسلتين في الطوقين، لتُثبِّتا الصدرية على كتفي الرداء أمامه، في انتظام خدمة الكاهن.",
        "theological": "يظهر التثبيت على الكتفين أن مسؤولية الكاهن تُحمل في حضور الله، وتجمع بين الخدمة والتمثيل الشعبي.",
        "deep": "لا تُفصل الصدرية عن الرداء، فحمل اسم الشعب لا ينفصل عن موضع الخدمة والقداسة.",
        "applied": "من يشارك في خدمة الله ينبغي أن يُثبت حماسه في المشقة والعهد، لا في الظهور المنفصل عن مسؤولية الجماعة."
      }
    },
