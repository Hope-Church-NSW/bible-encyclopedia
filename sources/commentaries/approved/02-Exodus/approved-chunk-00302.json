      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تُصنع حلقتين أخريين عند جانبي الرداء من أسفل، مقابلة للرباط الآخر فوق الحزام، لتعزيز ثبوت الصدرية.",
        "theological": "يُكرّر التثبيت في مواضع مختلفة، لأن الخدمة تستدعي استقراراً لا يزول عند التحرك أو التقدم.",
        "deep": "الثبات لا يكون في موضع واحد فقط، بل برباطات متعددة تُمنع السقوط وتُبقي الشرف في مكانه.",
        "applied": "من يقف في خدمة الله يحتاج إلى دعم متكرر في المواقف المختلفة، لا إلى إظهارٍ عابر فقط."
      }
    },
