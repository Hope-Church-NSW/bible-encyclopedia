      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد إجراء علنيا: يُقدَّم العبد إلى الله ثم إلى الباب أو القائمة، وتُثقب أذنه علامة لخدمته المستمرة.",
        "theological": "ربط الاختيار بإجراء منظور يؤكد أن الالتزام الدائم لا يُفترض خفية، بل يُعلن ضمن حكم منظم ومسؤول.",
        "deep": "الباب الذي يلازم البيت يصير موضعا لشهادة القرار؛ فالعلاقة التي اختارها العبد تُثبت بعلامة جسدية ظاهرة.",
        "applied": "يدعو النص إلى وضوح الالتزامات طويلة الأمد وحمايتها بإجراءات عادلة، بدلا من تركها رهينة الوعود المبهمة."
      }
    },
