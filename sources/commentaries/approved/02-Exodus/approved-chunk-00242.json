      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفرض النص عقوبة الموت على من يضرب أباه أو أمه، ويشرح التفسير أن الضرب يشمل ما يسفك دما أو يترك أثرا مؤلما.",
        "theological": "يعد التفسير إساءة الأولاد إلى والديهم استفزازا عظيما لله، ويربط ذلك بواجب التوقير والبنوة.",
        "deep": "الاعتداء على الوالدين ليس فعلا عابرا، بل كسر لرابطة التوقير التي تحفظ قابلية الإنسان لفضائل أخرى.",
        "applied": "احذر تنمية أفكار الغضب والاحتقار تجاه والديك، لأنها قد تتحول إلى قول أو تصرف يهدم واجب الاحترام."
      }
    },
