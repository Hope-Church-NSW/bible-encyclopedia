      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص استجابة الجماعة لمشاهد الرعود والبروق وصوت البوق ودخان الجبل؛ فارتعدوا وتنحّوا ووقفوا من بعيد.",
        "theological": "تُظهر هذه العلامات جلال الله المهيب، وتصحح اندفاع الشعب السابق إلى الاقتراب للنظر، إذ تعلّمهم أن يقفوا أمامه بخشوع.",
        "deep": "الخوف الذي أحدثه المشهد لم يكن تفصيلاً خارجياً؛ فقد نقل الشعب من التقدّم بجرأة إلى إدراك المسافة التي يقتضيها حضور الله.",
        "applied": "حين يواجه المرء عظمة الله، لا يستهين بها ولا يهرب منها، بل يسمح للرهبة أن تعلّمه احتراماً صادقاً وانتباهًا لطاعته."
      }
    },
