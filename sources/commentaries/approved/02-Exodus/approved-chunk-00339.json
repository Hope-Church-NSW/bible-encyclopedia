      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير متى هنري إلى أن هارون يكرر بلا داعٍ كلام الشعب المريب عن موسى، قائلاً إنهم لا يعرفون ما آل إليه أمره، وهو تلميح قد يحمل نوعاً من التعريض بموسى لتأخره على الجبل.",
        "theological": "يبيّن متى هنري أن هارون بذكره هذا القول يحاول تبرير صنع الآلهة بوصفه استجابة لمطلب الشعب الملحّ الذي جاء بسبب غياب موسى، فيضع نفسه في موضع الضحية لا الفاعل.",
        "deep": "يلاحظ متى هنري أن في تكرار هارون لهذه العبارة تحويلاً خفياً للمسؤولية بعيداً عنه، إذ يجعل غياب موسى وشك الشعب هما السبب الحقيقي لا قراره هو في صنع العجل.",
        "applied": "يذكّر متى هنري بأن التستر على الذنب أو تبريره بظروف الآخرين لا ينجي صاحبه، فالخطية المستورة أو المعلَّلة لا بد أن تُكشف عاجلاً أو آجلاً."
      }
    },
