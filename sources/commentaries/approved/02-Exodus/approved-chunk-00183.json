      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُذكر هنا تنفيذ بني إسرائيل كل ما أمر الرب به موسى وهارون، فتجسد الطاعة في الفعل المشترك والالتزام المعلن.",
        "theological": "الطاعة لا تبقى قولاً، بل تتحقق في التطبيق اليومي، لأن العبادات والفرائض تُؤخذ من أمر الرب لا من عادات البشر.",
        "deep": "الوصية لا تُقرأ للتزيين، بل تُؤدى في الممارسة، فيكون الفعل هو شهادة أن جماعة الله تنسجم مع تعليم موجهها.",
        "applied": "إذا أُمرنا بالقيام في شكر الله، فالأليق أن ننفذ ما جاء في أمره بكل وضوح، لا أن ننتظر أن تُنضجنا الرغبة وحدها."
      }
    },
