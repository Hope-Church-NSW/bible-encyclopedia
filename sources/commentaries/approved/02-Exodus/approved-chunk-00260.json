      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح الوعد بإرسال ملاك أمام الشعب ليحفظه في الطريق ويأتي به إلى المكان المعد له.",
        "theological": "يبين الوعد عناية الله الخاصة بشعبه، إذ يدبر لهم الحفظ والإرشاد نحو غايته المعيّنة.",
        "deep": "الحفظ لا يلغي صعوبة الطريق، لكنه يؤكد أن المسير في البرية وتجاه الأعداء ليس بلا قيادة.",
        "applied": "في طرق غير مألوفة، تعلّمنا الآية أن نسير بثقة في عناية الله وننتبه لإرشاده."
      }
