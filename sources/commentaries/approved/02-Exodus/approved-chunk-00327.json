      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "النص يحدد عقوبة قطع من الشعب لمن يركب دهن المسحة أو يضعه على أجنبي، مما يدل على أهمية حفظ الحدود القانونية في العبادة.",
        "theological": "تحريم استخدام الدهن المقدس على غير المكرسين يعكس مبدأ الفصل بين المقدس والعام، وحماية قدسية المؤسسات الإلهية.",
        "deep": "العقوبة الحادة تعبر عن رفض الله لتدنيس الأشياء المقدسة وتشريع لا يسمح بأي استخفاف بالعهد أو الشرائع المقررة.",
        "applied": "يعلمنا أن التعامل مع الأمور المقدسة يتطلب احترامًا مطلقًا وعدم التهاون في معايير القداسة التي وضعها الله."
      }
    },
