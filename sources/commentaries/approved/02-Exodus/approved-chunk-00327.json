      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوصي الرب موسى بجمع أربع أعطار: الميعة والأظفار والقنة واللبان بأجزاء متساوية لصنع البخور المقدس.",
        "theological": "اختيار الرب للمكونات الفاخرة والمتوازنة يدل على أن العبادة تستحق أفضل ما يمكن تقديمه لله والاهتمام بالتفاصيل.",
        "deep": "التساوي بين الأجزاء الأربع يرمز إلى التناسق والكمال في التكوين، كما يعكس حكمة الله في تحديد كل عنصر بدقة.",
        "applied": "تعلمنا أن تقديمنا لله يجب أن يكون مختارًا بعناية وموزونًا بحكمة، لا مبالاة أو عشوائية في العبادة."
      }
    },
