      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "جواب الرب يفسر المجد عبر مرور كل جودته وإعلان اسمه، لا عبر كشف غير محدود؛ فتتحول الرؤية المطلوبة إلى إعلان صلاح ورحمة.",
        "theological": "تؤكد العبارة «أتراءف على من أتراءف» حرية الرحمة الإلهية؛ فالنعمة تصدر من مشيئة الرب ولا تقوم على دين له عند المخلوق.",
        "deep": "يربط المصدر بين المجد والجودة: ما يرضي موسى ليس بهاء مجردا بل معرفة أن صلاح الرب في الينبوع، وأن رحمته حرة وسيادية.",
        "applied": "تدعونا الآية إلى طلب معرفة الرب من خلال جودته المعلنة، وإلى قبول أن رحمته عطية لا مطالبة، فتولد في القلب اتضاعا لا اعتراضا."
      }
    },
