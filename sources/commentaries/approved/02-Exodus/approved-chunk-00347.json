      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تأتي الآية جوابا لطلب موسى حضور الرب مع الشعب؛ فالقبول لا يقوم على استحقاق إسرائيل بل على النعمة التي وجدها موسى ومعرفة الرب له باسمه.",
        "theological": "يعرض النص قبول الرب للشفاعة: «هذا الأمر أيضا أفعله»، فتظهر النعمة كسبب معلن للاستجابة، والمعرفة بالاسم كعلامة قرب خاص من موسى.",
        "deep": "بعد تنازلات إلهية سابقة، لا يُوبَّخ موسى كطالب يلح، بل يُشجَّع؛ فالوعد يبيّن اتساع صلاح الرب حين يفعل أيضا ما تكلم عنه عبده.",
        "applied": "تعلّم الآية أن من يخدم في طريق التكليف يطلب حضور الرب واتجاهه بثقة، لا لنفعه وحده بل لخير الجماعة التي يحملها في صلاته."
      }
    },
