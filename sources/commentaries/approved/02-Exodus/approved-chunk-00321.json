      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأمر النص هارون أن يكفّر على قرون المذبح مرة في السنة بدم ذبيحة الخطية، معلناً قدسيته الفائقة.",
        "theological": "تبيّن الكفارة السنوية أن خطايا الكهنة والشعب تُحدث نجاسة طقسية في موضع الخدمة وتستلزم تطهيره.",
        "deep": "حتى المذبح المخصَّص للبخور يحتاج إلى تطهير بالدم؛ فالاقتراب من الله لا يفصل الخدمة عن معالجة الذنب.",
        "applied": "ينبغي ألا يطمئن الإنسان إلى ممارسته الدينية وحدها، بل يقر بحاجته المستمرة إلى تطهير الله لخدمته."
      }
    },
