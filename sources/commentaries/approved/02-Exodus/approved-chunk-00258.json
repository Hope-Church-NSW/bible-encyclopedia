      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشرح متى هنري أن هذا النص جزء من مجموعة أحكام قضائية تتلو تحذيرات بشأن الشهادة الزور والرشوة، وتخص وضع الغريب في التقاضي.",
        "theological": "يبيّن متى هنري أن الغريب وإن لم يكن له نصيب في الميراث بين بني إسرائيل إلا أنه يجب أن ينال العدل وأن يتمتع بحقه بسلام دون ظلم.",
        "deep": "يذكر متى هنري أن العلة المعطاة هي معرفتهم بأحوال الغريب وأحاسيسه لأنهم بأنفسهم كانوا غرباء في أرض مصر فذاقوا مرارة الغربة وخوفها.",
        "applied": "يدعو متى هنري إلى ألا يُحرم الغريب من العدل بسبب غربته، وأن تُستحضر تجربة إسرائيل في مصر دافعًا للرأفة به وعدم مضايقته."
      }
    },
