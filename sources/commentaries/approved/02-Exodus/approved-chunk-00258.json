          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن هذه الآية تفتتح تشريع السنة السبتية للأرض، حيث تُزرع الأرض وتُجمع غلتها ست سنوات متتالية قبل سنة الراحة.",
        "theological": "يرى متى هنري أن هذا الترتيب يكشف عن غنى الأرض التي وعد الله بها شعبه، إذ يكفيهم محصول ست سنوات دون حاجة إلى تجارة خارجية.",
        "deep": "يشير متى هنري إلى أن هذه السنوات الست تمهّد لدرس في الاتكال على عناية الله، إذ سيُختبر الشعب لاحقًا حين تُترك الأرض بلا زرع.",
        "applied": "يبيّن متى هنري أن العمل والجمع في هذه السنوات يجب أن يكونا بروح الطاعة لله لا بحرص جشع، استعدادًا لثقة أعمق به في سنة الراحة."
      }
    },
    "23:11": {
      "reference": "02-Exodus 23:11",
      "text": "وَأَمَّا فِي السَّابِعَةِ فَتُرِيحُهَا وَتَتْرُكُهَا لِيَأْكُلَ فُقَرَاءُ شَعْبِكَ. وَفَضْلَتُهُمْ تَأْكُلُهَا وُحُوشُ الْبَرِّيَّةِ. كَذلِكَ تَفْعَلُ بِكَرْمِكَ وَزَيْتُونِكَ.",
      "summary": "",
