      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأمر النص بتعليق رمانات من أسمانجوني وأرجوان وقرمز حول ذيل الجبة، مع أجراس ذهبية موضوعة بينها.",
        "theological": "يجمع تصميم الذيل بين الجمال والزينة المنظَّمة، فيؤكد أن خدمة الرب تُؤدَّى ضمن ما عيَّنه هو.",
        "deep": "وجود الأجراس بين الرمانات يجعل الزينة مسموعة ومرئية معاً، فلا تنفصل هيئة الثوب عن وظيفة الخدمة.",
        "applied": "تدعونا الآية إلى احترام تفاصيل العبادة والخدمة، فلا نعدّ ما رتبه الله أمراً ثانوياً أو قابلاً للازدراء."
      }
    },
