      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأخذ موسى القص من كبش ملء هارون ويردده أمام الرب، ثم يكون هذا القص نصيبه.",
        "theological": "تحديد القص لموسى يبيّن أن خدمة التكريس تشمل قسمة منظَّمة للذبائح أمام الرب.",
        "deep": "الترديد يسبق النصيب؛ فالحصة لا تُعامل كغنيمة شخصية بل كجزء قُدِّم أولاً لله.",
        "applied": "تعلّم الآية أن قبول نصيب الخدمة ينبغي أن يقترن بالشكر والتكريس لا بالشعور بالاستحقاق."
      }
    },
