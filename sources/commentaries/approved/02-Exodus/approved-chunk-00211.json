      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوضح متى هنري أن عدم ظهور المن في اليوم السابع يثبت أنه لم ينتج عن أسباب طبيعية بل هو عمل إلهي مباشر.",
        "theological": "انقطاع المن عن اليوم السابع يؤكد سلطة الله على القوانين الطبيعية وتأييده لسلطة التشريع الذي أعطاه موسى.",
        "deep": "الكلام الموجه للشعب بعدم البحث عن المن يكشف قصد الله في تعليمهم السبت من خلال الحرمان العملي وليس بالأمر المجرد.",
        "applied": "على المؤمن أن يتقبل قيود يوم الراحة لا كحكم قاسٍ بل كنعمة إلهية تحمي وقته المقدس للعبادة."
      }
    },
