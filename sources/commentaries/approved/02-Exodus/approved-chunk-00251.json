      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتناول الحكم رجلا راود عذراء غير مخطوبة واضطجع معها؛ فيلزمه المهر والزواج بها، مع حفظ حق أبيها في قبول الزواج أو رفضه.",
        "theological": "يرفع النص شأن الزواج ويعامل فعل الإغواء كضرر يلزم صاحبه بتعويض علني، لا كتصرف عابر بلا مسؤولية تجاه الفتاة وأسرتها.",
        "deep": "حتى حين يقرر القانون علاجا للخطأ، لا يلغي سلطان الأب؛ فالجبر المالي أو الزواج لا يمحو ضرورة الرضا العائلي وصيانة الكرامة.",
        "applied": "لا تتعامل مع العلاقات كمساحة بلا تبعات؛ من يضر بسمعة إنسان وكرامته يجب أن يتحمل مسؤولية واضحة لا أن يختبئ وراء الرغبة."
      }
    }
