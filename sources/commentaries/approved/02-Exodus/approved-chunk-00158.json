      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجل النص أثر البرد في الكتان والشعير، ويعلل إصابتهما بأن الشعير كان قد أسبل والكتان قد بذر.",
        "theological": "تظهر الضربة محددة في محاصيل كانت ظاهرة فوق الأرض، مؤكدة أن أحداث الدينونة تقع ضمن سلطان الرب على الخليقة.",
        "deep": "لا يذكر الوصف خسارة عامة مجردة، بل يبين أن مرحلة نمو النبات جعلته معرضا للبرد، فتتضح دقة الأثر.",
        "applied": "يدعونا تلف الكتان والشعير إلى عدم اعتبار مواردنا أمرا مضمونا، وإلى التعامل معها بشكر ومسؤولية أمام الرب."
      }
    },
