      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يميز موسى بين اعتراف فرعون السابق تحت وطأة الضربة وبين خشية الرب التي يعلم أنها لم تتحقق بعد فيه وعبيده.",
        "theological": "يكشف القول أن ألفاظ الندم وقت الخوف لا تكفي دليلا على خشية الرب؛ فالخوف الحقيقي يظهر في استجابة ثابتة له.",
        "deep": "مع أن موسى يتوقع رجوع فرعون، يبقى مستعدا أن يتشفع وينذره، فلا يلغي علمه بقساوة القلب واجب الأمانة.",
        "applied": "لا نزن توبتنا بما نقوله عند الألم، بل بما يستمر بعد زواله من مخافة للرب وترك لما يعارض أمره."
      }
    },
