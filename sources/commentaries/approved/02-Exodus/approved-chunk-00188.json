      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تشير الآية إلى وجود طريقين من مصر إلى كنعان، وأقربهما يمر بأرض الفلسطينيين المستعدين للحرب، بينما كان شعب إسرائيل حديث الخروج من العبودية وغير مؤهل لمواجهة القتال مباشرة.",
        "theological": "تكشف مراعاة الله لضعف شعبه؛ إذ لم يسر بهم في الطريق الأقصر لئلا يواجهوا حرباً تفوق قدرتهم فيندموا ويرجعوا إلى مصر، محولاً مسارهم بحكمة إلهية تحفظهم.",
        "deep": "يتجلى اللطف الإلهي في قيادة الشعب بتدرج متأنٍ؛ فالله يراعي حالة نفوسهم المنكسرة من السخرة ويدربهم تدريجياً على الاعتماد عليه قبل مواجهة المصاعب الكبرى.",
        "applied": "نتعلم أن المسار الأقصر ليس دائماً الأفضل في تدبير الله، بل علينا أن نثق ببرنامجه الرعوي الذي يقودنا بحسب طاقاتنا ويحمينا من التجربة التي تفوق احتمالنا."
      }
    },
