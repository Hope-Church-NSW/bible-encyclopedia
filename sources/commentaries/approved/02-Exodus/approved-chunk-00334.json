      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يشير متى هنري إلى أن هارون لم يوبخ الشعب على طلبهم، بل طالبهم بنزع أقراط الذهب من نسائهم وأبنائهم وبناتهم، ربما متوقعاً أن بخلهم وكبرياءهم سيعطلان المؤامرة.",
        "theological": "يكشف موقف هارون ضعف القيادة البشرية حين تهادن الخطيئة بدلاً من مواجهتها بالحزم الإلهي، مؤكداً أن مجاراة رغبات الجموع الفاسدة تورط في العصيان.",
        "deep": "توضح الآية خطورة المساومة والمراهنة على كبح شهوات الخطاة؛ فالقلب المنحرف مستعد للتضحية بأثمن ما يملك في سبيل إشباع رغباته الوثنية الفاسدة.",
        "applied": "يحذرنا الموقف من مداهنة الخطيئة أو تقديم حلول وسطية تساوم على الحق، فالواجب على القائد الروحي إعلان الحق ومواجهة الباطل بجرأة وأمانة."
      }
    },
