      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُحظر بناء المذبح من حجرٍ منحوتٍ، لأنّ رفع الأداة عليه يفسد المذبح ويُشوّه طهارته في عبادة الله.",
        "theological": "يُظهر الحكم أن العبادة لا تُقام على صورٍ من صنع الإنسان، بل على تواضعٍ يحفظ قدسية الموضع الذي يقدّمه المرء.",
        "deep": "الهيبة الإلهية لا تُصان بالتزيين، بل بالبساطة التي تُبقي المذبح بعيداً عن التمثيل والزخرفة.",
        "applied": "في الخدمة لا يطلب الله هيئةً مزخرفةً أو جسراً إلى العبادة، بل تواضعاً ووضوحاً يلتزم بهيكل المذبح وقصده."
      }
    },
