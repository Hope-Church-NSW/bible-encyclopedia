      "explanation_lines": {
        "academic": "قرون تُصنع من نفس مادة المذبح على زواياه الأربع، وتُغطى بنحاس.",
        "theological": "القرون للزينة والاستخدام: تُربط بها الذبائح وتكون ملجأ للخاطئ الهارب من العدالة.",
        "deep": "إلى قرون هذا المذبح يفرّ الخاطئ الفقير عندما يطارده العدل ويصير آمناً.",
        "applied": "الملتجئ بالذبيحة المقدمة على المذبح يجد الحماية والأمان من الدينونة."
      }
    },
