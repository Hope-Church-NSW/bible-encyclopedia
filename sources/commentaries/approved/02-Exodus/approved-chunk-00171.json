      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتحول الخطاب إلى كل جماعة إسرائيل، ويحدد اليوم العاشر لأخذ شاة، مع ربط الاختيار ببيوت الآباء وبوحدة البيت الواحد.",
        "theological": "يجمع الأمر بين الجماعة كلها والبيت المحدد؛ فالعبادة المشتركة لا تلغي مسؤولية الأسرة، بل تجعل كل بيت مشاركاً في الطاعة المعطاة للجميع.",
        "deep": "في لحظة العجلة والدهشة المرتقبة، لا يُعفى الشعب من الاستعداد للشعيرة المقدسة؛ إذ يبقى إكرام الله واجباً حتى حين تضيق الظروف.",
        "applied": "يدعو العدد الأسر إلى استقبال توجيه الله بصورة عملية ومنظمة، فلا تبقى المشاركة الروحية فكرة عامة بل تصير التزاماً يخص كل بيت."
      }
    },
