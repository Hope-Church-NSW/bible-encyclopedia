      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفتتح النص تعليم الفصح بخطاب مباشر من الرب إلى موسى وهارون في أرض مصر، تمهيداً لتبليغ نظام محدد للشعب.",
        "theological": "يبرز توجيه الكلام إلى موسى وهارون أن ترتيب العبادة لا ينشأ من المبادرة البشرية، بل من أمر إلهي يُسلَّم للأمانة في نقله.",
        "deep": "موضع الوحي في أرض مصر يبيّن أن ضغط الواقع لا يحجب حضور الله ولا يمنع تأسيس طاعة جديدة تقود الجماعة وسط انتظار الرحيل.",
        "applied": "حين تمتلئ اليد بالعمل والرأس بالهموم، يدعو هذا البدء إلى عدم إهمال العبادة، بل إلى الإصغاء لأمر الله قبل تدبير الخطوات."
      }
    },
