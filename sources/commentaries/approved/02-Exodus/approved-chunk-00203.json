      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تجري في مارّة مواجهة صعبة: الماء موجود لكنه مُرّ، فاسم الموقع من هذا الطعم المرّ يدل على التجربة التي تجعل الماء لا يُستعمل للراحة.",
        "theological": "هنا تتجلى حقيقة أن الخلاص لا يتمّ في غياب الألم، لأن ما يُستفاد منه غالبًا يمرّ بمرارة تُدفع إلى العناية الإلهية، لا إلى التذمر السريع.",
        "deep": "الماء المرّ يذكّر أن ما يبدو صالحًا للراحة قد يتحول إلى دعوة إلى التعلّق بالله، لأن سعادته لا تُؤتى من مجرّد وجود المورد بل من نبع الخلاص.",
        "applied": "عند ما ينقلب ما نطمح إليه إلى مرارة، يكون أول عمل أن نرفع الشكوى إلى الله لا إلى الناس، لأن المرارة قد تكون تدريبًا لا قضاءً."
      }
    },
