      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "مد موسى عصاه نحو السماء فأعطى الرب رعوداً وبرداً، وجرت نار على الأرض، وأمطر البرد على أرض مصر.",
        "theological": "الرعد والنار من السماء تجسد إرادة الله الحكيمة وقوته في تنفيذ الدينونة، فهي آلات عدله المرعبة.",
        "deep": "اجتماع البرد والرعد والنار يجعل الضربة أكثر هولاً وتدميراً، فتعدد وسائل العقاب يدل على عمق سخط الله.",
        "applied": "الإنسان الذي يسلم نفسه لله ويطيع أوامره يصبح آلة قوية للحكم الإلهي، وأولئك الذين يخالفون يواجهون كل قوى الطبيعة."
      }
    },
    "9:24": {
      "reference": "02-Exodus 9:24",
      "text": "فَكَانَ بَرَدٌ، وَنَارٌ مُتَوَاصِلَةٌ فِي وَسَطِ الْبَرَدِ. شَيْءٌ عَظِيمٌ جِدًّا لَمْ يَكُنْ مِثْلُهُ فِي كُلِّ أَرْضِ مِصْرَ مُنْذُ صَارَتْ أُمَّةً.",
      "summary": "",
