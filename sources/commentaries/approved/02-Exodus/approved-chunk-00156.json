      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "أمر الرب لموسى بمد يده نحو السماء لإحضار البرد على كل أرض مصر، على الناس والبهائم وكل نبات الحقل.",
        "theological": "سيادة الله على الطبيعة والسماء، فهو يحول الظواهر الطبيعية إلى أدوات لتنفيذ حكمه وعدله ضد المتمردين.",
        "deep": "شمولية الحكم الإلهي تطال كل المخلوقات والمنتجات: الإنسان والحيوان والنبات، لا استثناء للعاصي عن نطاق العقاب.",
        "applied": "الطاعة لأمر الله من خلال موسى تفتح السماء لقوة إلهية لا مثيل لها، والله قادر على إنزال حكمه على المتكبرين."
      }
    },
    "9:23": {
      "reference": "02-Exodus 9:23",
      "text": "فَمَدَّ مُوسَى عَصَاهُ نَحْوَ السَّمَاءِ، فَأَعْطَى الرَّبُّ رُعُودًا وَبَرَدًا، وَجَرَتْ نَارٌ عَلَى الأَرْضِ، وَأَمْطَرَ الرَّبُّ بَرَدًا عَلَى أَرْضِ مِصْرَ.",
      "summary": "",
