      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "عندما لاحظ الرب أن موسى انحرف لينظر إلى المشهد، ناداه الله باسمه مباشرة قائلاً: موسى، موسى، فأجاب: هأنذا.",
        "theological": "استجابة الله لفضول موسى بالدعوة المباشرة تظهر أن الله ينتظر استعدادنا للاستماع قبل أن ينادينا لمهمته.",
        "deep": "التكرار اسم موسى مرتين يعكس الخصوصية والعلاقة الشخصية، وإجابته السريعة تشير إلى استعداده الداخلي.",
        "applied": "عندما يناديك الله عبر ظروفك، يكفي جواب بسيط صادق: هنا أنا، مستعد لما تطلبه."
      }
    },
