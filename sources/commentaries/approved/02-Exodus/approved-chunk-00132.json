      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "موسى يُوجَّه لجمع شيوخ إسرائيل والقول للفرعون بطلب ملتمس للسفر ثلاثة أيام للعبادة.",
        "theological": "الحوار الحكيم يبدأ بالطلب المتواضع قبل الصراع، تجسيد لقبول المشيئة الإلهية في الأسلوب.",
        "deep": "البدء باللين والخضوع يعكس حكمة إلهية؛ الدعوة المعقولة لا تترك حجة للعاصي.",
        "applied": "في تعاملك مع المقاومة، ابدأ بالتوضيح الودي قبل المواجهة، كما علم الله موسى."
      }
    },
