      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "ينهى النص عن إيذاء الغريب أو مضايقته، ويربط هذا المنع بذاكرة إسرائيل نفسها حين عاشت غريبة في أرض مصر.",
        "theological": "تُظهر الوصية أن الإنسانية من مقتضيات الدين، وأن الله يلتفت إلى الغريب ولو لم تربطه بالجماعة صلة قرابة أو معرفة.",
        "deep": "الخبرة السابقة في الضيق ليست مبررا للقسوة عند القدرة، بل تصير أساسا أخلاقيا للتعاطف مع من يواجه الضعف نفسه.",
        "applied": "يمتنع المؤمن عن استغلال جهل الوافد أو حاجته في العقد أو الحكم، ويرفض التعيير والازدراء ويعامله بلطف واحترام."
      }
    },
