      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص خروج موسى من المدينة وبسط يديه للرب، ثم يقرر توقف الرعود والبرد وانقطاع المطر على الأرض.",
        "theological": "استجابة الدعاء هنا تعلن أن الرب يملك سلطاناً على الظواهر كلها؛ يرسلها ويوقفها لتظهر سيادته.",
        "deep": "اختيار موسى الخروج من المدينة يجمع الخلوة في الصلاة مع الثقة بأن الضربات لا تتحرك خارج توجيه الرب.",
        "applied": "يدعونا بسط اليدين إلى طلب الرحمة برجاء متواضع، والثقة بالرب وسط ما يثير الخوف من حولنا."
      }
    },
    "9:34": {
      "reference": "02-Exodus 9:34",
      "text": "وَلكِنْ فِرْعَوْنُ لَمَّا رَأَى أَنَّ الْمَطَرَ وَالْبَرَدَ وَالرُّعُودَ انْقَطَعَتْ، عَادَ يُخْطِئُ وَأَغْلَظَ قَلْبَهُ هُوَ وَعَبِيدُهُ.",
