      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأمر النص بصنع طوقين من ذهب، وهما جزءان من تجهيز الرداء الكهنوتي الذي يصفه المقطع.",
        "theological": "يُظهر الذهب في هذه الوصية أن لباس الكاهن الأعظم أُعِد بعناية تليق بخدمته أمام الرب.",
        "deep": "لا يقف الطوقان منفصلين في السياق، بل يمهّدان لربط السلاسل بهما كي يبقى تركيب الرداء متماسكًا.",
        "applied": "تدعو دقة الوصية إلى تقدير الخدمة المقدسة والالتزام بأمانة بالتفاصيل الموكلة إلى الإنسان."
      }
    },
