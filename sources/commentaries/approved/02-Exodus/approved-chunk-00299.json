      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبدأ العدد وصف صدرة القضاء، المصنوعة بعمل حائك حاذق وعلى مثال صناعة الرداء من مواد محددة.",
        "theological": "تُعرض الصدرة في التفسير كقطعة شريفة، مقترنة برداء الخدمة ولا يجوز فصلها عنه في الوظيفة.",
        "deep": "تنوع الذهب والأسمانجوني والأرجوان والقرمز والبوص المبروم يرسم عملاً متقنًا يوافق قدسية المهمة.",
        "applied": "يوجهنا الأمر إلى أن نقدّم ما بين أيدينا بإتقان، فلا نفصل جودة الخدمة عن شرف الغاية التي تخدمها."
      }
    },
