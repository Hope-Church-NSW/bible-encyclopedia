          "title": "لوحا الشهادة",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "خروج 24:12؛ 31:18؛ 32:15-20؛ 34:1-4؛ تثنية 9:9-17"
