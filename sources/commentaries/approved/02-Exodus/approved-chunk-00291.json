      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر متى هنري أن الشبكة النحاسية كانت تُجعل تحت حاجب المذبح من أسفل بحيث تصل إلى منتصف ارتفاعه، فتكوّن جزءًا داخليًا مجوّفًا لحفظ النار والذبيحة.",
        "theological": "يرى متى هنري أن هذا الترتيب الدقيق للمذبح جزء من نظام العبادة الذي أقامه الله ليتم من خلاله التواصل والشركة بين الرب وشعبه إسرائيل.",
        "deep": "يوضح متى هنري أن الشبكة كانت معلّقة بشكل مجوّف كالمنخل حتى تشتعل النار جيدًا وتسقط الرماد خلالها إلى جوف المذبح.",
        "applied": "يبيّن متى هنري أن العبادة كانت تُقدَّم في الدار أمام الخيمة لا داخلها، إذ كان الشعب كرعية يقفون هناك بخلاف الكهنة الذين يدخلون كخدام لله."
      }
    },
    "27:6": {
      "reference": "02-Exodus 27:6",
      "text": "وَتَصْنَعُ عَصَوَيْنِ لِلْمَذْبَحِ، عَصَوَيْنِ مِنْ خَشَبِ السَّنْطِ وَتُغَشِّيهِمَا بِنُحَاسٍ.",
      "summary": "",
      "sources": [
