      "explanation_lines": {
        "academic": "يوضح متى هنري أن العصوين كانتا تُدخَلان في الحلقات الأربع الموجودة على زوايا الشبكة لتكونا على جانبي المذبح حاملتين له.",
        "theological": "يذكر متى هنري أن ترتيب حمل المذبح بالعصوين كان ضمن الوصايا التي أعطاها الله لموسى ليُنقل بها المذبح أثناء تنقل الشعب.",
        "deep": "يشرح متى هنري أن وضع العصوين على الجانبين معًا كان يتيح حمل المذبح بتوازن دون المساس مباشرة بجسمه المقدس.",
        "applied": "يبيّن متى هنري أن هذا الترتيب يعلّم أن خدمة الله تحتاج نظامًا دقيقًا حتى في أمور تبدو عملية كحمل الأدوات المقدسة."
      }
    },
    "27:8": {
      "reference": "02-Exodus 27:8",
      "text": "مُجَوَّفًا تَصْنَعُهُ مِنْ أَلْوَاحٍ، كَمَا أُظْهِرَ لَكَ فِي الْجَبَلِ هكَذَا يَصْنَعُونَهُ.",
