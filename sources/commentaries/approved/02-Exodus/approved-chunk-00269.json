        {
          "id": "encyclopedia:zah-lordly-appearance",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "ظهور المجد",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "خروج 24:16-17؛ إشعياء 60:1-3؛ لوقا 2:9؛ 2 كورنثوس 3:18"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص المجد المرئي على قمة الجبل كما تراه جماعة بني إسرائيل، مشبهاً إياه بنار آكلة أمام عيونهم.",
        "theological": "يكشف هذا المنظر رهبة حضور الله عند إعطاء الشريعة؛ فالمجد الظاهر كنار آكلة يدعو السامعين إلى طاعةٍ جادة.",
        "deep": "تجتمع العلامة الظاهرة مع الغموض: فالسحاب يحجب الحضور، ثم يلمع المجد ناراً، فيُعرَف الله دون أن يُدرَك كمالاً.",
        "applied": "تستدعي رهبة المجد استجابة مطيعة لا فضولاً عابراً؛ فمعرفة سلطان الله تجعل الوقوف أمامه وقوراً وجاداً."
      }
    },
