      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأتي جواب موسى بعد خوف الشعب وتذمره، فيستبدل اللوم بتشجيع هادئ ووعد بخلاص قريب وحاسم من المطاردين.",
        "theological": "ينسب القول الخلاص إلى الرب وحده، ويؤكد أن الضيق الذي يقع فيه الشعب لا يمنع الله من إظهار طريق النجاة.",
        "deep": "الدعوة إلى الوقوف والنظر لا تعني إنكار الخطر، بل تهدئة القلب لكي يميّز عمل الله بدل أن يستسلم للذعر.",
        "applied": "عند انسداد الخيارات، لا تجعل الخوف يصمت الرجاء؛ اهدأ وانتظر توجيه الله قبل أن تبني قراراتك على الاضطراب."
      }
    },
