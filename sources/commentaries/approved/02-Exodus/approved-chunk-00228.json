      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "حدُّ الجبل المحظور بعقوبة الموت بالرجم أو الرمي يُظهِر قَدسية الموضع أثناء ظهور الإله بشكل مباشر.",
        "theological": "صوت البوق الطويل يشير إلى الانتقال من منع الاقتراب إلى إباحته للشعب المقدّس ليقفوا عند الجبل.",
        "deep": "عقوبة الموت لمس الجبل تعكس قُدس الله الرهيب الذي يتطلب انفصالاً مطلقاً عند مواجهته المباشرة.",
        "applied": "احترام الحدود التي يضعها الله أساسي، وفهم أن الاقتراب منه يتطلب تحضيراً وتقوى صادقة."
      }
    },
