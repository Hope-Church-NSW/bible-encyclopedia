      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُؤمر الكهنة المقربون إلى الرب أن يتقدّسوا، لأن القرب لا يبرر التجاوز أو إهمال حرمات الرب.",
        "theological": "القداسة ليست تمييزاً شرفياً بل استعداداً للالتزام، إذ لا يُسمح بحدوث بطش الرب على من يقترب بلا تقديس.",
        "deep": "القرب لا يلغي الخطر إذا فُقدت الهيبة، لأن كلّ مقامٍ للرب يحتاج لحدوده ليبقى في سعةٍ لا في غفلة.",
        "applied": "من يخدم الرب يجب أن يعلّم نفسه التقديس، لا أن يظنّ أن المكان أو الولاية ترفع عن حدود الله."
      }
    },
    "19:23": {
      "reference": "02-Exodus 19:23",
      "text": "فَقَالَ مُوسَى لِلرَّبِّ: «لاَ يَقْدِرُ الشَّعْبُ أَنْ يَصْعَدَ إِلَى جَبَلِ سِينَاءَ، لأَنَّكَ أَنْتَ حَذَّرْتَنَا قَائِلاً: أَقِمْ حُدُودًا لِلْجَبَلِ وَقَدِّسْهُ».",
