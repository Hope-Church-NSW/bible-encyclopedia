      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يأمر الله موسى بأن يهبط ويحذّر الشعب من اقتحام حدود الجبل، لأن النظر دون إذن يسبب سقوط كثيرين.",
        "theological": "في هذا الوعظ تظهر حرمة حضور الرب، إذ لا تُؤخذ الجلالة كفرصة للفضول بل كخضوع لهيبته وقيوده.",
        "deep": "الحدود ليست قيداً تعسفياً، بل حمايةً للقلب من أن يتحول الحضور الإلهي إلى رغبةٍ تقتل الخوف الواجب.",
        "applied": "في العبادة لا يطلب الإنسان معرفةً فوق ما أذن به الرب، بل يلتزم التقوى والهوية في احترام قدسيته."
      }
    },
