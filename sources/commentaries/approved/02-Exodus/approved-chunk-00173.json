      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يمنع الأمر ادخار شيء من الحمل إلى الصباح، ويقضي بإحراق ما يبقى بالنار عند حلول الصباح.",
        "theological": "يفسر الشارح منع البقايا بأنه دعوة للاعتماد على الله في القوت اليومي وعدم الانشغال القلق بالغد.",
        "deep": "لا يقدّم الفصح طعامًا للاحتفاظ به، بل وجبة مرتبطة بساعة الخروج والثقة بمن يقود الشعب ويعوله.",
        "applied": "يقاوم النص عادة تأجيل الاستجابة؛ فالمعروض اليوم يُستقبل اليوم، بدل تأخير الطاعة إلى وقت غير مضمون."
      }
    },
