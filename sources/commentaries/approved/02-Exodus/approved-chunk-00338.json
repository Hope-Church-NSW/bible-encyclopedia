      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "عند اقتراب موسى رأى العجل والرقص، فاشتعل غضبه وطرح لوحي الشهادة وكسرهما أسفل الجبل؛ يجمع السرد بين الرؤية والفعل الرمزي.",
        "theological": "كسر اللوحين أمام الشعب يصوّر أنهم بخطيتهم أضاعوا القبول المعروض لهم، إذ نقضوا عهداً كان مهيأً للتثبيت.",
        "deep": "لا يقدّم التفسير كسر اللوحين كانفجاراً شخصياً فحسب، بل كعمل عدل يوقظ الشعب إلى جسامة إساءتهم وإلى البركات التي فقدوها.",
        "applied": "ليكن غضبك موجهاً إلى الشر بوصفه إساءة إلى الله لا انتصاراً للذات، وليهدف التعبير عنه إلى تنبيه المخطئ لا إلى التشفي منه."
      }
    },
    "32:20": {
      "reference": "02-Exodus 32:20",
      "text": "ثُمَّ أَخَذَ الْعِجْلَ الَّذِي صَنَعُوا وَأَحْرَقَهُ بِالنَّارِ، وَطَحَنَهُ حَتَّى صَارَ نَاعِمًا، وَذَرَّاهُ عَلَى وَجْهِ الْمَاءِ، وَسَقَى بَنِي إِسْرَائِيلَ.",
