      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يسجّل النص أن يشوع فسّر الهتاف المسموع في المحلّة بوصفه صوت قتال، وهو استنتاج نابع من طبيعة الصوت لا من مشاهدة الحدث.",
        "theological": "يكشف تمييز موسى اللاحق للصوت أن المعرفة الأدق بالموقف لا تقوم دائماً على الانطباع الأول، بل على إدراك حقيقة ما يجري.",
        "deep": "كان يشوع مستعداً ليلزم موسى بعد انتظار طويل، لكن خبرته العسكرية جعلته يقرأ الضجيج كإنذار حرب؛ وقد يخطئ السامع حين يحكم من صوته وحده.",
        "applied": "عند سماع خبر أو ضجيج مقلق، لا تتعجل في بناء حكمك على الظاهر؛ افحص الوقائع قبل أن تتعامل معه كأزمة أو خصومة."
      }
    },
