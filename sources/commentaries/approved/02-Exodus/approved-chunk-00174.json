      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يحدد العدد سبعة أيام للفطير، ويبدأ بعزل الخمير من البيوت؛ ومخالفة هذا الحكم طوال المدة تستتبع القطع من إسرائيل.",
        "theological": "تُظهر صرامة الأمر أن الاشتراك في عيد الفطير ليس اختيارًا هامشيًا، بل طاعة جماعية تذكّر الشعب بخروجه وبتدبير الله له.",
        "deep": "إزالة الخمير من البيت تجعل التذكار شاملًا للمكان والعادة والطعام؛ فالاحتفال يطلب يقظة دقيقة لا مجرد حضور شكلي للعيد.",
        "applied": "تدعو الآية إلى فحص ما يتسلل إلى الحياة اليومية ويعطّل الطاعة، وإلى التعامل الجاد مع أوامر العبادة بدل تأجيلها أو تخفيفها."
      }
    },
