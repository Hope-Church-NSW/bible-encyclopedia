      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تصوّر الآية نهاية المصريين في البحر: اللجج غطّتهم، وهبطوا في الأعماق كحجر، في وصف مباشر لا يترك مجالا لنجاتهم.",
        "theological": "يرى المصدر أن هذا كان فعل الرب وحده؛ فالمياه التي انفتحت للنجاة صارت أداة دينونة على العدو الذي قاومه.",
        "deep": "ثقل الحجر في الأعماق يبرز سقوطا حاسما؛ فالعدو لم يغلب بقوة بشرية، بل غمرته نتائج ذنبه وغضب الله العادل.",
        "applied": "حين تُرى النجاة بعد الخطر، لا يليق الصمت؛ فالآية تدعو الذاكرة إلى تسبيح سريع قبل أن تبهت آثار الرحمة في القلب."
      }
    },
