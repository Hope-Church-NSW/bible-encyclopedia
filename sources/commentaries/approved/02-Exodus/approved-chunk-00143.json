      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "موسى وهارون كانا الحوار الرسمي مع فرعون ملك مصر بشأن إطلاق سراح بني إسرائيل من العبودية.",
        "theological": "الاسم الصريح لموسى وهارون يؤكد مسؤوليتهما المباشرة والشخصية أمام فرعون بتبليغ رسالة الله.",
        "deep": "المحادثة مع فرعون لم تكن مصادفة بل نتيجة اختيار إلهي وتكليف خاص بهما دون غيرهما.",
        "applied": "الشهادة والدعوة تحتاج إلى شخص مسؤول ومكلف، وليست عملية جماعية عشوائية بل موكلة لمن يختاره الله."
      }
    },
