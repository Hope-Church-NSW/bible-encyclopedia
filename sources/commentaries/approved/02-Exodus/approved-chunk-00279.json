      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "الملاقط والمنافض المصاحبة للسرج مصنوعة من ذهب نقي، وهي أدوات عملية لخدمة المنارة.",
        "theological": "استخدام الذهب النقي في جميع أجزاء المنارة وأدواتها يعكس كمال العمل وطهارة الخدمة في حضرة الله.",
        "deep": "الاهتمام بتفاصيل الأدوات الصغيرة يدل على أن كل جزء من خدمة الله، مهما بدا صغيراً، يستحق الكمال والقداسة.",
        "applied": "المؤمنون مدعوون للعناية بالتفاصيل في خدمتهم الروحية، مثلما كانت كل أداة في خيمة الاجتماع محضرة بعناية."
      }
    },
