      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر متى هنري أن الرب أمر موسى بنحت لوحين جديدين ليكتب عليهما الكلمات التي كانت على اللوحين الأولين اللذين كسرهما موسى، مما يمهّد الطريق لتجديد العهد بعد كسره.",
        "theological": "يوضح متى هنري أن الله وحده صنع اللوحين الأولين وكتب عليهما، أما الآن فموسى ينحت اللوحين والله وحده يكتب عليهما، إشارة إلى أن كتابة الشريعة تبقى عمل الله وحده.",
        "deep": "يرى متى هنري أن هذا التجديد يعلّم أنه عندما يكسر الإنسان العهد بالخطية لا يُستأنف العمل من حيث توقف بل يبدأ من جديد تمامًا، كما ينبغي للمرتدين أن يتوبوا ويعملوا أعمالهم الأولى.",
        "applied": "يشير متى هنري إلى أن قلب الإنسان الحجري يحتاج أن يُنحت بالتوبيخ والاتضاع عن الخطية ويُنعّم قبل أن تُكتب فيه شريعة الله من جديد."
      }
    },
