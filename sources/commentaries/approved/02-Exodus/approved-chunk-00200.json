      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف النص حركة الريح الإلهية بوصفها سبب غطاء البحر، ثم يصور السقوط العميق كالرصاص في الماء الغامر، فتتّحد قوة الطبيعة وعلو الحكم في صورة واحدة.",
        "theological": "هنا يبرز أن الرب لا يحتاج إلى سيف الإنسان بل يكفيه نفخة من ريحه ليغطي أعداءه، ويجعل الهلاك أقسى من وزن الرصاص في المياه.",
        "deep": "يُحسّ القارئ أن التدمير لم يأتِ من حيلة بل من حضور إلهيّ، فالمعركة انتهت بطمس للانفجار المتهوّر في صمت لا يُقاوم.",
        "applied": "يؤكد هذا النص أن التوكل على الرب يفتح بابًا للطمأنينة، لأن الذين يرفعون سلطانهم يبقى الله هو الذي يغيّر مجرى البحر والهوية."
      }
    },
