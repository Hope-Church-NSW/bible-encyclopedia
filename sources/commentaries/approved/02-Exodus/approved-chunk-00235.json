      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "الوصية عن الزنى تبيّن أن المأمور به هو العفة، لأن الشهوة والفساد الجسدي يضران بالنفس كما يفسدان العلاقة مع الآخرين، كما يذكر متى هنري.",
        "theological": "الزنى لا يُفهم كخطيئة منفصلة فقط بل كاستسلام للشهوة التي تعارض الطهارة والسكينة الروحية، فتقود إلى تضييع كرامة الجسد.",
        "deep": "الآية تنبه إلى أن الشهوة لا تبدأ دائما في الفعل، بل في النظر والهوى والاشتغال بما يهيّج النفس، وهو ما يفسد الروح والاعتدال.",
        "applied": "يُحافظ على العفاف بالابتعاد عن ما يهيّج الشهوة، ومراقبة الفكر، والحرص على حياة تمسك بالنظافة والاحترام."
      }
    },
