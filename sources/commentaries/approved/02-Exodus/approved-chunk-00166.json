      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصرّ موسى على اصطحاب جميع المواشي، فلا يُترك ظلف واحد، لأنهم سيأخذون منها ما يلزم لعبادة الرب عند وصولهم.",
        "theological": "تُظهر العبارة أن شروط العبادة ليست محل تفاوض؛ فالناس مدعوون إلى الاستجابة لمطالب إرادة الله لا إلى خفضها حسب شروطهم.",
        "deep": "عدم معرفة عدد الذبائح وأنواعها قبل الوصول يفسر شمول الطلب: الاستعداد للطاعة يقتضي إبقاء الموارد المتاحة في خدمة الرب.",
        "applied": "يدعونا النص إلى عدم حجز ما نملكه عن طاعةٍ قد تتضح تفاصيلها لاحقًا، بل إلى الاستعداد لتكريم الله بما بين أيدينا."
      }
    },
