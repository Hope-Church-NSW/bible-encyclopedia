      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "جبل سيناء كله يدخن لأن الرب نزل عليه بالنار، فصعد دخان كدخان الأتون وارتجف الجبل كله.",
        "theological": "حضور الرب في النار والدخان يثبت أن الوحي يجيء في جلال لا يمر بلا هيبة، وأن التشريع مقام مخافة.",
        "deep": "الجبال ترتجف عند مجيء الرب، لأن الجلال الإلهي يضطرب ما هو مخلوق ويكشف عظمة الخالق.",
        "applied": "حين يقترب الإنسان من الله لا يطلب سهولة، بل يقف في جلال، لأن معرفة الرب تفرض خشوعًا لا تصنعًا."
      }
    },
