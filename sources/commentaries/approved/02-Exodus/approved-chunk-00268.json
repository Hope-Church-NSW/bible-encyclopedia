        {
          "id": "encyclopedia:zah-lordly-appearance",
          "relation": "encyclopedia",
          "scope": "verse_or_passage",
          "title": "ظهور المجد",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "خروج 24:16-17؛ إشعياء 60:1-3؛ لوقا 2:9؛ 2 كورنثوس 3:18"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "استقرّ مجد الرب على جبل سيناء، وغطّته السحابة ستّة أيام، وفي اليوم السابع دعا الله موسى من وسط السحاب ليدخل إلى حضرته.",
        "theological": "يرى متى هنري أنّ الله جرّب بهذا صبر موسى وطاعته للوصيّة «كن هناك»؛ فالشركة مع الله تستحقّ الانتظار، ولا ينال امتيازها المستعجل.",
        "deep": "لو ملّ موسى قبل اليوم السابع كما فعل شاول حين لم ينتظر، لخسر كرامة الدخول في السحاب؛ فالانتظار نفسه جزء من إعداد القلب للقاء.",
        "applied": "قابل مواعيد الله ووسائط النعمة بوقفة تأمّل وتهيئة للقلب، ولا تستعجل الجواب؛ فالوقت المبذول في انتظار الله ليس ضياعًا بل استعدادًا."
      }
    }
