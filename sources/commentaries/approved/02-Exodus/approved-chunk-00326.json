      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوجه موسى أن يعلن لبني إسرائيل أن هذا الدهن دهن مقدس للمسحة في أجيالهم، أي نظام محفوظ وممتد.",
        "theological": "استمرار الدهن في الأجيال يبين أن الله لا يترك شعائر خدمته للاجتهاد العابر، بل يثبت لها وصفا مقدسا.",
        "deep": "قوله لي يجعل الدهن منسوبا إلى الله قبل الشعب؛ قيمته ليست في رائحته أو تركيبته فقط، بل في كونه مخصصا له.",
        "applied": "تعلّم الآية أن ما عيّنه الله لعبادته ينبغي حفظه عبر الأجيال بوقار، لا تبديله حسب الذوق أو العادة."
      }
    },
