      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تصف الآية الأمر بإنشاء غطاء التابوت من ذهب خالص بأبعاد دقيقة تبلغ ذراعين ونصفاً طولاً وذراعاً ونصفاً عرضاً ليتطابق تماماً مع قياسات التابوت.",
        "theological": "يمثل هذا الغطاء كفارة الموضع الذي يستر التعديات ويفصل بين متطلبات الشريعة وحكمها وبين الإنسان، مؤكداً استيفاء العدل الإلهي وإظهار النعمة.",
        "deep": "يعكس صنع الغطاء من الذهب النقي مكانة الرحمة الفائقة فوق الشريعة، حيث تلتقي العدالة الإلهية بالمغفرة الكاملة لتغطية كسر الإنسان للشريعة.",
        "applied": "يدعونا هذا الغطاء للتقرب بثقة إلى عرش النعمة، مطمئنين إلى أن رحمة الله المغطية تستر زلاتنا وتفتح لنا باب الغفران والشركة معه."
      }
    },
