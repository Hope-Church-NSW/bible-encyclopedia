      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يذكر متى هنري أن القميص المخرّم من بوص والعمامة من بوص والمنطقة المطرزة هي بقية ثياب الكهنوت التي اكتُفي بذكرها هنا لأنه لم يكن فيها ما يستدعي شرحًا مطوّلًا كسابقاتها.",
        "theological": "يرى متى هنري أن العمامة المصنوعة من بوص كانت شبيهة بتيجان الملوك في الشرق قديمًا، فرمزت في نظره إلى الوظيفة الملوكية للمسيح الذي جمع الكهنوت والملك معًا.",
        "deep": "يلاحظ متى هنري أن هذه الثياب رغم بساطتها الظاهرة كانت جزءًا لا يتجزأ من الترتيب الكهنوتي الكامل، فالقميص يصل إلى القدمين والمنطقة تشد الجسد بعمل صنّاع ماهرين.",
        "applied": "يذكّرنا هذا بأن الأمور التي تبدو بسيطة أو عادية في خدمة الرب لها قيمتها وموضعها، فلا نستهين بما لا يلفت الأنظار من واجباتنا مادام جزءًا من ترتيب الرب."
      }
    },
