      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يتضرع موسى إلى الرب إلهه، ويرد الشعب إلى نسبته لله: شعبك الذي أخرجته أنت من مصر بقوة عظيمة ويد شديدة.",
        "theological": "حجة موسى تقوم على ملكية الله للشعب وعلى عمل الخلاص السابق؛ فالعلاقة سبب للتأديب لا للإفناء التام.",
        "deep": "امتلاء صلاة موسى بالحجج لا يعني تغيير علم الله، بل يعلن إيمانه ويوقظ حرارة توسله أمام الرب.",
        "applied": "حين تصلي لأجل جماعة خاطئة، استند إلى مراحم الله وأعماله السابقة، واعترف أنك خادم لا مالك للناس."
      }
    },
