      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصرح الرب بأن إقامة فرعون كانت لإظهار القوة فيه ولإعلان الاسم في كل الأرض، فيجعل مصير الملك موضوعا ذا دلالة تتجاوز شخصه.",
        "theological": "يرى المصدر في فرعون علامة باقية لعدل الرب وقوته؛ فسيادته التي لا تقهر وقوته الغالبة وعدله الثابت تظهر في إسقاط المتكبر.",
        "deep": "حتى طول بقاء الحاكم الشرير ونمو كبريائه يدخلان في المشهد الذي يعلن قوة الرب؛ فلا يمنح المنصب الرفيع حصانة من التواضع أمامه.",
        "applied": "يدعونا النص إلى الحذر من اعتبار القوة أو المكانة دليلا على الاستقلال؛ فالاستجابة المتواضعة للرب خير من التمادي في التعالي."
      }
