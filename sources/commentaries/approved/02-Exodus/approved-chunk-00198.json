      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُفهم التعبير «رجل الحرب» بوصفه توكيداً على أن الله هو الفاعل في النصر، لا مجرد شريك في المعركة، ما يليق بموقفه كحاكم وعامل في القضاء.",
        "theological": "تؤكد العبارة أن اسم الرب هو الذي يحدّد طبيعة فعله، فالقوة تخرج من شخصيته لا من قوة جيش أو سلاح، فيعبر عن قدرته المتميزة في محاربة العدو.",
        "deep": "في هذا البيان يخفف الارتباك المبدئي عن المذعورين، لأن الفرح لا يتبع انتصار شعب بل يتبعه الاعتراف بأن الله يبقى المتصدّي لكل من يقف في وجهه.",
        "applied": "ينبغي أن يقتنع المؤمن أن الخوف من الأعداء لا ينبغي أن يطغى على الثقة بربّه، إذ قدرة الرب فوق كل جندٍ ومخطط."
      }
    },
