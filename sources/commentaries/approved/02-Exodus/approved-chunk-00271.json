          "title": "سكنى الله",
          "source_file": "encyclopedia_ar.json",
          "references": [
            {
              "relation": "encyclopedia",
              "text": "خروج 25:8؛ 40:34-38؛ يوحنا 1:14؛ رؤيا 21:3"
            }
          ]
        }
      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يُطلب أن يصنع لهم مقدساً ليحلّ الله في وسطهم، فأساس العبادة هو أن تكون ملامح الله في حياة الشعب واضحة.",
        "theological": "هذه الجملة تضع هدف بناء المسكن المقدس في مركز النص: أن يختار الله مكاناً وسط شعبه ليتجلى حضوره.",
        "deep": "الحضور الإلهي لا يبتعد عن وسط المجتمع، بل يطلب أن يكون الله في الوسط لا على الهامش.",
        "applied": "يُستدعى المؤمن اليوم إلى أن يفتح قلبه وبيته وموارده ليكون موضع حضور الله، لا مجرد مكان للطقوس."
      }
    }
