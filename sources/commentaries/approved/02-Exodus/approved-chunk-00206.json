      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "موسى وهارون يخبران بني إسرائيل أنهم سيعلمون عند المساء أن الرب أخرجهم من مصر، وهذا وعد بإظهار قوة الله في إمداده لهم.",
        "theological": "معرفة الله تأتي من اختبار عنايته العملية، فكل ما يفعله الرب لشعبه يشهد على قدرته وحنانه وتحررهم من العبودية.",
        "deep": "المساء يمثل الوقت الذي تتحقق فيه معرفة الله بين شعبه، لأن رؤية الخبز الحقيقي تثبت أن الذي أخرجهم هو الرب الذي يرعاهم.",
        "applied": "اختبار الحاجة يجلب معرفة حقيقية بعناية الله، والإنسان يجب أن ينتظر إثبات الله لحضوره بدلاً من الاستسلام لليأس والتذمر."
      }
    },
