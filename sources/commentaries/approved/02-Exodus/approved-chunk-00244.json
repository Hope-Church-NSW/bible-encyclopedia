      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تعالج الآية أذى امرأة حبلى وقع أثناء خصام رجال؛ فإذا خرج جنينها بلا أذى لاحق، فالغرامة تخضع لمطالبة الزوج وحكم القضاة.",
        "theological": "يبرز التفسير عناية الشريعة الخاصة بالحامل، إذ تطلب الحذر من أذى قد يمس الأم وجنينها معًا.",
        "deep": "لا يترك النص تقدير التعويض لرغبة المتخاصمين وحدها، بل يجمع بين دعوى الأسرة وفصل القضاة لضبط مقدار الجزاء.",
        "applied": "يلزم في النزاعات تجنب الأفعال المتهورة التي تصيب الأبرياء، وإذا وقع ضرر فليكن التعويض منظمًا بعدل لا بدافع الانتقام."
      }
    },
