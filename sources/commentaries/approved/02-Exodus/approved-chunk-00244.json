      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "تستثني الآية حالة بقاء الخادم يومًا أو يومين بعد الضرب من العقوبة المذكورة في الآية السابقة، وتربط ذلك بخسارة السيد لخادمه.",
        "theological": "يعرض التفسير هذا الحكم ضمن إدانة القسوة؛ فلا يبرر تسلط السيد، بل يحذّر كل سيد من معاملة من تحت يده بعنف.",
        "deep": "يكشف الاستثناء صعوبة فصل الضرر عن مسؤوليته في الوقائع القضائية، لكنه لا يلغي أن موت الخادم تحت يد سيده يستوجب العقاب.",
        "applied": "ينبغي لمن يملك سلطة على غيره أن يرفض التهديد والإيذاء، وأن يتذكر أن خسارة المنفعة لا تعفيه من واجب الرحمة وضبط النفس."
      }
    },
    "21:22": {
      "reference": "02-Exodus 21:22",
      "text": "وَإِذَا تَخَاصَمَ رِجَالٌ وَصَدَمُوا امْرَأَةً حُبْلَى فَسَقَطَ وَلَدُهَا وَلَمْ تَحْصُلْ أَذِيَّةٌ، يُغَرَّمُ كَمَا يَضَعُ عَلَيْهِ زَوْجُ الْمَرْأَةِ، وَيَدْفَعُ عَنْ يَدِ الْقُضَاةِ.",
