      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يصف العدد إلباس هارون وبنيه الثياب ثم مسحهم وتكريسهم وتقديسهم، فيجعل هذه الأفعال بداية رسمية لتوليتهم خدمة الكهنوت.",
        "theological": "لا تُمنح خدمة الكهنوت هنا بالقرابة وحدها؛ فالاختيار يقتضي تقديسًا وتكريسًا ظاهرين قبل أن يخدم الكاهن الرب.",
        "deep": "اجتماع اللباس والمسح والتكريس يبيّن أن الاقتراب للخدمة ليس شأنًا عاديًا، بل قبول لمسؤولية مقدسة محددة بأمر الله.",
        "applied": "يدعو العدد من يتولى خدمة عامة إلى ألا يكتفي بالمنصب أو المظهر، بل أن يطلب الاستعداد والتقديس اللذين يوافقان الخدمة."
      }
    },
