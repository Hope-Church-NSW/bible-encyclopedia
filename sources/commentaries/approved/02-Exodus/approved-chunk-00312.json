      ],
      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يوجّه النص أن يُؤخذ من دم المذبح ومن دهن المسحة معًا، فيُنضح على هارون وثيابه وعلى بنيه وثياب بنيهم، فيتقدّس الأشخاص واللباس معًا في فعل واحد.",
        "theological": "يلاحظ متى هنري أن دم الذبيحة قُسم بين الله وبينهم: جزء رُشّ على المذبح وجزء وُضع عليهم، فصار نفع الكفارة مطبَّقًا لهم ومؤكَّدًا عندهم.",
        "deep": "النضح على الثياب لا يلطّخها بل يزيّنها؛ فما نحسبه بقعة يجعله الله علامة تكريس، إذ يُخصَّص الإنسان كله من رأسه إلى قدمه لخدمة الله.",
        "applied": "لا تخجل من العلامات التي يتركها انتماؤك لله على حياتك الظاهرة؛ فالخدمة المقبولة تبدأ من قلب مطهَّر وتمتد إلى ثيابك وسلوكك اليومي أمام الناس."
      }
    },
    "29:22": {
      "reference": "02-Exodus 29:22",
      "text": "ثُمَّ تَأْخُذُ مِنَ الْكَبْشِ: الشَّحْمَ وَالإِلْيَةَ وَالشَّحْمَ الَّذِي يُغَشِّي الْجَوْفَ، وَزِيَادَةَ الْكَبِدِ وَالْكُلْيَتَيْنِ، وَالشَّحْمَ الَّذِي عَلَيْهِمَا، وَالسَّاقَ الْيُمْنَى. فَإِنَّهُ كَبْشُ مِلْءٍ.",
