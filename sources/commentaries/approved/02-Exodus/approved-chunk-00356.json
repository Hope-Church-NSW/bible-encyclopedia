      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "بادر موسى بدعوة الشعب المتخوف، فرجع إليه هارون ورؤساء الجماعة أولاً ليستمعوا إلى كلامه ويتواصلوا معه.",
        "theological": "تتجلى نعمة القيادة الروحية في مبادرة النبي لتبديد الخوف وتقريب الخائفين لاستعادة التواصل والشركة.",
        "deep": "تظهر عودة الرؤساء أولاً دور القادة في تشجيع الجماعة وتجاوز الرهبة للوصول إلى كلمة الرب بقلب مطمئن.",
        "applied": "تشجعنا دعوة موسى على مبادرة الآخرين بالمحبة واللطف لإزالة مخاوفهم وبناء جسور التواصل الروحي معهم."
      }
    },
