      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يفسر متى هنري هذه الآية بأنها تجعل السحر جريمة عقوبتها الموت، ويقارنها بقانون بلاده الذي يعاقب من يستحضر الأرواح الشريرة أو يمارس السحر بالإعدام أيضًا.",
        "theological": "يبيّن هنري أن الساحر يعطي للشيطان الكرامة التي تخص الله وحده، ويتحدى تدبير الله، ويحارب حكم الله، فيجعل من الشيطان إلهًا للعالم زورًا وبهتانًا.",
        "deep": "يشدد هنري على أن هذه العقوبة القاسية لائقة خصوصًا بشعب أنعم الله عليه بإعلان إلهي وعناية خاصة تفوق كل شعب آخر تحت الشمس، فلا عذر لهم في اللجوء للسحر.",
        "applied": "يحذر هنري من طلب المعرفة أو القوة الخفية عبر الأرواح الشريرة بدل الاتكال على الله، فهذا تعدٍ على حق الله وحده في التدبير والعناية بشعبه."
      }
    },
