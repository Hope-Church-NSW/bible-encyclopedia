      "status": "approved_four_line_commentary",
      "explanation_lines": {
        "academic": "يبدأ الله بتعريف نفسه: أنا الرب إلهك، مذكّراً بأنّ حقه في الطاعة يستند إلى ألوهيته وعلاقة العهد ونجاته.",
        "theological": "التسليم إلى الله لا يقتصر على الخوف، بل على عهدٍ له به، لأنّه أخرجهم من مصر وجعلهم له شعباً.",
        "deep": "الذكرى تُشعل التزكية: من عاين الخلاص لا يحق له أن يطلب خدمةً غير الله، بل يردّ الجميل بامتثالٍ مملوءٍ بالشكر.",
        "applied": "تُذكّر الآية أن العبودية للرب تُفهم من منطلق الخلاص لا من مجرد نظام، فالحب الحقيقي يُعبر عنه بالطاعة."
      }
    },
