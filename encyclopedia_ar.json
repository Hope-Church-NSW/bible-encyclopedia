<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>موسوعة الكتاب المقدس</title>

<style>

/* =========================================================
   ROOT
========================================================= */

:root{
    --bg:#061321;
    --bg2:#0a1b2d;
    --panel:#0d2138;
    --panel2:#102a45;

    --gold:#d8b35a;
    --gold2:#f0d58b;

    --text:#f3f6fa;
    --muted:#aebdca;

    --border:rgba(216,179,90,.28);

    --success:#76d69a;
    --danger:#ff9b9b;

    --shadow:0 18px 50px rgba(0,0,0,.35);
}


/* =========================================================
   GLOBAL
========================================================= */

*{
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    margin:0;
    min-height:100vh;

    background:
        radial-gradient(
            circle at top right,
            rgba(30,75,120,.25),
            transparent 35%
        ),
        linear-gradient(
            145deg,
            var(--bg),
            var(--bg2)
        );

    color:var(--text);

    font-family:
        Tahoma,
        "Segoe UI",
        Arial,
        sans-serif;
}

button,
a{
    font-family:inherit;
}

button{
    cursor:pointer;
}


/* =========================================================
   HEADER
========================================================= */

header{
    position:sticky;
    top:0;
    z-index:1000;

    background:rgba(6,19,33,.94);

    backdrop-filter:blur(14px);

    border-bottom:1px solid var(--border);
}

.header-inner{
    max-width:1250px;

    margin:auto;

    min-height:76px;

    padding:12px 20px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:20px;
}

.brand{
    display:flex;

    align-items:center;

    gap:12px;

    color:var(--text);

    text-decoration:none;

    font-weight:bold;

    font-size:18px;
}

.brand-icon{
    width:46px;
    height:46px;

    border-radius:14px;

    display:flex;

    align-items:center;
    justify-content:center;

    background:
        linear-gradient(
            145deg,
            #123a60,
            #0b2036
        );

    border:1px solid var(--border);

    font-size:25px;
}

.home-btn{
    color:var(--gold2);

    text-decoration:none;

    padding:10px 15px;

    border:1px solid var(--border);

    border-radius:12px;

    transition:.2s;
}

.home-btn:hover{
    background:rgba(216,179,90,.1);
}


/* =========================================================
   MAIN
========================================================= */

main{
    width:min(
        1250px,
        calc(100% - 28px)
    );

    margin:28px auto 70px;
}


/* =========================================================
   PAGE TITLE
========================================================= */

.page-title{
    text-align:center;

    margin-bottom:30px;
}

.page-title .icon{
    font-size:48px;

    margin-bottom:8px;
}

.page-title h1{
    margin:0;

    color:var(--gold2);

    font-size:
        clamp(
            25px,
            4vw,
            38px
        );
}

.page-title p{
    color:var(--muted);

    margin:10px 0 0;

    font-size:15px;
}


/* =========================================================
   ALPHABET
========================================================= */

.alphabet-panel{

    background:
        linear-gradient(
            145deg,
            rgba(13,33,56,.95),
            rgba(9,26,43,.95)
        );

    border:1px solid var(--border);

    border-radius:20px;

    padding:20px;

    box-shadow:var(--shadow);

    margin-bottom:28px;
}

.alphabet-title{
    color:var(--gold2);

    font-size:16px;

    margin-bottom:14px;

    font-weight:bold;
}

.alphabet{
    display:flex;

    flex-wrap:wrap;

    gap:8px;
}

.letter-btn{

    border:1px solid var(--border);

    background:#0b1e31;

    color:#fff;

    min-width:39px;
    height:39px;

    border-radius:10px;

    font-size:17px;

    transition:.2s;
}

.letter-btn:hover,
.letter-btn.active{

    background:var(--gold);

    color:#071321;

    border-color:var(--gold);
}


/* =========================================================
   LETTER HEADER
========================================================= */

.letter-header{

    display:flex;

    align-items:center;

    justify-content:space-between;

    gap:15px;

    margin-bottom:18px;
}

.letter-name{

    color:var(--gold2);

    font-size:25px;

    font-weight:bold;
}

.entry-count{

    color:var(--muted);

    font-size:14px;
}


/* =========================================================
   ENTRIES
========================================================= */

.entries{

    display:grid;

    grid-template-columns:
        repeat(
            auto-fit,
            minmax(280px,1fr)
        );

    gap:15px;
}

.entry-card{

    position:relative;

    background:
        linear-gradient(
            145deg,
            var(--panel),
            var(--panel2)
        );

    border:1px solid
        rgba(255,255,255,.08);

    border-radius:17px;

    padding:20px;

    min-height:185px;

    cursor:pointer;

    transition:
        transform .22s ease,
        border-color .22s ease,
        box-shadow .22s ease;
}

.entry-card:hover{

    transform:translateY(-3px);

    border-color:var(--border);

    box-shadow:
        0 15px 35px
        rgba(0,0,0,.25);
}

.entry-title{

    margin:0 0 10px;

    color:#fff;

    font-size:21px;
}

.entry-category{

    display:inline-block;

    color:var(--gold2);

    font-size:12px;

    background:
        rgba(216,179,90,.08);

    border:
        1px solid
        rgba(216,179,90,.2);

    border-radius:20px;

    padding:5px 9px;

    margin-bottom:12px;
}

.entry-preview{

    color:#b8c6d3;

    font-size:14px;

    line-height:1.9;

    display:-webkit-box;

    -webkit-line-clamp:3;

    -webkit-box-orient:vertical;

    overflow:hidden;
}

.open-label{

    position:absolute;

    left:16px;
    bottom:15px;

    color:var(--gold2);

    font-size:12px;
}


/* =========================================================
   MODAL
========================================================= */

.modal{

    position:fixed;

    inset:0;

    z-index:2000;

    display:none;

    background:
        rgba(0,0,0,.76);

    backdrop-filter:blur(7px);

    padding:20px;

    overflow-y:auto;
}

.modal.show{

    display:flex;

    align-items:flex-start;

    justify-content:center;
}

.modal-box{

    width:min(
        1050px,
        100%
    );

    margin:25px auto;

    background:
        linear-gradient(
            145deg,
            #0c2137,
            #081a2c
        );

    border:1px solid var(--border);

    border-radius:24px;

    box-shadow:
        0 30px 90px
        rgba(0,0,0,.55);

    overflow:hidden;
}

.modal-header{

    padding:22px 25px;

    border-bottom:
        1px solid
        rgba(255,255,255,.08);

    display:flex;

    justify-content:space-between;

    align-items:flex-start;

    gap:15px;
}

.modal-title{

    margin:0;

    color:var(--gold2);

    font-size:30px;
}

.modal-category{

    margin-top:8px;

    color:var(--muted);

    font-size:14px;
}

.close-btn{

    width:42px;
    height:42px;

    flex-shrink:0;

    border:
        1px solid
        var(--border);

    background:#0b1c2d;

    color:#fff;

    border-radius:12px;

    font-size:23px;
}

.close-btn:hover{
    background:#182e45;
}


/* =========================================================
   STUDY
========================================================= */

.study{

    padding:28px;
}

.study-intro{

    background:
        rgba(216,179,90,.06);

    border-right:
        4px solid
        var(--gold);

    padding:18px 20px;

    border-radius:12px;

    margin-bottom:25px;
}

.study-intro strong{
    color:var(--gold2);
}

.study-section{
    margin-bottom:30px;
}

.study-section h3{

    color:var(--gold2);

    font-size:21px;

    margin:0 0 14px;

    padding-bottom:9px;

    border-bottom:
        1px solid
        rgba(216,179,90,.18);
}

.study-text{

    color:#e1e8ef;

    font-size:16px;

    line-height:2.15;

    white-space:pre-line;
}

.study-text p{
    margin:0 0 18px;
}


/* =========================================================
   REFERENCES
========================================================= */

.references{

    margin-top:35px;

    padding:22px;

    border:
        1px solid
        var(--border);

    border-radius:16px;

    background:
        rgba(5,17,29,.45);
}

.references h3{

    margin:0 0 15px;

    color:var(--gold2);
}

.reference-list{

    margin:0;

    padding-right:22px;

    color:#c9d5df;

    line-height:2;
}

.reference-list li{
    margin-bottom:5px;
}


/* =========================================================
   STATUS
========================================================= */

.status{

    text-align:center;

    padding:50px 20px;

    color:var(--muted);
}

.error{

    color:#ffb4b4;

    background:
        rgba(130,30,30,.18);

    border:
        1px solid
        rgba(255,100,100,.2);

    padding:20px;

    border-radius:15px;

    line-height:1.9;
}


/* =========================================================
   DATABASE INFORMATION
========================================================= */

.database-info{

    margin-top:20px;

    padding:12px 16px;

    border:
        1px solid
        rgba(118,214,154,.18);

    background:
        rgba(118,214,154,.04);

    border-radius:12px;

    color:#b9d8c4;

    font-size:12px;

    text-align:center;
}


/* =========================================================
   MOBILE
========================================================= */

@media(max-width:700px){

    .header-inner{

        min-height:68px;

        padding:10px 12px;
    }

    .brand{
        font-size:15px;
    }

    .brand-icon{

        width:40px;
        height:40px;

        font-size:21px;
    }

    .home-btn{

        padding:8px 10px;

        font-size:13px;
    }

    main{

        width:
            min(
                calc(100% - 18px),
                1250px
            );

        margin-top:18px;
    }

    .alphabet-panel{

        padding:15px;

        border-radius:16px;
    }

    .letter-btn{

        min-width:36px;

        height:36px;
    }

    .entries{
        grid-template-columns:1fr;
    }

    .modal{
        padding:8px;
    }

    .modal-box{

        margin:8px auto;

        border-radius:18px;
    }

    .modal-header{
        padding:17px;
    }

    .modal-title{
        font-size:23px;
    }

    .study{
        padding:18px;
    }

    .study-text{

        font-size:15px;

        line-height:2;
    }

}

</style>

</head>


<body>


<!-- =======================================================
     HEADER
======================================================= -->

<header>

    <div class="header-inner">

        <a
            href="index.html"
            class="home-btn">

            ⌂ الرئيسية

        </a>


        <a
            href="index.html"
            class="brand">

            <span class="brand-icon">
                📚
            </span>

            <span>
                موسوعة الكتاب المقدس
            </span>

        </a>

    </div>

</header>



<!-- =======================================================
     MAIN
======================================================= -->

<main>


    <section class="page-title">

        <div class="icon">
            📚
        </div>

        <h1>
            موسوعة الكتاب المقدس
        </h1>

        <p>
            دائرة المعارف الكتابية — قاعدة البيانات العربية المركزية
        </p>

    </section>



    <!-- ===================================================
         ALPHABET
    ==================================================== -->

    <section class="alphabet-panel">

        <div class="alphabet-title">

            🔎 المداخل الأبجدية

        </div>

        <div
            id="alphabet"
            class="alphabet">
        </div>

    </section>



    <!-- ===================================================
         CURRENT LETTER
    ==================================================== -->

    <section>

        <div class="letter-header">

            <div
                id="letterName"
                class="letter-name">

                حرف أ

            </div>


            <div
                id="entryCount"
                class="entry-count">

                جاري التحميل...

            </div>

        </div>


        <div
            id="entries"
            class="entries">

            <div class="status">

                جاري تحميل الموسوعة...

            </div>

        </div>


        <div
            id="databaseInfo"
            class="database-info">

            قاعدة البيانات: encyclopedia_ar.json

        </div>

    </section>


</main>



<!-- =======================================================
     STUDY MODAL
======================================================= -->

<div
    id="modal"
    class="modal">

    <div class="modal-box">


        <div class="modal-header">

            <div>

                <h2
                    id="modalTitle"
                    class="modal-title">
                </h2>

                <div
                    id="modalCategory"
                    class="modal-category">
                </div>

            </div>


            <button
                id="closeModal"
                class="close-btn"
                aria-label="إغلاق">

                ×

            </button>

        </div>


        <article
            id="studyContent"
            class="study">
        </article>


    </div>

</div>



<script>

/* =========================================================
   DATABASE CONFIGURATION
========================================================= */

const ENCYCLOPEDIA_URL =
    "encyclopedia_ar.json";


/* =========================================================
   ARABIC ALPHABET
========================================================= */

const ARABIC_LETTERS = [

    "أ",
    "ب",
    "ت",
    "ث",
    "ج",
    "ح",
    "خ",
    "د",
    "ذ",
    "ر",
    "ز",
    "س",
    "ش",
    "ص",
    "ض",
    "ط",
    "ظ",
    "ع",
    "غ",
    "ف",
    "ق",
    "ك",
    "ل",
    "م",
    "ن",
    "ه",
    "و",
    "ي"

];


/* =========================================================
   DOM
========================================================= */

const alphabetEl =
    document.getElementById("alphabet");

const entriesEl =
    document.getElementById("entries");

const letterNameEl =
    document.getElementById("letterName");

const entryCountEl =
    document.getElementById("entryCount");

const databaseInfoEl =
    document.getElementById("databaseInfo");

const modal =
    document.getElementById("modal");

const modalTitle =
    document.getElementById("modalTitle");

const modalCategory =
    document.getElementById("modalCategory");

const studyContent =
    document.getElementById("studyContent");

const closeModal =
    document.getElementById("closeModal");


/* =========================================================
   STATE
========================================================= */

let encyclopedia = [];

let currentLetter = "أ";


/* =========================================================
   NORMALIZE ARABIC
========================================================= */

function normalizeArabic(value){

    return String(value || "")

        .trim()

        .replace(
            /[ًٌٍَُِّْـ]/g,
            ""
        )

        .replace(
            /ٱ/g,
            "ا"
        )

        .replace(
            /إ/g,
            "أ"
        )

        .replace(
            /آ/g,
            "أ"
        );

}


/* =========================================================
   GET CONTENT
========================================================= */

function getEntryContent(entry){

    if(!entry){
        return "";
    }


    if(
        typeof entry.content === "string" &&
        entry.content.trim()
    ){

        return entry.content.trim();

    }


    /*
       Compatibility with older records.
    */

    if(
        typeof entry.text === "string" &&
        entry.text.trim()
    ){

        return entry.text.trim();

    }


    return "";

}


/* =========================================================
   GET ENTRY TITLE
========================================================= */

function getEntryTitle(entry){

    if(
        entry &&
        typeof entry.title === "string" &&
        entry.title.trim()
    ){

        return entry.title.trim();

    }

    return "مدخل بدون عنوان";

}


/* =========================================================
   GET ENTRY LETTER
========================================================= */

function getEntryLetter(entry){

    /*
       First priority:
       explicit letter field.
    */

    if(
        entry &&
        typeof entry.letter === "string" &&
        entry.letter.trim()
    ){

        return entry.letter.trim();

    }


    /*
       Second priority:
       derive the letter from title.
    */

    const title =
        getEntryTitle(entry);

    return title.charAt(0);

}


/* =========================================================
   VALIDATE ENTRY
========================================================= */

function isValidEntry(entry){

    if(
        !entry ||
        typeof entry !== "object"
    ){

        return false;

    }


    const title =
        getEntryTitle(entry);

    if(
        !title ||
        title === "مدخل بدون عنوان"
    ){

        return false;

    }


    return true;

}


/* =========================================================
   LOAD DATABASE
========================================================= */

async function loadEncyclopedia(){

    showLoading();

    try{

        const response =
            await fetch(
                ENCYCLOPEDIA_URL,
                {
                    cache:"no-store"
                }
            );


        if(!response.ok){

            throw new Error(
                `HTTP ${response.status} — تعذر تحميل ملف ${ENCYCLOPEDIA_URL}`
            );

        }


        const data =
            await response.json();


        /*
           THE CENTRAL DATABASE MUST HAVE:
           entries: []
        */

        if(
            !data ||
            !Array.isArray(data.entries)
        ){

            throw new Error(
                "بنية encyclopedia_ar.json غير صحيحة. يجب أن يحتوي الملف على entries كمصفوفة."
            );

        }


        /*
           Keep only valid encyclopedia records.
           No database modification occurs here.
        */

        encyclopedia =
            data.entries.filter(
                isValidEntry
            );


        if(!encyclopedia.length){

            throw new Error(
                "تم تحميل encyclopedia_ar.json ولكن entries فارغة."
            );

        }


        databaseInfoEl.textContent =
            `قاعدة البيانات: encyclopedia_ar.json — ${encyclopedia.length} مدخل محمّل`;


        buildAlphabet();


        /*
           ALWAYS restore letter A on initial load.
        */

        currentLetter = "أ";

        setActiveLetter("أ");

        renderLetter("أ");


    }catch(error){

        console.error(
            "Encyclopedia loading error:",
            error
        );


        showError(
            error.message
        );

    }

}


/* =========================================================
   SHOW LOADING
========================================================= */

function showLoading(){

    letterNameEl.textContent =
        "حرف أ";

    entryCountEl.textContent =
        "جاري التحميل...";


    entriesEl.innerHTML = `

        <div class="status">

            جاري تحميل الموسوعة...

        </div>

    `;

}


/* =========================================================
   SHOW ERROR
========================================================= */

function showError(message){

    entryCountEl.textContent =
        "تعذر التحميل";


    entriesEl.innerHTML = `

        <div class="error">

            <strong>
                حدث خطأ أثناء تحميل الموسوعة.
            </strong>

            <br><br>

            ${escapeHtml(message)}

            <br><br>

            الملف المطلوب:

            <strong>
                encyclopedia_ar.json
            </strong>

            <br><br>

            يجب أن تكون بنيته:

            <pre
                style="
                    direction:ltr;
                    text-align:left;
                    white-space:pre-wrap;
                    color:#f0d58b;
                "
            >{
  "title": "دائرة المعارف الكتابية",
  "language": "ar",
  "entries": []
}</pre>

        </div>

    `;

}


/* =========================================================
   BUILD ALPHABET
========================================================= */

function buildAlphabet(){

    alphabetEl.innerHTML = "";


    ARABIC_LETTERS.forEach(
        letter => {

            const button =
                document.createElement(
                    "button"
                );


            button.type =
                "button";


            button.className =
                "letter-btn";


            button.dataset.letter =
                letter;


            button.textContent =
                letter;


            if(
                letter === currentLetter
            ){

                button.classList.add(
                    "active"
                );

            }


            button.addEventListener(
                "click",
                () => {

                    currentLetter =
                        letter;


                    setActiveLetter(
                        letter
                    );


                    renderLetter(
                        letter
                    );

                }
            );


            alphabetEl.appendChild(
                button
            );

        }
    );

}


/* =========================================================
   SET ACTIVE LETTER
========================================================= */

function setActiveLetter(letter){

    document
        .querySelectorAll(
            ".letter-btn"
        )
        .forEach(button => {

            button.classList.toggle(
                "active",
                button.dataset.letter === letter
            );

        });

}


/* =========================================================
   GET ENTRIES FOR LETTER
========================================================= */

function getEntriesForLetter(letter){

    const normalizedLetter =
        normalizeArabic(letter);


    return encyclopedia.filter(
        entry => {

            const entryLetter =
                getEntryLetter(entry);


            return (
                normalizeArabic(
                    entryLetter
                ) === normalizedLetter
            );

        }
    );

}


/* =========================================================
   RENDER LETTER
========================================================= */

function renderLetter(letter){

    letterNameEl.textContent =
        `حرف ${letter}`;


    const entries =
        getEntriesForLetter(
            letter
        );


    entryCountEl.textContent =
        `${entries.length} مدخل`;


    entriesEl.innerHTML = "";


    if(!entries.length){

        entriesEl.innerHTML = `

            <div class="status">

                لا توجد مداخل لهذا الحرف
                في قاعدة البيانات حاليًا.

            </div>

        `;

        return;

    }


    /*
       Sort alphabetically by title.
    */

    entries.sort(
        (a,b) => {

            return normalizeArabic(
                getEntryTitle(a)
            ).localeCompare(
                normalizeArabic(
                    getEntryTitle(b)
                ),
                "ar"
            );

        }
    );


    entries.forEach(
        entry => {

            entriesEl.appendChild(
                createEntryCard(entry)
            );

        }
    );

}


/* =========================================================
   CREATE ENTRY CARD
========================================================= */

function createEntryCard(entry){

    const card =
        document.createElement(
            "article"
        );


    card.className =
        "entry-card";


    const title =
        getEntryTitle(entry);


    const category =
        entry.category ||
        "مدخل موسوعي";


    const content =
        getEntryContent(entry);


    let preview =
        content;


    if(!preview){

        preview =
            "لا يوجد محتوى لهذا المدخل.";

    }


    card.innerHTML = `

        <h2 class="entry-title">

            ${escapeHtml(title)}

        </h2>


        <div class="entry-category">

            ${escapeHtml(category)}

        </div>


        <div class="entry-preview">

            ${escapeHtml(preview)}

        </div>


        <div class="open-label">

            📖 فتح الدراسة

        </div>

    `;


    card.addEventListener(
        "click",
        () => {

            openStudy(entry);

        }
    );


    return card;

}


/* =========================================================
   OPEN STUDY
========================================================= */

function openStudy(entry){

    const title =
        getEntryTitle(entry);


    const category =
        entry.category ||
        "موسوعة الكتاب المقدس";


    const content =
        getEntryContent(entry);


    modalTitle.textContent =
        title;


    modalCategory.textContent =
        category;


    studyContent.innerHTML =
        buildDeepStudyView(
            entry,
            content
        );


    modal.classList.add(
        "show"
    );


    document.body.style.overflow =
        "hidden";

}


/* =========================================================
   DEEP STUDY VIEW
========================================================= */

function buildDeepStudyView(
    entry,
    content
){

    if(!content){

        return `

            <div class="status">

                لا يوجد محتوى لهذا المدخل
                في قاعدة البيانات.

            </div>

        `;

    }


    const paragraphs =
        splitIntoParagraphs(
            content
        );


    let html = "";


    html += `

        <div class="study-intro">

            <strong>
                الدراسة الموسوعية:
            </strong>

            ${escapeHtml(
                getEntryTitle(entry)
            )}

        </div>

    `;


    html += `

        <section class="study-section">

            <h3>
                الدراسة
            </h3>

            <div class="study-text">

    `;


    paragraphs.forEach(
        paragraph => {

            html += `

                <p>
                    ${escapeHtml(
                        paragraph
                    )}
                </p>

            `;

        }
    );


    html += `

            </div>

        </section>

    `;


    html +=
        buildReferenceSection(
            entry
        );


    return html;

}


/* =========================================================
   SPLIT CONTENT
========================================================= */

function splitIntoParagraphs(content){

    return String(content)

        .split(
            /\n\s*\n+/
        )

        .map(
            text => text.trim()
        )

        .filter(Boolean);

}


/* =========================================================
   REFERENCES
========================================================= */

function buildReferenceSection(entry){

    /*
       If the database later contains
       its own references array, use it.
    */

    if(
        entry &&
        Array.isArray(
            entry.references
        ) &&
        entry.references.length
    ){

        return `

            <section class="references">

                <h3>
                    📚 مراجع المدخل
                </h3>

                <ul class="reference-list">

                    ${
                        entry.references
                            .map(
                                reference => `
                                    <li>
                                        ${escapeHtml(
                                            reference
                                        )}
                                    </li>
                                `
                            )
                            .join("")
                    }

                </ul>

            </section>

        `;

    }


    /*
       General reference framework.
       This is interface metadata only;
       it does not fabricate encyclopedia content.
    */

    return `

        <section class="references">

            <h3>
                📚 إطار المراجع المعتمدة للدراسة
            </h3>

            <ul class="reference-list">

                <li>
                    النص الكتابي والمواضع الكتابية المرتبطة بالمدخل.
                </li>

                <li>
                    دائرة المعارف الكتابية عند توفر المادة الأصلية.
                </li>

                <li>
                    Matthew Henry.
                </li>

                <li>
                    Keil & Delitzsch.
                </li>

                <li>
                    Pulpit Commentary.
                </li>

                <li>
                    Ellicott's Commentary.
                </li>

                <li>
                    Benson Commentary.
                </li>

                <li>
                    Jamieson-Fausset-Brown.
                </li>

                <li>
                    Jewish Encyclopedia عند الحاجة.
                </li>

                <li>
                    Jewish Virtual Library عند الحاجة.
                </li>

            </ul>

        </section>

    `;

}


/* =========================================================
   ESCAPE HTML
========================================================= */

function escapeHtml(value){

    return String(
        value ?? ""
    )

    .replace(
        /&/g,
        "&amp;"
    )

    .replace(
        /</g,
        "&lt;"
    )

    .replace(
        />/g,
        "&gt;"
    )

    .replace(
        /"/g,
        "&quot;"
    )

    .replace(
        /'/g,
        "&#039;"
    );

}


/* =========================================================
   CLOSE MODAL
========================================================= */

function closeStudy(){

    modal.classList.remove(
        "show"
    );

    document.body.style.overflow =
        "";

}


closeModal.addEventListener(
    "click",
    closeStudy
);


/* =========================================================
   CLOSE OUTSIDE
========================================================= */

modal.addEventListener(
    "click",
    event => {

        if(
            event.target === modal
        ){

            closeStudy();

        }

    }
);


/* =========================================================
   CLOSE ESC
========================================================= */

document.addEventListener(
    "keydown",
    event => {

        if(
            event.key === "Escape"
        ){

            closeStudy();

        }

    }
);


/* =========================================================
   START
========================================================= */

loadEncyclopedia();

</script>

</body>

</html>
