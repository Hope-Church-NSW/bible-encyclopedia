  "matthew_end_structure": [
    {
      "chapter": 26,
      "verse_count": 75,
      "first_verse": "وَلَمَّا أَكْمَلَ يَسُوعُ هذِهِ الأَقْوَالَ كُلَّهَا قَالَ لِتَلاَمِيذِهِ:",
      "last_verse": "فَتَذَكَّرَ بُطْرُسُ كَلاَمَ يَسُوعَ الَّذِي قَالَ لَهُ:«إِنَّكَ قَبْلَ أَنْ يَصِيحَ الدِّيكُ تُنْكِرُني ثَلاَثَ مَرَّاتٍ». فَخَرَجَ إِلَى خَارِجٍ وَبَكَى بُكَاءً مُرًّا."
    },
    {
      "chapter": 27,
      "verse_count": 66,
      "first_verse": "وَلَمَّا كَانَ الصَّبَاحُ تَشَاوَرَ جَمِيعُ رُؤَسَاءِ الْكَهَنَةِ وَشُيُوخُ الشَّعْب عَلَى يَسُوعَ حَتَّى يَقْتُلُوهُ،",
      "last_verse": "فَمَضَوْا وَضَبَطُوا الْقَبْرَ بِالْحُرَّاسِ وَخَتَمُوا الْحَجَرَ."
    },
    {
      "chapter": 28,
      "verse_count": 20,
      "first_verse": "وَبَعْدَ السَّبْتِ، عِنْدَ فَجْرِ أَوَّلِ الأُسْبُوعِ، جَاءَتْ مَرْيَمُ الْمَجْدَلِيَّةُ وَمَرْيَمُ الأُخْرَى لِتَنْظُرَا الْقَبْرَ.",
      "last_verse": "وَعَلِّمُوهُمْ أَنْ يَحْفَظُوا جَمِيعَ مَا أَوْصَيْتُكُمْ بِهِ. وَهَا أَنَا مَعَكُمْ كُلَّ الأَيَّامِ إِلَى انْقِضَاءِ الدَّهْرِ». آمِينَ."
    },
