  "methodology": {
    "description": "منظومة تفسيرية أكاديمية ولاهوتية مستقلة لكل آية، تجمع بين الدراسة النصية والسياق الأدبي والتاريخي والخلفية اليهودية والكلمات الأصلية وأقوال المفسرين والمقارنة اللاهوتية والربط الكتابي والتطبيقات، مع توثيق المصادر في نهاية كل دراسة.",
    "principles": [
      "التمييز بين ما يقوله النص صراحة وما يستنتجه المفسر.",
      "التمييز بين الخلفية التاريخية والمصادر اليهودية اللاحقة.",
      "عدم اعتبار المصادر التلمودية مصدرًا مسيحيًا للعقيدة.",
      "عرض الاختلافات بين المفسرين دون إخفائها.",
      "تمييز المعنى اللغوي الأصلي عن التطبيق اللاهوتي.",
      "ربط الآية بسياق السفر والكتاب المقدس ككل.",
      "توثيق المصادر المستخدمة في نهاية كل تفسير."
    ]
  },

